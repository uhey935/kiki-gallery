---
import {
  localeFromPathname,
  parsePublicRouteIdentity,
  projectLocaleRoute,
} from "../content-boundaries/locale-routes";

const currentPath = Astro.url.pathname;
const currentLocale = localeFromPathname(currentPath);
const targetLocale = currentLocale === "ja" ? "en" : "ja";
const currentIdentity = parsePublicRouteIdentity(currentPath);
const isHome = currentIdentity?.surface === "home";
const localeCounterpart = await projectLocaleRoute({
  pathname: currentPath,
  targetLocale,
});

const [
  homeRoute,
  artistsRoute,
  exhibitionsRoute,
  journalRoute,
  newsRoute,
  aboutRoute,
] = await Promise.all(
  ["/", "/artists/", "/exhibitions/", "/journal/", "/news/", "/about/"].map(
    (pathname) => projectLocaleRoute({ pathname, targetLocale: currentLocale }),
  ),
);

const href = (decision: typeof homeRoute) =>
  decision.kind === "available" ? decision.href : undefined;
const samePath = (candidate: string | undefined) =>
  candidate?.replace(/\/$/, "") === currentPath.replace(/\/$/, "");
const logoHref = href(homeRoute) ?? "/";
---

<header class:list={["site-header", isHome && "site-header--home"]}>
  <a
    href={logoHref}
    class="site-header__logo"
    aria-label="KiKi Gallery home"
    data-menu-link
  >
    KiKi
  </a>

  <div class="site-header__controls">
    <div class="site-header__language" aria-label="Language">
      {
        currentLocale === "en" ? (
          <>
            <span class="site-header__language-link" aria-current="true">
              EN
            </span>
            {localeCounterpart.kind === "available" && (
              <>
                <span class="site-header__language-separator">/</span>
                <a
                  href={localeCounterpart.href}
                  class="site-header__language-link"
                >
                  JA
                </a>
              </>
            )}
          </>
        ) : (
          <>
            {localeCounterpart.kind === "available" && (
              <>
                <a
                  href={localeCounterpart.href}
                  class="site-header__language-link"
                >
                  EN
                </a>
                <span class="site-header__language-separator">/</span>
              </>
            )}
            <span class="site-header__language-link" aria-current="true">
              JA
            </span>
          </>
        )
      }
    </div>

    <button
      class="site-header__menu-button"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-open
    >
      <span class="site-header__menu-icon">
        <span class="site-header__menu-line site-header__menu-line--top"></span>
        <span class="site-header__menu-line site-header__menu-line--bottom"
        ></span>
      </span>
    </button>
  </div>

  <div
    class="site-header__overlay"
    id="site-menu"
    aria-hidden="true"
    data-overlay
  >
    <div class="site-header__overlay-inner">
      <div class="site-header__overlay-layout">
        <div class="site-header__overlay-primary">
          <div class="site-header__primary-navigation">
            <p class="site-header__navigation-label">Menu</p>

            <nav class="site-header__nav" aria-label="Global navigation">
              <ul class="site-header__nav-list">
                {
                  href(artistsRoute) && (
                    <li class="site-header__nav-item">
                      <a
                        href={href(artistsRoute)}
                        class="site-header__nav-link"
                        data-menu-link
                        aria-current={
                          samePath(href(artistsRoute)) ? "page" : undefined
                        }
                      >
                        Artists
                      </a>
                    </li>
                  )
                }

                {
                  href(exhibitionsRoute) && (
                    <li class="site-header__nav-item">
                      <a
                        href={href(exhibitionsRoute)}
                        class="site-header__nav-link"
                        data-menu-link
                        aria-current={
                          samePath(href(exhibitionsRoute)) ? "page" : undefined
                        }
                      >
                        Exhibitions
                      </a>
                    </li>
                  )
                }

                {
                  href(journalRoute) && (
                    <li class="site-header__nav-item">
                      <a
                        href={href(journalRoute)}
                        class="site-header__nav-link"
                        data-menu-link
                        aria-current={
                          samePath(href(journalRoute)) ? "page" : undefined
                        }
                      >
                        Journal
                      </a>
                    </li>
                  )
                }

                {
                  href(newsRoute) && (
                    <li class="site-header__nav-item">
                      <a
                        href={href(newsRoute)}
                        class="site-header__nav-link"
                        data-menu-link
                        aria-current={
                          samePath(href(newsRoute)) ? "page" : undefined
                        }
                      >
                        News
                      </a>
                    </li>
                  )
                }

                {
                  href(aboutRoute) && (
                    <li class="site-header__nav-item">
                      <a
                        href={href(aboutRoute)}
                        class="site-header__nav-link"
                        data-menu-link
                        aria-current={
                          samePath(href(aboutRoute)) ? "page" : undefined
                        }
                      >
                        About
                      </a>
                    </li>
                  )
                }

                <li class="site-header__nav-item">
                  <a
                    href="https://www.kiki-shop.jp/"
                    class="site-header__nav-link"
                    data-menu-link
                    aria-current={currentPath === "/shop" ? "page" : undefined}
                  >
                    Shop
                  </a>
                </li>
              </ul>
            </nav>
          </div>
        </div>

        <div class="site-header__overlay-secondary">
          <div class="site-header__info">
            <ul class="site-header__info-list">
              <li class="site-header__info-item">
                <a
                  href="#"
                  id="email-link"
                  class="site-header__info-link"
                  data-u="aW5mbw=="
                  data-d="a2lraS1nYWxsZXJ5LmNvbQ=="
                >
                </a>
              </li>

              <li class="site-header__info-item">
                <address class="site-header__info-address">
                  Kanagawa, Japan
                </address>
              </li>

              <li class="site-header__info-item">
                <p class="site-header__info-text">Hours</p>
              </li>

              <li class="site-header__info-item">
                <a
                  href="https://instagram.com/xxxxx"
                  class="site-header__info-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Instagram"
                >
                  <svg
                    class="site-header__social-icon"
                    viewBox="0 0 19 19"
                    aria-hidden="true"
                  >
                    <path
                      d="M13.76-.007H5.24A5.258 5.258 0 0 0-.01 5.24v8.52a5.258 5.258 0 0 0 5.25 5.247h8.52a5.258 5.258 0 0 0 5.25-5.247V5.24a5.258 5.258 0 0 0-5.25-5.247zM17 14a2.683 2.683 0 0 1-3 3H5a2.683 2.683 0 0 1-3-3V5a2.683 2.683 0 0 1 3-3h9a2.683 2.683 0 0 1 3 3v9zM9.5 4.6a4.9 4.9 0 1 0 4.9 4.9 4.906 4.906 0 0 0-4.9-4.9zm0 8.111a3.212 3.212 0 1 1 3.21-3.212 3.215 3.215 0 0 1-3.21 3.213zm5.1-9.542a1.233 1.233 0 1 0 .88.362 1.245 1.245 0 0 0-.88-.361z"
                      fill="currentColor"></path>
                  </svg>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header")!;
  const menuButton = document.querySelector<HTMLButtonElement>(
    ".site-header__menu-button",
  )!;
  const overlay = document.querySelector<HTMLElement>(".site-header__overlay")!;

  const menuLinks =
    document.querySelectorAll<HTMLAnchorElement>("[data-menu-link]");
  const emailLink = document.getElementById("email-link");

  if (emailLink) {
    const user = atob(emailLink.dataset.u || "");
    const domain = atob(emailLink.dataset.d || "");
    const email = `${user}@${domain}`;

    emailLink.textContent = email;

    emailLink.addEventListener("click", (event) => {
      event.preventDefault();
      window.location.href = `mailto:${email}`;
    });
  }

  let scrollPosition = 0;
  let isAnimating = false;
  let pendingNavigation = false;

  let lastScrollY = window.scrollY;
  const scrollThreshold = 8;
  const topThreshold = 72;
  const homeThreshold = window.innerHeight * 0.12;

  function updateHomeHeaderState() {
    if (!header.classList.contains("site-header--home")) return;

    if (window.scrollY > homeThreshold) {
      header.classList.add("is-scrolled");
    } else {
      header.classList.remove("is-scrolled");
    }
  }

  function openMenu() {
    if (isAnimating || header.classList.contains("is-open")) return;

    isAnimating = true;
    scrollPosition = window.scrollY;

    overlay.style.display = "block";

    header.classList.remove("is-closing", "is-hidden");
    header.classList.add("is-opening");

    document.body.style.overflow = "hidden";

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        header.classList.add("is-open");

        setTimeout(() => {
          header.classList.remove("is-opening");
          menuButton.setAttribute("aria-expanded", "true");
          overlay.setAttribute("aria-hidden", "false");
          isAnimating = false;
        }, 500);
      });
    });
  }

  function transitionTimeInMilliseconds(value: string) {
    const time = Number.parseFloat(value);
    return value.trim().endsWith("ms") ? time : time * 1000;
  }

  function overlayTransformTransitionTime() {
    const style = window.getComputedStyle(overlay);
    const properties = style.transitionProperty.split(",");
    const durations = style.transitionDuration.split(",");
    const delays = style.transitionDelay.split(",");
    let longest = 0;

    properties.forEach((property, index) => {
      if (property.trim() !== "transform" && property.trim() !== "all") return;

      const duration = durations[index % durations.length] ?? "0s";
      const delay = delays[index % delays.length] ?? "0s";
      longest = Math.max(
        longest,
        transitionTimeInMilliseconds(duration) +
          transitionTimeInMilliseconds(delay),
      );
    });

    return longest;
  }

  function closeMenu(onClosed?: () => void) {
    if (isAnimating || !header.classList.contains("is-open")) return false;

    isAnimating = true;

    let closeFinished = false;
    let fallbackTimer: number | undefined;

    const finishClose = () => {
      if (closeFinished) return;
      closeFinished = true;

      if (fallbackTimer !== undefined) window.clearTimeout(fallbackTimer);
      overlay.removeEventListener("transitionend", handleTransitionEnd);

      overlay.style.display = "none";
      header.classList.remove("is-closing");

      document.body.style.overflow = "";
      window.scrollTo(0, scrollPosition);

      updateHomeHeaderState();

      isAnimating = false;
      onClosed?.();
    };

    const handleTransitionEnd = (event: TransitionEvent) => {
      if (event.target === overlay && event.propertyName === "transform") {
        finishClose();
      }
    };

    overlay.addEventListener("transitionend", handleTransitionEnd);

    header.classList.remove("is-opening");
    header.classList.add("is-closing");
    header.classList.remove("is-open");

    menuButton.setAttribute("aria-expanded", "false");
    overlay.setAttribute("aria-hidden", "true");

    const transitionTime = overlayTransformTransitionTime();
    fallbackTimer = window.setTimeout(finishClose, transitionTime + 100);
    return true;
  }

  menuButton.addEventListener("click", () => {
    if (header.classList.contains("is-open")) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  overlay.addEventListener("click", () => {
    closeMenu();
  });

  menuLinks.forEach((link) => {
    link.addEventListener("click", (event) => {
      if (
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        link.target.toLowerCase() === "_blank" ||
        link.hasAttribute("download")
      ) {
        return;
      }

      const destination = new URL(link.href, window.location.href);
      const isInternalHttpLink =
        destination.origin === window.location.origin &&
        (destination.protocol === "http:" || destination.protocol === "https:");
      const isSameDocument =
        destination.pathname === window.location.pathname &&
        destination.search === window.location.search;

      if (!isInternalHttpLink || isSameDocument) return;

      if (pendingNavigation) {
        event.preventDefault();
        return;
      }

      const closingStarted = closeMenu(() => {
        window.location.assign(destination.href);
      });

      if (!closingStarted) return;

      event.preventDefault();
      pendingNavigation = true;
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && header.classList.contains("is-open")) {
      closeMenu();
    }
  });

  window.addEventListener("scroll", () => {
    if (header.classList.contains("is-open")) return;

    const currentScrollY = window.scrollY;

    if (currentScrollY <= topThreshold) {
      header.classList.remove("is-hidden");
      updateHomeHeaderState();
      lastScrollY = currentScrollY;
      return;
    }

    if (currentScrollY > lastScrollY + scrollThreshold) {
      header.classList.add("is-hidden");
    } else if (currentScrollY < lastScrollY - scrollThreshold) {
      header.classList.remove("is-hidden");
    }

    updateHomeHeaderState();

    lastScrollY = currentScrollY;
  });

  updateHomeHeaderState();
</script>
