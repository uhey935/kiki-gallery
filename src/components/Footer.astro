---
import { localeFromPathname } from "../content-boundaries/locale-routes.ts";

const year = new Date().getFullYear();
const privacyHref =
  localeFromPathname(Astro.url.pathname) === "en"
    ? "/en/privacy/"
    : "/privacy/";
---

<footer class="footer">
  <p>© {year} KiKi</p>

  <nav aria-label="Footer navigation" class="footer-nav">
    <ul>
      <li><a href={privacyHref}>Privacy Policy</a></li>
      <li>
        <a href="https://instagram.com" target="_blank" rel="noopener"
          >Instagram</a
        >
      </li>
    </ul>
  </nav>
</footer>
