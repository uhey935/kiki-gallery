---
const { items = [] } = Astro.props as {
  items: { label: string; href: string }[];
};
---

<nav class="breadcrumb" aria-label="breadcrumb">
  <div class="wrapper">
    <ol>
      {items.map((item, index) => (
        <li>
          {index < items.length - 1 ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            <span>{item.label}</span>
          )}
        </li>
      ))}
    </ol>
  </div>
</nav>