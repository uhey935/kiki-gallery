---
import type { WorksEditorDraftState } from "../../editor/works-draft-state";

interface Props {
  draft: WorksEditorDraftState;
  create?: boolean;
}
const { draft, create = false } = Astro.props;
const { data } = draft;
---

<form class="editor-draft-form" aria-label="Works draft" data-works-draft-form>
  <div class="editor-field-meaning" aria-label="Field requirement legend">
    <span><b>Required</b> needed for a valid draft</span>
    <span><b>Optional</b> may be left blank</span>
  </div>
  <section class="editor-entry-section">
    <header>
      <div>
        <p class="editor-eyebrow">Shared</p><h2>Identity & presentation</h2>
      </div>
    </header>
    <div class="editor-entry-section__content editor-field-grid">
      <label data-editor-field="artist">
        <span>Artist <small class="editor-field-badge">Required</small></span>
        <input name="artist" value={data.artist.id} />
      </label>
      <label data-editor-field="year">
        <span
          >Year <small class="editor-field-badge editor-field-badge--optional"
            >Optional</small
          ></span
        >
        <input name="year" type="number" value={data.year ?? ""} />
      </label>
      <label data-editor-field="size">
        <span
          >Size <small class="editor-field-badge editor-field-badge--optional"
            >Optional</small
          ></span
        >
        <input name="size" value={data.size ?? ""} />
      </label>
      <label data-editor-field="orientation">
        <span
          >Orientation <small
            class="editor-field-badge editor-field-badge--optional"
            >Optional</small
          ></span
        >
        <input name="orientation" value={data.orientation ?? ""} />
      </label>
    </div>
  </section>
  <section class="editor-entry-section">
    <header>
      <div>
        <p class="editor-eyebrow">Shared / Localized</p>
        <h2>Images <small class="editor-field-badge">Required</small></h2>
      </div>
    </header>
    <p>
      {
        create
          ? "Create references an existing canonical image path. Asset creation and upload remain outside first Save."
          : "Upload JPEG, PNG, WebP, or AVIF files using canonical lowercase names. New files remain temporary until Save. Preview can show temporary files, but Publish always requires a successful Save first."
      }
    </p>
    <div class="editor-asset-upload" hidden={create}>
      <input
        data-works-asset-file
        type="file"
        accept="image/avif,image/jpeg,image/png,image/webp"
        multiple
      />
      <button
        class="editor-button editor-button--secondary"
        type="button"
        data-upload-works-assets>Upload selected</button
      >
    </div>
    <p data-works-asset-status role="status" aria-live="polite"></p>
    <div class="editor-entry-section__content" data-works-asset-list>
      {
        data.images.map((image, index) => (
          <fieldset class="editor-readonly-group" data-asset-index={index}>
            <legend>Image {index + 1}</legend>
            <label>
              Shared · src
              <input
                name={create ? `images.${index}.src` : undefined}
                value={image.src}
                readonly={!create}
              />
            </label>
            <label>
              Localized · alt
              <textarea
                name={create ? `images.${index}.alt` : undefined}
                data-asset-alt={!create ? "" : undefined}
              >
                {image.alt}
              </textarea>
            </label>
            <div class="editor-asset-actions" hidden={create}>
              <button type="button" data-asset-move="up" disabled={index === 0}>
                Move up
              </button>
              <button
                type="button"
                data-asset-move="down"
                disabled={index === data.images.length - 1}
              >
                Move down
              </button>
            </div>
          </fieldset>
        ))
      }
    </div>
  </section>
  <section class="editor-entry-section">
    <header>
      <div><p class="editor-eyebrow">Shared</p><h2>Inquiry</h2></div>
    </header>
    <div class="editor-entry-section__content editor-field-grid">
      <label data-editor-field="inquiry.type">
        <span
          >Type <small class="editor-field-badge editor-field-badge--optional"
            >Optional</small
          ></span
        >
        <input name="inquiry.type" value={data.inquiry.type} />
      </label>
      <label data-editor-field="inquiry.url">
        <span
          >URL <small class="editor-field-badge editor-field-badge--optional"
            >Optional</small
          ></span
        >
        <input
          name="inquiry.url"
          value={"url" in data.inquiry ? (data.inquiry.url ?? "") : ""}
        />
      </label>
    </div>
  </section>
  <section class="editor-entry-section">
    <header>
      <div><p class="editor-eyebrow">Localized</p><h2>Content</h2></div>
    </header>
    <p>
      These fields create the JA locale. EN starts with explicit placeholders;
      JA content is never copied as an English translation.
    </p>
    <div class="editor-entry-section__content editor-field-grid">
      <label class="editor-field-wide" data-editor-field="title">
        <span>Title <small class="editor-field-badge">Required</small></span>
        <input name="title" value={data.title} />
      </label>
      <label data-editor-field="material">
        <span
          >Material <small
            class="editor-field-badge editor-field-badge--optional"
            >Optional</small
          ></span
        >
        <input name="material" value={data.material ?? ""} />
      </label>
      <label data-editor-field="seo_title">
        <span
          >SEO title <small
            class="editor-field-badge editor-field-badge--optional"
            >Optional</small
          ></span
        >
        <input name="seo_title" value={data.seo_title ?? ""} />
      </label>
      <label class="editor-field-wide" data-editor-field="description">
        <span
          >Description <small
            class="editor-field-badge editor-field-badge--optional"
            >Optional</small
          ></span
        >
        <textarea name="description">{data.description ?? ""}</textarea>
      </label>
      <label class="editor-field-wide" data-editor-field="body">
        <span
          >Body <small class="editor-field-badge editor-field-badge--optional"
            >Optional</small
          ></span
        >
        <textarea name="body">{draft.body}</textarea>
      </label>
    </div>
  </section>
</form>
