---
import type { WorksEditorDraftState } from "../../editor/works-draft-state";

interface Props {
  draft: WorksEditorDraftState;
}
const { draft } = Astro.props;
const { data } = draft;
---

<form class="editor-draft-form" aria-label="Works draft" data-works-draft-form>
  <section class="editor-entry-section">
    <header>
      <div>
        <p class="editor-eyebrow">Shared</p><h2>Identity & presentation</h2>
      </div>
    </header>
    <div class="editor-entry-section__content editor-detail-list">
      <label>Artist<input name="artist" value={data.artist.id} /></label>
      <label
        >Year<input name="year" type="number" value={data.year ?? ""} /></label
      >
      <label>Size<input name="size" value={data.size ?? ""} /></label>
      <label
        >Orientation<input
          name="orientation"
          value={data.orientation ?? ""}
        /></label
      >
    </div>
  </section>
  <section class="editor-entry-section">
    <header>
      <div><p class="editor-eyebrow">Shared / Localized</p><h2>Images</h2></div>
    </header>
    <p>
      Upload JPEG, PNG, WebP, or AVIF files using canonical lowercase names. New
      files remain temporary until Save.
    </p>
    <div class="editor-asset-upload">
      <input
        data-works-asset-file
        type="file"
        accept="image/avif,image/jpeg,image/png,image/webp"
        multiple
      />
      <button
        class="editor-button editor-button--secondary"
        type="button"
        data-upload-works-assets>Upload selected</button
      >
    </div>
    <p data-works-asset-status role="status" aria-live="polite"></p>
    <div class="editor-entry-section__content" data-works-asset-list>
      {
        data.images.map((image, index) => (
          <fieldset class="editor-readonly-group" data-asset-index={index}>
            <legend>Image {index + 1}</legend>
            <label>
              Shared · src
              <input value={image.src} readonly />
            </label>
            <label>
              Localized · alt
              <textarea data-asset-alt>{image.alt}</textarea>
            </label>
            <div class="editor-asset-actions">
              <button type="button" data-asset-move="up" disabled={index === 0}>
                Move up
              </button>
              <button
                type="button"
                data-asset-move="down"
                disabled={index === data.images.length - 1}
              >
                Move down
              </button>
            </div>
          </fieldset>
        ))
      }
    </div>
  </section>
  <section class="editor-entry-section">
    <header>
      <div><p class="editor-eyebrow">Shared</p><h2>Inquiry</h2></div>
    </header>
    <div class="editor-entry-section__content editor-detail-list">
      <label>Type<input name="inquiry.type" value={data.inquiry.type} /></label>
      <label
        >URL<input
          name="inquiry.url"
          value={"url" in data.inquiry ? (data.inquiry.url ?? "") : ""}
        /></label
      >
    </div>
  </section>
  <section class="editor-entry-section">
    <header>
      <div><p class="editor-eyebrow">Localized</p><h2>Content</h2></div>
    </header>
    <p>
      Current flat storage has one localized source; no JA/EN parity is implied.
    </p>
    <div class="editor-entry-section__content editor-readonly-fields">
      <label>Title<input name="title" value={data.title} /></label>
      <label
        >Material<input name="material" value={data.material ?? ""} /></label
      >
      <label
        >SEO title<input name="seo_title" value={data.seo_title ?? ""} /></label
      >
      <label
        >Description<textarea name="description"
          >{data.description ?? ""}</textarea
        ></label
      >
      <label>Body<textarea name="body">{draft.body}</textarea></label>
    </div>
  </section>
</form>
