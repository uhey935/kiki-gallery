---
import type { JournalEditorDraftState } from "../../editor/journal-draft-state";
import LocaleDraftSection from "./LocaleDraftSection.astro";

interface Props {
  draft: JournalEditorDraftState;
  create?: boolean;
}
const { draft, create = false } = Astro.props;
---

<form class="editor-draft-form" data-editor-draft-form>
  <div class="editor-field-meaning" aria-label="Field requirement legend">
    <span><b>Required</b> needed for a valid draft</span>
    <span><b>Optional</b> may be left blank</span>
    <span><b>Publish checked</b> placeholders block preview and publish</span>
  </div>
  <section class="editor-entry-section" data-editor-section="shared">
    <header>
      <div><p class="editor-eyebrow">Shared metadata</p><h2>Shared</h2></div>
      <div class="editor-section-status">
        <span data-section-dirty hidden>Modified</span><span
          class="editor-status">{draft.shared.state}</span
        >
      </div>
    </header>
    <div class="editor-entry-section__content">
      {
        draft.shared.state === "editable" ? (
          <div class="editor-field-grid">
            <label data-editor-field="shared.date">
              <span>
                Date <small class="editor-field-badge">Required</small>
              </span>
              <input name="shared.date" value={draft.shared.value.date} />
            </label>
            <label data-editor-field="shared.category">
              <span>
                Category <small class="editor-field-badge">Required</small>
              </span>
              <select name="shared.category">
                <option value="" selected={draft.shared.value.category === ""}>
                  Select a category
                </option>
                {(["interview", "essay", "report"] as const).map((category) => (
                  <option
                    value={category}
                    selected={
                      draft.shared.state === "editable" &&
                      draft.shared.value.category === category
                    }
                  >
                    {category[0].toUpperCase() + category.slice(1)}
                  </option>
                ))}
              </select>
            </label>
            <label data-editor-field="shared.visibility">
              <span>
                Site visibility{" "}
                <small class="editor-field-badge">Required</small>
              </span>
              <select name="shared.visibility">
                <option
                  value="draft"
                  selected={draft.shared.value.visibility === "draft"}
                >
                  Draft
                </option>
                <option
                  value="public"
                  selected={draft.shared.value.visibility === "public"}
                >
                  Public
                </option>
              </select>
              <small>
                Draft: not available on public Journal routes or listing
                surfaces. Public: listed and publicly reachable. Site visibility
                controls site availability; Publish sends saved changes to the
                repository and remote.
              </small>
            </label>
            <section
              class="editor-field-wide editor-hero-asset"
              data-editor-field="shared.hero.image"
              data-journal-hero
            >
              <span>
                Hero image <small class="editor-field-badge">Required</small>
              </span>
              <input
                type="hidden"
                name="shared.hero.image"
                value={draft.shared.value.hero.image}
                data-journal-hero-path
              />
              <div data-journal-hero-current hidden={create}>
                <div class="editor-hero-asset__preview">
                  <img
                    src={draft.shared.value.hero.image || undefined}
                    alt=""
                    data-journal-hero-thumbnail
                  />
                </div>
                <div class="editor-hero-asset__details">
                  <p><strong data-journal-hero-state>Canonical · saved</strong></p>
                  <code data-journal-hero-canonical-path>
                    {draft.shared.value.hero.image}
                  </code>
                </div>
                <div class="editor-asset-actions">
                  <button type="button" data-journal-hero-replace>
                    Replace
                  </button>
                  <button type="button" data-journal-hero-remove>
                    Remove
                  </button>
                </div>
              </div>
              <div
                class="editor-hero-drop"
                data-journal-hero-drop
                hidden={!create}
              >
                <p>Drag & drop a JPEG, PNG, WebP, or AVIF image here</p>
                <button type="button" data-journal-hero-select>
                  Select from desktop
                </button>
              </div>
              <input
                type="file"
                accept="image/avif,image/jpeg,image/png,image/webp"
                data-journal-hero-file
                hidden
              />
              <section data-journal-hero-confirm hidden>
                <h3>Replace existing image?</h3>
                <p>
                  The canonical filename already exists with different bytes.
                  It will remain unchanged until Save.
                </p>
                <div class="editor-hero-compare">
                  <figure>
                    <img src={draft.shared.value.hero.image} alt="" />
                    <figcaption>Existing</figcaption>
                  </figure>
                  <figure>
                    <img alt="" data-journal-hero-new />
                    <figcaption>New · temporary</figcaption>
                  </figure>
                </div>
                <button type="button" data-journal-hero-reject>Cancel</button>
                <button type="button" data-journal-hero-accept>Replace</button>
              </section>
              <p data-journal-hero-status role="status" aria-live="polite"></p>
            </section>
            <label
              class="editor-field-wide"
              data-editor-field="shared.hero.hero_caption"
            >
              <span>
                Hero caption{" "}
                <small class="editor-field-badge editor-field-badge--optional">
                  Optional
                </small>
              </span>
              <input
                name="shared.hero.hero_caption"
                value={draft.shared.value.hero.hero_caption ?? ""}
              />
            </label>
          </div>
        ) : (
          <p>
            Shared source is {draft.shared.sourceState}; structured editing is
            unavailable.
          </p>
        )
      }
    </div>
  </section>
  <LocaleDraftSection locale="ja" source={draft.locales.ja} />
  <LocaleDraftSection locale="en" source={draft.locales.en} />
  <section class="editor-entry-section" data-editor-section="metadata">
    <header>
      <div>
        <p class="editor-eyebrow">Localized metadata</p><h2>Metadata</h2>
      </div>
    </header>
    <div class="editor-entry-section__content">
      <p class="editor-field-help">
        Leave SEO title blank to use the Journal Title. Leave SEO description
        blank to use the Journal excerpt.
      </p>
      <div class="editor-field-grid">
        {
          (["ja", "en"] as const).map((locale) => {
            const source = draft.locales[locale];
            return source.state === "editable" ? (
              <>
                <label data-editor-field={`${locale}.seo_title`}>
                  <span>
                    {locale.toUpperCase()} SEO title{" "}
                    <small class="editor-field-badge editor-field-badge--optional">
                      Optional
                    </small>
                  </span>
                  <input
                    name={`${locale}.seo_title`}
                    value={source.value.seo_title ?? ""}
                  />
                </label>
                <label
                  class="editor-field-wide"
                  data-editor-field={`${locale}.description`}
                >
                  <span>
                    {locale.toUpperCase()} SEO description{" "}
                    <small class="editor-field-badge editor-field-badge--optional">
                      Optional
                    </small>
                  </span>
                  <textarea
                    name={`${locale}.description`}
                    rows="3"
                    set:text={source.value.description ?? ""}
                  />
                </label>
              </>
            ) : (
              <p>{locale.toUpperCase()} source unavailable.</p>
            );
          })
        }
      </div>
    </div>
  </section>
</form>

<style>
  .editor-hero-asset {
    display: grid;
    gap: 16px;
    min-width: 0;
  }
  [data-journal-hero-current] {
    display: grid;
    gap: 16px;
    min-width: 0;
  }
  .editor-hero-asset__details {
    display: grid;
    gap: 7px;
    min-width: 0;
  }
  .editor-hero-asset__details p {
    margin: 0;
  }
  .editor-hero-asset__preview {
    display: grid;
    justify-items: center;
    min-width: 0;
    padding-block: 20px;
    background: #f1f3ef;
  }
  [data-journal-hero-thumbnail] {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: 360px;
    object-fit: contain;
    background: #f1f3ef;
  }
  [data-journal-hero-canonical-path] {
    overflow-wrap: anywhere;
  }
</style>
