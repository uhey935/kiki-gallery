---
import type { JournalEditorDraftState } from "../../editor/journal-draft-state";
import LocaleDraftSection from "./LocaleDraftSection.astro";

interface Props {
  draft: JournalEditorDraftState;
}
const { draft } = Astro.props;
---

<form class="editor-draft-form" data-editor-draft-form>
  <div class="editor-field-meaning" aria-label="Field requirement legend">
    <span><b>Required</b> needed for a valid draft</span>
    <span><b>Optional</b> may be left blank</span>
    <span><b>Publish checked</b> placeholders block preview and publish</span>
  </div>
  <section class="editor-entry-section" data-editor-section="shared">
    <header>
      <div><p class="editor-eyebrow">Shared metadata</p><h2>Shared</h2></div>
      <div class="editor-section-status">
        <span data-section-dirty hidden>Modified</span><span
          class="editor-status">{draft.shared.state}</span
        >
      </div>
    </header>
    <div class="editor-entry-section__content">
      {
        draft.shared.state === "editable" ? (
          <div class="editor-field-grid">
            <label data-editor-field="shared.date">
              <span>
                Date <small class="editor-field-badge">Required</small>
              </span>
              <input name="shared.date" value={draft.shared.value.date} />
            </label>
            <label data-editor-field="shared.category">
              <span>
                Category <small class="editor-field-badge">Required</small>
              </span>
              <select name="shared.category">
                <option value="" selected={draft.shared.value.category === ""}>
                  Select a category
                </option>
                {(["interview", "essay", "report"] as const).map((category) => (
                  <option
                    value={category}
                    selected={
                      draft.shared.state === "editable" &&
                      draft.shared.value.category === category
                    }
                  >
                    {category[0].toUpperCase() + category.slice(1)}
                  </option>
                ))}
              </select>
            </label>
            <label data-editor-field="shared.visibility">
              <span>
                Site visibility{" "}
                <small class="editor-field-badge">Required</small>
              </span>
              <select name="shared.visibility">
                <option
                  value="hidden"
                  selected={draft.shared.value.visibility === "hidden"}
                >
                  Hidden
                </option>
                <option
                  value="public"
                  selected={draft.shared.value.visibility === "public"}
                >
                  Public
                </option>
              </select>
              <small>
                Hidden: not available on public Journal routes or listing
                surfaces. Public: listed and publicly reachable. Site visibility
                controls site availability; Publish sends saved changes to the
                repository and remote.
              </small>
            </label>
            <label data-editor-field="shared.hero.image">
              <span>
                Hero image <small class="editor-field-badge">Required</small>
              </span>
              <input
                name="shared.hero.image"
                value={draft.shared.value.hero.image}
              />
            </label>
            <label
              class="editor-field-wide"
              data-editor-field="shared.hero.hero_caption"
            >
              <span>
                Hero caption{" "}
                <small class="editor-field-badge editor-field-badge--optional">
                  Optional
                </small>
              </span>
              <input
                name="shared.hero.hero_caption"
                value={draft.shared.value.hero.hero_caption ?? ""}
              />
            </label>
          </div>
        ) : (
          <p>
            Shared source is {draft.shared.sourceState}; structured editing is
            unavailable.
          </p>
        )
      }
    </div>
  </section>
  <LocaleDraftSection locale="ja" source={draft.locales.ja} />
  <LocaleDraftSection locale="en" source={draft.locales.en} />
</form>
