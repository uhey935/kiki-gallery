---
import type { JournalEditorEntryState } from "../../editor/journal-state";

interface Props {
  entry: JournalEditorEntryState;
}

const { entry } = Astro.props;
const state = entry.structuralStatus === "valid" ? "valid" : "blocked";
---

<aside class="editor-validation" aria-labelledby="validation-heading">
  <div class="editor-panel__heading">
    <div>
      <p class="editor-eyebrow">Issues & capabilities</p>
      <h2 id="validation-heading">Validation</h2>
    </div>
    <span class:list={["editor-status", `editor-status--${state}`]}
      >{state}</span
    >
  </div>
  <p data-issue-summary>
    {
      entry.issueCount === 0
        ? "No draft issues"
        : `${entry.issueCount} draft issues`
    }
  </p>
  <dl class="editor-detail-list">
    <div>
      <dt>Save</dt><dd data-save>
        {entry.capabilities.save ? "Available" : "Blocked"}
      </dd>
    </div>
    <div>
      <dt>Preview JA</dt><dd data-preview-ja>
        {entry.capabilities.preview.ja ? "Available" : "Blocked"}
      </dd>
    </div>
    <div>
      <dt>Preview EN</dt><dd data-preview-en>
        {entry.capabilities.preview.en ? "Available" : "Blocked"}
      </dd>
    </div>
    <div>
      <dt>Publish</dt><dd data-publish>
        {entry.capabilities.publish ? "Available" : "Blocked"}
      </dd>
    </div>
  </dl>
  <ul class="editor-issues" data-issues hidden={entry.issues.length === 0}>
    {
      entry.issues.map((issue) => (
        <li>
          <strong>{issue.severity}</strong> {issue.ruleId}
          <small>{issue.messageKey}</small>
        </li>
      ))
    }
  </ul>
</aside>
