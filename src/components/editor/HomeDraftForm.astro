---
import type { HomeEditorDraftState } from "../../editor/home-draft-state.ts";
const { draft } = Astro.props as { draft: HomeEditorDraftState };
if (
  draft.shared.state !== "editable" ||
  draft.locales.ja.state !== "editable" ||
  draft.locales.en.state !== "editable"
)
  throw new Error("Home draft sources unavailable");
const shared = draft.shared.value;
---

<form class="editor-draft-form" data-home-draft-form>
  <section class="editor-entry-section">
    <header><h2>Shared</h2></header><div
      class="editor-entry-section__content editor-field-grid"
    >
      <label
        ><span>Hero type</span><select name="hero_type"
          ><option value="none" selected={!shared.home_hero}>none</option
          ><option
            value="image"
            selected={shared.home_hero?.media.type === "image"}>image</option
          ><option
            value="video"
            selected={shared.home_hero?.media.type === "video"}>video</option
          ></select
        ></label
      >
      <label
        ><span>Hero image</span><input
          name="hero_image"
          value={shared.home_hero?.media.type === "image"
            ? shared.home_hero.media.image
            : ""}
        /></label
      >
      <label
        ><span>Hero video</span><input
          name="hero_video"
          value={shared.home_hero?.media.type === "video"
            ? shared.home_hero.media.video
            : ""}
        /></label
      >
      <label
        ><span>Hero poster</span><input
          name="hero_poster"
          value={shared.home_hero?.media.type === "video"
            ? (shared.home_hero.media.poster ?? "")
            : ""}
        /></label
      >
      <label
        ><span>Artists destination</span><input
          name="artists_destination"
          value={shared.sections.artists.destination}
          readonly
        /></label
      >
      <label
        ><span>Artists image</span><input
          name="artists_image"
          value={shared.sections.artists.image.src}
        /></label
      >
      <label
        ><span>About destination</span><input
          name="about_destination"
          value={shared.sections.about.destination}
          readonly
        /></label
      >
      <label
        ><span>About image</span><input
          name="about_image"
          value={shared.sections.about.image.src}
        /></label
      >
    </div>
  </section>
  {
    (["ja", "en"] as const).map((locale) => {
      const value = draft.locales[locale];
      if (value.state !== "editable") return null;
      return (
        <section class="editor-entry-section" data-locale={locale}>
          <>
            <header>
              <div>
                <>
                  <p class="editor-eyebrow">{locale.toUpperCase()}</p>
                  <h2>{locale === "ja" ? "Japanese" : "English"}</h2>
                </>
              </div>
            </header>
            <div class="editor-entry-section__content editor-field-grid">
              <p
                class="editor-field-wide"
                data-copy-status={draft.copyStatus[locale]}
              >
                {locale === "ja" && draft.copyStatus.ja === "temporary"
                  ? "Temporary / requires final copy"
                  : locale === "en" && draft.copyStatus.en === "placeholder"
                    ? "Unresolved translation / Preview blocked"
                    : "Copy approved"}
              </p>
              <label class="editor-field-wide">
                <>
                  <span>About intro · Required</span>
                  <textarea
                    name={`${locale}_about_intro`}
                    set:text={value.value.about_intro}
                  />
                </>
              </label>
              {locale === "ja" && (
                <label>
                  <input
                    type="checkbox"
                    name="ja_copy_approved"
                    checked={draft.copyStatus.ja === "approved"}
                  />{" "}
                  Copy finalized
                </label>
              )}
            </div>
          </>
        </section>
      );
    })
  }
  <section class="editor-entry-section" data-editor-section="metadata">
    <header>
      <div>
        <p class="editor-eyebrow">Localized metadata</p><h2>Metadata</h2>
      </div>
    </header>
    <div class="editor-entry-section__content">
      <p class="editor-field-help">
        Leave fields blank to use the existing KiKi Gallery site fallback.
      </p>
      <div class="editor-field-grid">
        {
          (["ja", "en"] as const).map((locale) => {
            const source = draft.locales[locale];
            return source.state === "editable" ? (
              <>
                <label data-editor-field={`${locale}.seo_title`}>
                  <span>
                    {locale.toUpperCase()} SEO title{" "}
                    <small class="editor-field-badge editor-field-badge--optional">
                      Optional
                    </small>
                  </span>
                  <input
                    name={`${locale}_seo_title`}
                    value={source.value.seo_title ?? ""}
                  />
                </label>
                <label
                  class="editor-field-wide"
                  data-editor-field={`${locale}.description`}
                >
                  <span>
                    {locale.toUpperCase()} SEO description{" "}
                    <small class="editor-field-badge editor-field-badge--optional">
                      Optional
                    </small>
                  </span>
                  <textarea
                    name={`${locale}_description`}
                    rows="3"
                    set:text={source.value.description ?? ""}
                  />
                </label>
              </>
            ) : (
              <p>{locale.toUpperCase()} source unavailable.</p>
            );
          })
        }
      </div>
    </div>
  </section>
</form>
