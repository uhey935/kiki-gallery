---
import type { ArtistsEditorDraftState } from "../../editor/artists-draft-state";
const { draft, create = false } = Astro.props as { draft: ArtistsEditorDraftState; create?: boolean };
const { data } = draft;
const en =
  draft.locales.en.state === "editable" ? draft.locales.en.value : undefined;
---

<form class="editor-draft-form" data-artists-draft-form>
  <div class="editor-field-meaning" aria-label="Field requirement legend">
    <span><b>Required</b> needed for a valid draft</span>
    <span><b>Optional</b> may be left blank</span>
  </div>
  <section class="editor-entry-section">
    <header>
      <div><p class="editor-eyebrow">Shared fields</p><h2>Shared</h2></div>
    </header>
    <div class="editor-entry-section__content editor-field-grid">
      <label data-editor-field="name">
        <span
          >Sort name (Shared) <small class="editor-field-badge">Required</small
          ></span
        >
        <input name="name" value={data.name} />
      </label>
      <label class="editor-field-wide" data-editor-field="medium">
        <span>
          Medium (one English term per line)
          <small class="editor-field-badge">Required</small>
        </span>
        <textarea name="medium">{data.medium.join("\n")}</textarea>
      </label>
      {create ? (
        <section class="editor-field-wide editor-hero-asset" data-editor-field="hero.image" data-artists-create-hero>
          <header><span>Hero image <small class="editor-field-badge">Required</small></span></header>
          <input type="hidden" name="hero.image" value="" data-artists-create-hero-path />
          <div class="editor-hero-drop" data-artists-create-hero-drop>
            <p>Drag & drop a JPEG, PNG, WebP, or AVIF image here</p>
            <button type="button" data-artists-create-hero-select>Select from desktop</button>
          </div>
          <div data-artists-create-hero-current hidden>
            <div class="editor-hero-asset__preview">
              <img alt="" data-artists-create-hero-thumbnail />
            </div>
            <div class="editor-hero-asset__details">
              <p><strong>New image · temporary / unsaved</strong></p>
              <code data-artists-create-hero-canonical-path></code>
            </div>
            <div class="editor-asset-actions">
              <button type="button" data-artists-create-hero-replace>Replace</button>
              <button type="button" data-artists-create-hero-remove>Remove</button>
            </div>
          </div>
          <input type="file" accept="image/avif,image/jpeg,image/png,image/webp" data-artists-create-hero-file hidden />
          <p data-artists-create-hero-status role="status" aria-live="polite"></p>
        </section>
      ) : <section class="editor-field-wide editor-hero-asset" data-editor-field="hero.image" data-artists-hero>
        <header><span>Hero image <small class="editor-field-badge">Required</small></span></header>
        <input type="hidden" name="hero.image" value={data.hero.image} data-artists-hero-path />
        <div data-artists-hero-current>
          <div class="editor-hero-asset__preview">
            <img src={data.hero.image} alt="" data-artists-hero-thumbnail />
          </div>
          <div class="editor-hero-asset__details">
            <p><strong data-artists-hero-state>Canonical · saved</strong></p>
            <code data-artists-hero-canonical-path>{data.hero.image}</code>
          </div>
          <div class="editor-asset-actions">
            <button type="button" data-artists-hero-replace>Replace</button>
            <button type="button" data-artists-hero-remove>Remove</button>
          </div>
        </div>
        <div class="editor-hero-drop" data-artists-hero-drop hidden>
          <p>Drag & drop a JPEG, PNG, WebP, or AVIF image here</p>
          <button type="button" data-artists-hero-select>Select from desktop</button>
        </div>
        <input type="file" accept="image/avif,image/jpeg,image/png,image/webp" data-artists-hero-file hidden />
        <section data-artists-hero-confirm hidden>
          <h3>Replace existing image?</h3>
          <p>The canonical filename already exists with different bytes. It will remain unchanged until Save.</p>
          <div class="editor-hero-compare">
            <figure><img src={data.hero.image} alt="" data-artists-hero-old /><figcaption>Existing</figcaption></figure>
            <figure><img alt="" data-artists-hero-new /><figcaption>New · temporary</figcaption></figure>
          </div>
          <button type="button" data-artists-hero-reject>Cancel</button>
          <button type="button" data-artists-hero-accept>Replace</button>
        </section>
        <p data-artists-hero-status role="status" aria-live="polite"></p>
      </section>}
    </div>
  </section>
  <section class="editor-entry-section">
    <header>
      <div>
        <p class="editor-eyebrow">Work Content IDs</p><h2>Works layout</h2>
      </div>
    </header>
    <p>
      JSON array using single-a, single-b, double-a, or double-b layouts.
      Referenced assets remain managed by Works.
    </p>
    <div class="editor-entry-section__content editor-field-grid">
      <label class="editor-field-wide" data-editor-field="works_layout">
        <span>
          Layout sections
          <small class="editor-field-badge editor-field-badge--optional">
            Optional
          </small>
        </span>
        <textarea name="works_layout" rows="14"
          >{
            JSON.stringify(
              data.works_layout?.map((section) => ({
                layout: section.layout,
                works: section.works.map(({ id }) => id),
              })) ?? [],
              null,
              2,
            )
          }</textarea
        >
      </label>
    </div>
  </section>
  <section class="editor-entry-section">
    <header>
      <div>
        <p class="editor-eyebrow">Japanese locale</p><h2>JA content</h2>
      </div>
    </header>
    <div class="editor-entry-section__content editor-field-grid">
      <label data-editor-field="display_name">
        <span>
          JA name <small class="editor-field-badge">Required</small>
        </span>
        <input name="display_name" value={data.display_name ?? ""} />
      </label>
      <label data-editor-field="medium_label">
        <span>
          JA medium label <small class="editor-field-badge">Required</small>
        </span>
        <input name="medium_label" value={data.medium_label ?? ""} />
      </label>
      <label class="editor-field-wide" data-editor-field="short_bio">
        <span>
          JA short biography <small class="editor-field-badge">Required</small>
        </span>
        <textarea name="short_bio">{data.short_bio}</textarea>
      </label>
      <label class="editor-field-wide" data-editor-field="biography">
        <span>
          JA biography
          <small class="editor-field-badge editor-field-badge--optional">
            Optional
          </small>
        </span>
        <textarea name="biography">{data.biography ?? ""}</textarea>
      </label>
      <label class="editor-field-wide" data-editor-field="hero_alt">
        <span>
          JA alt text <small class="editor-field-badge">Required</small>
        </span>
        <textarea name="hero_alt">{data.hero_alt}</textarea>
      </label>
    </div>
  </section>
  <section class="editor-entry-section">
    <header>
      <div><p class="editor-eyebrow">English locale</p><h2>EN content</h2></div>
    </header>
    <p>
      Placeholder values keep the EN route unpublished and never fall back to
      JA.
    </p>
    <div class="editor-entry-section__content editor-field-grid">
      <label data-editor-field="en.name"
        ><span>EN name <small class="editor-field-badge">Required</small></span
        ><input name="en.name" value={en?.name ?? ""} /></label
      >
      <label data-editor-field="en.medium_label"
        ><span
          >EN medium label <small class="editor-field-badge">Required</small
          ></span
        ><input name="en.medium_label" value={en?.medium_label ?? ""} /></label
      >
      <label class="editor-field-wide" data-editor-field="en.short_bio"
        ><span
          >EN short biography <small class="editor-field-badge">Required</small
          ></span
        ><textarea name="en.short_bio">{en?.short_bio ?? ""}</textarea></label
      >
      <label class="editor-field-wide" data-editor-field="en.biography"
        ><span
          >EN biography <small
            class="editor-field-badge editor-field-badge--optional"
            >Optional</small
          ></span
        ><textarea name="en.biography">{en?.biography ?? ""}</textarea></label
      >
      <label class="editor-field-wide" data-editor-field="en.hero_alt"
        ><span
          >EN alt text <small class="editor-field-badge">Required</small></span
        ><textarea name="en.hero_alt">{en?.hero_alt ?? ""}</textarea></label
      >
    </div>
  </section>
  <section class="editor-entry-section">
    <header>
      <div>
        <p class="editor-eyebrow">Localized metadata</p><h2>Metadata</h2>
      </div>
    </header>
    <div class="editor-entry-section__content editor-field-grid">
      <label data-editor-field="seo_title">
        <span>
          JA SEO title
          <small class="editor-field-badge editor-field-badge--optional">
            Optional
          </small>
        </span>
        <input name="seo_title" value={data.seo_title ?? ""} />
      </label>
      <label class="editor-field-wide" data-editor-field="description">
        <span>
          JA description
          <small class="editor-field-badge editor-field-badge--optional">
            Optional
          </small>
        </span>
        <textarea name="description">{data.description ?? ""}</textarea>
      </label>
      <label data-editor-field="en.seo_title"
        ><span
          >EN SEO title <small
            class="editor-field-badge editor-field-badge--optional"
            >Optional</small
          ></span
        ><input name="en.seo_title" value={en?.seo_title ?? ""} /></label
      >
      <label class="editor-field-wide" data-editor-field="en.description"
        ><span
          >EN description <small
            class="editor-field-badge editor-field-badge--optional"
            >Optional</small
          ></span
        ><textarea name="en.description">{en?.description ?? ""}</textarea
        ></label
      >
    </div>
  </section>
</form>

<style>
  .editor-hero-asset { display: grid; gap: 16px; min-width: 0; border: 1px solid #d8d8d8; padding: 1rem; }
  [data-artists-create-hero-current], [data-artists-hero-current] { display: grid; gap: 16px; }
  .editor-hero-asset__details { display: grid; gap: 7px; }
  .editor-hero-asset__details p { margin: 0; }
  .editor-hero-asset__preview { display: grid; justify-items: center; padding-block: 20px; background: #f1f3ef; }
  .editor-hero-asset img { display: block; width: 100%; max-width: 100%; height: auto; max-height: 360px; object-fit: contain; background: #f1f3ef; }
  .editor-hero-drop { border: 1px dashed #999; padding: 1.5rem; text-align: center; }
  .editor-hero-drop.is-dragging { border-color: #111; background: #f4f4f4; }
  .editor-hero-compare { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .editor-hero-compare figure { margin: 0; }
  [data-artists-hero-canonical-path] { overflow-wrap: anywhere; }
</style>
