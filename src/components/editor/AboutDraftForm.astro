---
import type { AboutEditorDraftState } from "../../editor/about-draft-state.ts";
const { draft, imageAssets } = Astro.props as {
  draft: AboutEditorDraftState;
  imageAssets: string[];
};
if (
  draft.shared.state !== "editable" ||
  draft.locales.ja.state !== "editable" ||
  draft.locales.en.state !== "editable"
)
  throw new Error("About draft sources unavailable");
const shared = draft.shared.value;
const ja = draft.locales.ja.value;
const en = draft.locales.en.value;
---

<form class="editor-draft-form" data-about-draft-form>
  <section class="editor-entry-section" data-editor-section="shared-media">
    <header>
      <div><p class="editor-eyebrow">Shared</p><h2>Media</h2></div>
    </header>
    <div class="editor-entry-section__content editor-about-media">
      <article class="editor-about-image-slot" data-about-image-slot="hero">
        <h3>Hero</h3>
        <img
          class="editor-about-thumbnail"
          src={shared.images.hero.src}
          alt=""
          data-about-thumbnail
        />
        <p class="editor-about-image-error" data-about-image-error hidden>
          Image unavailable
        </p>
        <label
          ><span>Shared image</span><select
            name="hero_src"
            data-about-image-select
          >
            {
              imageAssets.map((src) => (
                <option value={src} selected={src === shared.images.hero.src}>
                  {src}
                </option>
              ))
            }
          </select></label
        >
        <p class="editor-field-help">
          Decorative hero image. Stored in Shared content.
        </p>
      </article>
      {
        shared.images.gallery.map((image, index) => (
          <article
            class="editor-about-image-slot"
            data-about-image-slot={`gallery-${index + 1}`}
          >
            <h3>Gallery {index + 1}</h3>
            <img
              class="editor-about-thumbnail"
              src={image.src}
              alt=""
              data-about-thumbnail
            />
            <p class="editor-about-image-error" data-about-image-error hidden>
              Image unavailable
            </p>
            <div class="editor-field-grid">
              <label class="editor-field-wide">
                <>
                  <span>Shared image</span>
                  <select name={`gallery_${index}_src`} data-about-image-select>
                    {imageAssets.map((src) => (
                      <option value={src} selected={src === image.src}>
                        {src}
                      </option>
                    ))}
                  </select>
                </>
              </label>
              <label>
                <>
                  <span>JA alt</span>
                  <input
                    name={`ja_gallery_${index}_alt`}
                    value={ja.images.gallery[index].alt}
                  />
                </>
              </label>
              <label>
                <>
                  <span>EN alt</span>
                  <input
                    name={`en_gallery_${index}_alt`}
                    value={en.images.gallery[index].alt}
                  />
                </>
              </label>
            </div>
          </article>
        ))
      }
    </div>
  </section>
  <section class="editor-entry-section" data-editor-section="shared-hours">
    <header>
      <div><p class="editor-eyebrow">Shared</p><h2>Hours</h2></div>
    </header>
    <div class="editor-entry-section__content editor-field-grid">
      <label
        ><span>Hours status</span><select name="hours_status"
          ><option value="pending" selected={shared.hours.status === "pending"}
            >pending</option
          ><option
            value="approved"
            selected={shared.hours.status === "approved"}>approved</option
          ></select
        ></label
      >
      <fieldset
        data-approved-hours
        hidden={shared.hours.status !== "approved"}
        class="editor-field-wide editor-checkbox-fieldset"
      >
        <legend>Open days</legend>
        <div class="editor-checkbox-options">
          {
            (
              [
                ["mon", "Monday"],
                ["tue", "Tuesday"],
                ["wed", "Wednesday"],
                ["thu", "Thursday"],
                ["fri", "Friday"],
                ["sat", "Saturday"],
                ["sun", "Sunday"],
              ] as const
            ).map(([value, label]) => (
              <label class="editor-checkbox-option">
                <input
                  name="open_days"
                  type="checkbox"
                  value={value}
                  checked={
                    shared.hours.status === "approved" &&
                    shared.hours.open_days.includes(value)
                  }
                />{" "}
                {label}
              </label>
            ))
          }
        </div>
        <label
          ><span>Opens</span><input
            name="opens"
            type="time"
            value={shared.hours.status === "approved" ? shared.hours.opens : ""}
          /></label
        >
        <label
          ><span>Closes</span><input
            name="closes"
            type="time"
            value={shared.hours.status === "approved"
              ? shared.hours.closes
              : ""}
          /></label
        >
      </fieldset>
    </div>
  </section>
  <section class="editor-entry-section" data-editor-section="shared-contact">
    <header>
      <div><p class="editor-eyebrow">Shared</p><h2>Contact</h2></div>
    </header>
    <div class="editor-entry-section__content editor-field-grid">
      <label
        ><span>Email · Optional</span><input
          name="email"
          type="email"
          value={shared.contact?.email ?? ""}
        /></label
      >
      <label
        ><span>Map URL · Optional</span><input
          name="map_url"
          type="url"
          value={shared.contact?.map_url ?? ""}
        /></label
      >
      <label
        ><span>Instagram URL · Optional</span><input
          name="instagram_url"
          type="url"
          value={shared.contact?.instagram_url ?? ""}
        /></label
      >
      <p class="editor-field-help editor-field-wide">
        URLs must be complete http:// or https:// links. Instagram expects the
        full profile URL.
      </p>
    </div>
  </section>
  {
    (["ja", "en"] as const).map((locale) => {
      const source = draft.locales[locale];
      if (source.state !== "editable") return null;
      const value = source.value;
      return (
        <>
          <section
            class="editor-entry-section"
            data-locale={locale}
            data-editor-section={`${locale}-content`}
          >
            <>
              <header>
                <>
                  <p class="editor-eyebrow">
                    {locale.toUpperCase()} · Localized content
                  </p>
                  <h2>{locale === "ja" ? "Japanese" : "English"}</h2>
                </>
              </header>
              <div class="editor-entry-section__content editor-field-grid">
                <label>
                  <>
                    <span>Content status</span>
                    <select name={`${locale}_content_status`}>
                      <>
                        <option
                          selected={value.content_status === "placeholder"}
                        >
                          placeholder
                        </option>
                        <option selected={value.content_status === "review"}>
                          review
                        </option>
                        <option selected={value.content_status === "approved"}>
                          approved
                        </option>
                      </>
                    </select>
                  </>
                </label>
                <label class="editor-field-wide">
                  <>
                    <span>Address</span>
                    <textarea
                      name={`${locale}_address`}
                      set:text={value.address}
                    />
                  </>
                </label>
                <label class="editor-field-wide">
                  <>
                    <span>Statement · Markdown</span>
                    <textarea
                      rows="10"
                      name={`${locale}_body`}
                      set:text={value.body}
                    />
                  </>
                </label>
              </div>
            </>
          </section>
          <section
            class="editor-entry-section"
            data-locale={locale}
            data-editor-section={`${locale}-metadata`}
          >
            <header>
              <div>
                <p class="editor-eyebrow">
                  {locale.toUpperCase()} · Localized metadata
                </p>
                <h2>SEO metadata</h2>
              </div>
            </header>
            <div class="editor-entry-section__content editor-field-grid">
              <label>
                <span>SEO title · Optional</span>
                <input
                  name={`${locale}_seo_title`}
                  value={value.seo_title ?? ""}
                />
              </label>
              <label>
                <span>SEO description · Optional</span>
                <textarea
                  name={`${locale}_description`}
                  set:text={value.description ?? ""}
                />
              </label>
            </div>
          </section>
        </>
      );
    })
  }
</form>
