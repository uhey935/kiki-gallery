---
import { editorRoutes } from "../../editor/shell";
import type { EditorEntrySummary } from "../../editor/collection-contracts";

interface Props {
  collectionId: string;
  collectionLabel: string;
  canCreate: boolean;
  entries: EditorEntrySummary[];
}

const { collectionId, collectionLabel, canCreate, entries } = Astro.props;
---

<section class="editor-panel" aria-labelledby="entries-heading">
  <div class="editor-panel__heading">
    <div>
      <p class="editor-eyebrow">{collectionLabel}</p>
      <h2 id="entries-heading">Entries</h2>
    </div>
    <div>
      <span class="editor-count">{entries.length} entries</span>
      {
        canCreate && (
          <a class="editor-button" href={`/editor/${collectionId}/create/`}>
            Create {collectionLabel}
          </a>
        )
      }
    </div>
  </div>

  <ul class="editor-list">
    {
      entries.map((entry) => (
        <li>
          <a
            class="editor-list-row"
            href={editorRoutes.workspace(collectionId, entry.contentId)}
          >
            <div>
              <strong>{entry.title}</strong>
              <small>
                {entry.contentId} · {entry.detail}
              </small>
            </div>
            <div class="editor-entry-meta">
              <span
                class:list={[
                  "editor-status",
                  entry.status === "valid"
                    ? "editor-status--valid"
                    : "editor-status--blocked",
                ]}
              >
                {entry.statusLabel}
              </span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="editor-panel__footer">
    <small>Existing entries open through the canonical Editor boundary.</small>
    <span>Select an entry to open its workspace.</span>
  </div>
</section>
