---
import type { NewsEditorDraftState } from "../../editor/news-draft-state";
const { draft } = Astro.props as { draft: NewsEditorDraftState };
const { data } = draft;
---

<form class="editor-draft-form" data-news-draft-form>
  <div class="editor-field-meaning" aria-label="Field requirement legend">
    <span><b>Required</b> needed for a valid draft</span>
    <span><b>Optional</b> may be left blank</span>
  </div>
  <section class="editor-entry-section">
    <header>
      <div><p class="editor-eyebrow">Announcement</p><h2>News</h2></div>
    </header>
    <p>
      News has no image, body, or Detail page. Internal links may provide a
      derived Home image.
    </p>
    <div class="editor-entry-section__content">
      <div class="editor-field-grid">
        <label data-editor-field="title">
          <span>Title <small class="editor-field-badge">Required</small></span>
          <input name="title" value={data.title} />
        </label>
        <label data-editor-field="date">
          <span>Date <small class="editor-field-badge">Required</small></span>
          <input name="date" type="date" value={data.date} />
        </label>
        <label data-editor-field="news_type">
          <span>Type <small class="editor-field-badge">Required</small></span>
          <select name="news_type">
            {
              (["exhibition", "artist", "general"] as const).map((type) => (
                <option value={type} selected={data.news_type === type}>
                  {type}
                </option>
              ))
            }
          </select>
        </label>
        <label class="editor-field-wide" data-editor-field="summary">
          <span>
            Summary
            <small class="editor-field-badge editor-field-badge--optional">
              Optional
            </small>
          </span>
          <textarea name="summary">{data.summary ?? ""}</textarea>
        </label>
        <label data-editor-field="link">
          <span>
            Link
            <small class="editor-field-badge editor-field-badge--optional">
              Optional
            </small>
          </span>
          <input
            name="link"
            value={data.link ?? ""}
            placeholder="/artists/example or https://…"
          />
        </label>
      </div>
      <p>
        <label data-editor-field="show_on_home">
          <input
            name="show_on_home"
            type="checkbox"
            checked={data.show_on_home}
          /> Show on Home
          <small class="editor-field-badge editor-field-badge--optional">
            Optional
          </small>
        </label>
      </p>
    </div>
  </section>
</form>
