---
import type { Locale } from "../../content-loaders/journal/contracts";
import type { JournalLocalized } from "../../content-loaders/journal/schema";
import type { JournalEditorDraftSource } from "../../editor/journal-draft-state";

interface Props {
  locale: Locale;
  source: JournalEditorDraftSource<JournalLocalized & { body: string }>;
}

const { locale, source } = Astro.props;
---

<section class="editor-entry-section" data-editor-section={locale}>
  <header>
    <div>
      <p class="editor-eyebrow">Draft locale</p><h2>{locale.toUpperCase()}</h2>
    </div>
    <div class="editor-section-status">
      <span data-section-dirty hidden>Modified</span><span class="editor-status"
        >{source.state}</span
      >
    </div>
  </header>
  <div class="editor-entry-section__content">
    {
      source.state === "editable" ? (
        <div class="editor-field-grid">
          <label
            class="editor-field-wide"
            data-editor-field={`${locale}.title`}
          >
            <span>
              Title <small class="editor-field-badge">Required</small>
            </span>
            <input name={`${locale}.title`} value={source.value.title} />
          </label>
          <label
            class="editor-field-wide"
            data-editor-field={`${locale}.summary`}
          >
            <span>
              Summary <small class="editor-field-badge">Required</small>
            </span>
            <textarea
              name={`${locale}.summary`}
              rows="3"
              set:text={source.value.summary}
            />
          </label>
          <label
            class="editor-field-wide"
            data-editor-field={`${locale}.hero_alt`}
          >
            <span>
              Hero alt <small class="editor-field-badge">Required</small>
            </span>
            <input name={`${locale}.hero_alt`} value={source.value.hero_alt} />
          </label>
          <label class="editor-field-wide" data-editor-field={`${locale}.body`}>
            <span>
              Markdown body{" "}
              <small class="editor-field-badge editor-field-badge--publish">
                Publish checked
              </small>
            </span>
            <textarea
              class="editor-markdown-input"
              name={`${locale}.body`}
              rows="14"
              set:text={source.value.body}
            />
          </label>
        </div>
      ) : (
        <p>
          Locale source is {source.sourceState}; structured editing is
          unavailable.
        </p>
      )
    }
  </div>
</section>
