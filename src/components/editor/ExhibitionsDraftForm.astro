---
import type { ExhibitionsEditorDraftState } from "../../editor/exhibitions-draft-state";
const { draft, create = false } = Astro.props as { draft: ExhibitionsEditorDraftState; create?: boolean };
const shared = draft.shared.state === "editable" ? draft.shared.value : undefined;
const localized = (locale: "ja" | "en") => draft.locales[locale].state === "editable" ? draft.locales[locale].value : undefined;
const ja = localized("ja");
const en = localized("en");
---
<form class="editor-draft-form" data-exhibitions-draft-form>
  <div class="editor-field-meaning" aria-label="Field requirement legend"><span><b>Required</b> needed for a valid draft</span><span><b>Optional</b> may be left blank</span></div>
  <section class="editor-entry-section"><header><div><p class="editor-eyebrow">Shared</p><h2>Schedule, references & hero</h2></div></header>
    {shared ? <div class="editor-entry-section__content editor-field-grid">
      <label class="editor-field-wide"><span>Artists <small class="editor-field-badge">Required</small></span><textarea name="shared.artists">{shared.artists.join("\n")}</textarea></label>
      <label class="editor-field-wide"><span>Works <small class="editor-field-badge editor-field-badge--optional">Optional</small></span><textarea name="shared.works">{shared.works?.join("\n") ?? ""}</textarea></label>
      <label><span>Start date <small class="editor-field-badge">Required</small></span><input name="shared.start_date" type="date" value={shared.start_date} /></label>
      <label><span>End date <small class="editor-field-badge">Required</small></span><input name="shared.end_date" type="date" value={shared.end_date} /></label>
      <label><span>Opens <small class="editor-field-badge editor-field-badge--optional">Optional</small></span><input name="shared.opening_hours.opens" type="time" value={shared.opening_hours?.opens ?? ""} /></label>
      <label><span>Closes <small class="editor-field-badge editor-field-badge--optional">Optional</small></span><input name="shared.opening_hours.closes" type="time" value={shared.opening_hours?.closes ?? ""} /></label>
      <fieldset class="editor-field-wide editor-checkbox-fieldset">
        <legend>Closed weekdays <small class="editor-field-badge editor-field-badge--optional">Optional</small></legend>
        <label class="editor-checkbox-option editor-checkbox-option--status"><input name="shared.closed_weekdays.known" type="checkbox" checked={shared.closed_weekdays !== undefined} /> Information set</label>
        <div class="editor-checkbox-options">
          {([['mon','Monday'],['tue','Tuesday'],['wed','Wednesday'],['thu','Thursday'],['fri','Friday'],['sat','Saturday'],['sun','Sunday']] as const).map(([value, label]) => <label class="editor-checkbox-option"><input name="shared.closed_weekdays" type="checkbox" value={value} checked={shared.closed_weekdays?.includes(value)} /> {label}</label>)}
        </div>
      </fieldset>
      <label><span>Display artists</span><select name="shared.display_artists"><option value="default" selected={shared.display_artists === undefined}>Default</option><option value="true" selected={shared.display_artists === true}>Yes</option><option value="false" selected={shared.display_artists === false}>No</option></select></label>
      <section class="editor-field-wide editor-hero-asset" data-editor-field="shared.hero.image" data-exhibitions-hero data-create={String(create)}>
        <header><span>Hero image <small class="editor-field-badge">Required</small></span></header>
        <input type="hidden" name="shared.hero.image" value={create ? "" : shared.hero.image} data-exhibitions-hero-path />
        <div data-exhibitions-hero-current hidden={create}>
          <div class="editor-hero-asset__preview">
            <img src={create ? undefined : shared.hero.image} alt="" data-exhibitions-hero-thumbnail />
          </div>
          <div class="editor-hero-asset__details">
            <p><strong data-exhibitions-hero-state>{create ? "New image · temporary / unsaved" : "Canonical · saved"}</strong></p>
            <code data-exhibitions-hero-canonical-path>{create ? "" : shared.hero.image}</code>
          </div>
          <div class="editor-asset-actions"><button type="button" data-exhibitions-hero-replace>Replace</button><button type="button" data-exhibitions-hero-remove>Remove</button></div>
        </div>
        <div class="editor-hero-drop" data-exhibitions-hero-drop hidden={!create}>
          <p>Drag & drop a JPEG, PNG, WebP, or AVIF image here</p><button type="button" data-exhibitions-hero-select>Select from desktop</button>
        </div>
        <input type="file" accept="image/avif,image/jpeg,image/png,image/webp" data-exhibitions-hero-file hidden />
        <section data-exhibitions-hero-confirm hidden><h3>Replace existing image?</h3><p>The canonical filename already exists with different bytes. It will remain unchanged until Save.</p><div class="editor-hero-compare"><figure><img src={shared.hero.image} alt="" data-exhibitions-hero-old /><figcaption>Existing</figcaption></figure><figure><img alt="" data-exhibitions-hero-new /><figcaption>New · temporary</figcaption></figure></div><button type="button" data-exhibitions-hero-reject>Cancel</button><button type="button" data-exhibitions-hero-accept>Replace</button></section>
        <p data-exhibitions-hero-status role="status" aria-live="polite"></p>
      </section>
      <label><span>Orientation <small class="editor-field-badge">Required</small></span><select name="shared.hero.orientation"><option selected={shared.hero.orientation === "portrait"}>portrait</option><option selected={shared.hero.orientation === "landscape"}>landscape</option></select></label>
      <label><span>Position</span><input name="shared.hero.position" value={shared.hero.position ?? ""} /></label><label><span>Treatment</span><input name="shared.hero.treatment" value={shared.hero.treatment ?? ""} /></label>
    </div> : <p>Shared source unavailable.</p>}
  </section>
  {["ja", "en"].map((locale) => { const data = localized(locale as "ja" | "en"); return <section class="editor-entry-section" data-editor-section={locale}><header><div><p class="editor-eyebrow">Localized content</p><h2>{locale.toUpperCase()}</h2></div></header>{data ? <div class="editor-entry-section__content editor-field-grid">
    <label class="editor-field-wide"><span>Title <small class="editor-field-badge">Required</small></span><input name={`${locale}.title`} value={data.title} /></label>
    {(["venue","attendance","hero_caption"] as const).map(field => <label><span>{field}</span><input name={`${locale}.${field}`} value={data[field] ?? ""} /></label>)}
    <label class="editor-field-wide"><span>Hero alt <small class="editor-field-badge">Required</small></span><textarea name={`${locale}.hero_alt`}>{data.hero_alt}</textarea></label>
    <label class="editor-field-wide"><span>Exhibition text <small class="editor-field-badge editor-field-badge--optional">Optional</small></span><small>Markdown supported</small><textarea name={`${locale}.body`} rows="14">{data.body}</textarea></label>
  </div> : <p>{locale.toUpperCase()} source unavailable.</p>}</section>; })}
  <section class="editor-entry-section">
    <header><div><p class="editor-eyebrow">Localized metadata</p><h2>Metadata</h2></div></header>
    <div class="editor-entry-section__content editor-field-grid">
      <label data-editor-field="ja.seo_title"><span>JA SEO title <small class="editor-field-badge editor-field-badge--optional">Optional</small></span><input name="ja.seo_title" value={ja?.seo_title ?? ""} /></label>
      <label class="editor-field-wide" data-editor-field="ja.description"><span>JA SEO description <small class="editor-field-badge editor-field-badge--optional">Optional</small></span><textarea name="ja.description">{ja?.description ?? ""}</textarea></label>
      <label data-editor-field="en.seo_title"><span>EN SEO title <small class="editor-field-badge editor-field-badge--optional">Optional</small></span><input name="en.seo_title" value={en?.seo_title ?? ""} /></label>
      <label class="editor-field-wide" data-editor-field="en.description"><span>EN SEO description <small class="editor-field-badge editor-field-badge--optional">Optional</small></span><textarea name="en.description">{en?.description ?? ""}</textarea></label>
    </div>
  </section>
</form>

<style>
  .editor-hero-asset {
    display: grid;
    gap: 16px;
    min-width: 0;
  }
  [data-exhibitions-hero-current] {
    display: grid;
    gap: 16px;
  }
  .editor-hero-asset__details {
    display: grid;
    gap: 7px;
  }
  .editor-hero-asset__details p {
    margin: 0;
  }
  .editor-hero-asset__preview {
    padding-block: 20px;
    background: #f1f3ef;
  }
  [data-exhibitions-hero-current] img,
  .editor-hero-compare img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: 360px;
    object-fit: contain;
    background: #f1f3ef;
  }
  .editor-hero-compare {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .editor-hero-compare figure {
    min-width: 0;
    margin: 0;
  }
  [data-exhibitions-hero-canonical-path] {
    overflow-wrap: anywhere;
  }
  @media (max-width: 600px) {
    .editor-hero-compare {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
