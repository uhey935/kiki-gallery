---
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import Layout from "../../layouts/Layout.astro";
import {
  exhibitionsPreviewStore,
  ExhibitionsPreviewError,
} from "../exhibitions-preview";
import { formatDateRangeJa } from "../../utils/date";
import "../../styles/exhibitions.css";
const { token, contentId: locale } = Astro.params;
let preview;
let previewError;
try {
  if (!token || (locale !== "ja" && locale !== "en"))
    throw new ExhibitionsPreviewError(
      "Invalid preview URL",
      "preview-not-found",
    );
  preview = exhibitionsPreviewStore.read(token, locale);
} catch (error) {
  Astro.response.status =
    error instanceof ExhibitionsPreviewError && error.code === "preview-expired"
      ? 410
      : 404;
  previewError = error instanceof Error ? error.message : "Preview unavailable";
}
const rendered = preview
  ? await (await createMarkdownProcessor()).render(preview.body)
  : undefined;
const date = preview
  ? formatDateRangeJa(
      preview.shared.start_date,
      preview.shared.end_date,
    )
  : "";
---

{
  preview && rendered ? (
    <Layout
      title={`${preview.localized.title} · Draft Preview`}
    >
      <>
        <aside class="editor-preview-banner">
          Exhibitions draft preview · not saved
        </aside>
        <section class="section exhibitions-detail">
          <header class="exhibitions-heading">
            <>
              <p class="exhibitions-heading-artist">
                {preview.shared.artists.join("、")}
              </p>
              <h1 class="exhibitions-h1-title">
                {preview.localized.title}
              </h1>
            </>
          </header>
        </section>
        <figure
          class:list={[
            "exhibitions-detail-image",
            {
              "exhibitions-detail-image--portrait":
                preview.shared.hero.orientation === "portrait",
            },
          ]}
        >
          <img src={preview.shared.hero.image} alt={preview.localized.hero_alt} />
          {preview.localized.hero_caption && (
            <figcaption>{preview.localized.hero_caption}</figcaption>
          )}
        </figure>
        <section class="section exhibitions-content">
          <div class="exhibitions-main">
            <>
              <section class="exhibitions-info">
                <dl class="exhibitions-info-list">
                  <>
                    <dt>開催期間</dt>
                    <dd>{date}</dd>
                  </>
                </dl>
              </section>
              <article class="exhibitions-article">
                {preview.localized.summary && <p>{preview.localized.summary}</p>}
                <div set:html={rendered.code} />
              </article>
            </>
          </div>
        </section>
      </>
    </Layout>
  ) : (
    <main class="editor-preview-error">
      <>
        <h1>Draft preview unavailable</h1>
        <p>{previewError}</p>
      </>
    </main>
  )
}
<style>
  .editor-preview-banner {
    position: sticky;
    z-index: 10;
    top: 0;
    padding: 10px 20px;
    background: #fff4c2;
    color: #594c18;
    text-align: center;
    font:
      600 0.78rem/1.4 system-ui,
      sans-serif;
  }
  .editor-preview-error {
    margin: 10vh auto;
    width: min(640px, calc(100% - 40px));
    font-family: system-ui, sans-serif;
  }
</style>
