---
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import ExhibitionDetailPresentation from "../../components/ExhibitionDetailPresentation.astro";
import { createExhibitionDetailPresentationModel } from "../../components/exhibition-detail-projection.ts";
import Layout from "../../layouts/Layout.astro";
import {
  exhibitionsPreviewStore,
  ExhibitionsPreviewError,
} from "../exhibitions-preview";

const { token, contentId: locale } = Astro.params;
let preview;
let previewError;
try {
  if (!token || (locale !== "ja" && locale !== "en"))
    throw new ExhibitionsPreviewError(
      "Invalid preview URL",
      "preview-not-found",
    );
  preview = exhibitionsPreviewStore.read(token, locale);
} catch (error) {
  Astro.response.status =
    error instanceof ExhibitionsPreviewError && error.code === "preview-expired"
      ? 410
      : 404;
  previewError = error instanceof Error ? error.message : "Preview unavailable";
}
const rendered = preview
  ? await (await createMarkdownProcessor()).render(preview.body)
  : undefined;
const model = preview
  ? await createExhibitionDetailPresentationModel({
      contentId: preview.contentId,
      locale: preview.locale,
      shared: preview.shared,
      localized: preview.localized,
    })
  : undefined;
---

{
  preview && rendered && model ? (
    <Layout
      title={`${preview.localized.seo_title ?? model.title} · Draft Preview`}
      description={preview.localized.description}
      locale={preview.locale}
    >
      <aside class="editor-preview-banner">
        Exhibitions {preview.locale.toUpperCase()} draft preview · not saved
      </aside>
      <ExhibitionDetailPresentation {model}>
        <Fragment set:html={rendered.code} />
      </ExhibitionDetailPresentation>
    </Layout>
  ) : (
    <main class="editor-preview-error">
      <h1>Draft preview unavailable</h1>
      <p>{previewError}</p>
    </main>
  )
}

<style>
  .editor-preview-banner {
    position: sticky;
    z-index: 10;
    top: 0;
    padding: 10px 20px;
    background: #fff4c2;
    color: #594c18;
    text-align: center;
    font:
      600 0.78rem/1.4 system-ui,
      sans-serif;
  }
  .editor-preview-error {
    margin: 10vh auto;
    width: min(640px, calc(100% - 40px));
    font-family: system-ui, sans-serif;
  }
</style>
