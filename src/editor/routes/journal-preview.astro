---
import { createMarkdownProcessor } from "@astrojs/markdown-remark";

import type { Locale } from "../../content-loaders/journal/contracts";
import { JournalPreviewError, journalPreviewStore } from "../journal-preview";
import Layout from "../../layouts/Layout.astro";
import JournalDetailPresentation from "../../components/JournalDetailPresentation.astro";
import { createJournalDetailPresentationModel } from "../../components/journal-detail-presentation";
import { createJournalMetadataModel } from "../../components/journal-metadata";

const { token, locale } = Astro.params;
let preview;
let previewError: string | undefined;
try {
  if (!token || (locale !== "ja" && locale !== "en")) {
    throw new JournalPreviewError("Invalid preview URL", "preview-not-found");
  }
  preview = journalPreviewStore.read(token, locale as Locale);
} catch (error) {
  Astro.response.status =
    error instanceof JournalPreviewError && error.code === "preview-expired"
      ? 410
      : 404;
  previewError =
    error instanceof Error ? error.message : "Preview state is unavailable";
}
const rendered = preview
  ? await (await createMarkdownProcessor()).render(preview.body)
  : undefined;
const model = preview
  ? createJournalDetailPresentationModel({
      locale: preview.locale,
      hero: preview.shared.hero,
      heroAlt: preview.localized.hero_alt,
      title: preview.localized.title,
      date: preview.shared.date,
    })
  : undefined;
const metadata = preview
  ? createJournalMetadataModel(preview.localized)
  : undefined;
---

{
  preview && rendered && model && metadata ? (
    <Layout
      title={metadata.title}
      description={metadata.description}
      locale={preview.locale}
      robots="noindex,nofollow"
      canonical={false}
      social={false}
    >
      <aside class="editor-preview-banner">
        Draft preview · {preview.locale.toUpperCase()} · not saved
      </aside>
      <JournalDetailPresentation {model}>
        <Fragment set:html={rendered.code} />
      </JournalDetailPresentation>
    </Layout>
  ) : (
    <main class="editor-preview-error">
      <h1>Draft preview unavailable</h1>
      <p>{previewError}</p>
    </main>
  )
}

<style>
  .editor-preview-banner {
    position: sticky;
    z-index: 10;
    top: 0;
    padding: 10px 20px;
    background: #fff4c2;
    color: #594c18;
    text-align: center;
    font:
      600 0.78rem/1.4 system-ui,
      sans-serif;
  }
  .editor-preview-error {
    margin: 10vh auto;
    width: min(640px, calc(100% - 40px));
    font-family: system-ui, sans-serif;
  }
</style>
