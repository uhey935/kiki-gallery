---
import Layout from "../../layouts/Layout.astro";
import HomePresentation from "../../components/HomePresentation.astro";
import { homePreviewStore, HomePreviewError } from "../home-preview";
import { createHomePresentationModel } from "../../content-boundaries/home-composition.ts";
const { token, contentId } = Astro.params;
let preview;
let previewError;
try {
  if (!token || !contentId)
    throw new HomePreviewError("Invalid preview URL", "preview-not-found");
  preview = homePreviewStore.read(token, contentId);
} catch (error) {
  Astro.response.status =
    error instanceof HomePreviewError && error.code === "preview-expired"
      ? 410
      : 404;
  previewError = error instanceof Error ? error.message : "Preview unavailable";
}
const locale = preview?.locale ?? "ja";
const presentation = preview
  ? await createHomePresentationModel(locale, preview.shared, preview.localized)
  : undefined;
---

{
  preview ? (
    <Layout title="Home · Draft Preview" locale={locale} flush={true}>
      <HomePresentation {...presentation!} />
    </Layout>
  ) : (
    <main class="editor-preview-error">
      <>
        <h1>Draft preview unavailable</h1>
        <p>{previewError}</p>
      </>
    </main>
  )
}
