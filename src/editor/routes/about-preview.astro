---
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import AboutView from "../../components/AboutView.astro";
import Layout from "../../layouts/Layout.astro";
import { aboutPreviewStore, AboutPreviewError } from "../about-preview.ts";
import "../../styles/about.css";
Astro.response.headers.set("Cache-Control", "private, no-store");
const { token, locale } = Astro.params;
let preview;
let previewError;
try {
  if (!token || (locale !== "ja" && locale !== "en"))
    throw new AboutPreviewError("Invalid preview URL", "preview-not-found");
  preview = aboutPreviewStore.read(token, locale);
} catch (error) {
  Astro.response.status =
    error instanceof AboutPreviewError && error.code === "preview-expired"
      ? 410
      : 404;
  previewError = error instanceof Error ? error.message : "Preview unavailable";
}
const statement = preview
  ? await (await createMarkdownProcessor()).render(preview.body)
  : undefined;
---

{
  preview ? (
    <Layout
      title={`${preview.seoTitle ?? "About"} · Draft Preview`}
      description={preview.description}
      locale={preview.locale}
      robots="noindex,nofollow"
      canonical={false}
      social={false}
    >
      <p class="editor-preview-notice">
        Draft preview · {preview.contentStatus} · not formal Production approval
      </p>
      <AboutView
        locale={preview.locale}
        contentStatus={preview.contentStatus}
        hero={preview.hero}
        gallery={preview.gallery}
        address={preview.address}
        hours={preview.hours}
        contact={preview.contact}
        preview
      >
        <Fragment slot="statement" set:html={statement?.code} />
      </AboutView>
    </Layout>
  ) : (
    <main>
      <>
        <h1>Draft preview unavailable</h1>
        <p>{previewError}</p>
      </>
    </main>
  )
}

<style>
  .editor-preview-notice {
    position: fixed;
    z-index: 20;
    top: 0;
    right: 0;
    margin: 0;
    padding: 8px 12px;
    background: #fff4c2;
    color: #594c18;
    font:
      600 0.72rem/1.4 system-ui,
      sans-serif;
  }
</style>
