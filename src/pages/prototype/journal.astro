---
import { getCollection, render } from "astro:content";
import {
  decideJournalSurface,
  evaluateJournalCapabilities,
  journalRouteRegistry,
  loadJournalRepository,
  queryJournalEntries,
} from "../../prototype/journal/core";
import { prototypeJournalRoot } from "../../prototype/journal/astro-loader";

const entries = await getCollection("journalPrototype");
const jaEntries = queryJournalEntries(entries, "ja");
const units = await loadJournalRepository(prototypeJournalRoot);
const unitsById = new Map(units.map((unit) => [unit.contentId, unit]));
const inspection = units.map((unit) => ({
  contentId: unit.contentId,
  sourceStates: {
    shared: unit.shared.state,
    ja: unit.locales.ja.state,
    en: unit.locales.en.state,
  },
  issues: unit.issues,
  capabilities: evaluateJournalCapabilities(unit),
  renderDecisions: Object.fromEntries(
    jaEntries
      .filter((entry) => entry.data.contentId === unit.contentId)
      .flatMap((entry) => ["index", "detail", "home-stories", "news-integration"].map(
        (surface) => [surface, decideJournalSurface(entry, unit.issues, surface as "index" | "detail" | "home-stories" | "news-integration")],
      )),
  ),
}));
const rendered = await Promise.all(jaEntries.map(async (entry) => ({
  entry,
  output: await render(entry),
  unit: unitsById.get(entry.data.contentId),
})));
---

<!-- Isolated build harness; production consumers do not link to this route. -->
<html lang="ja">
  <head><meta charset="utf-8" /><title>Journal prototype harness</title></head>
  <body>
    <h1>Journal prototype harness</h1>
    <pre id="boundary-inspection">{JSON.stringify(inspection, null, 2)}</pre>
    {rendered.map(({ entry, output: { Content }, unit }) => (
      <article
        data-content-id={entry.data.contentId}
        data-detail-decision={unit ? decideJournalSurface(entry, unit.issues, "detail").kind : "missing-unit"}
      >
        <h2><a href={journalRouteRegistry.build({ collection: "journal", contentId: entry.data.contentId, locale: "ja" })}>{entry.data.title}</a></h2>
        <Content />
      </article>
    ))}
  </body>
</html>
