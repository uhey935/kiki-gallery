---
import ActionBar from "../../../../components/editor/ActionBar.astro";
import WorksDraftForm from "../../../../components/editor/WorksDraftForm.astro";
import WorksValidationPanel from "../../../../components/editor/WorksValidationPanel.astro";
import RenamePanel from "../../../../components/editor/RenamePanel.astro";
import WorksDeletePanel from "../../../../components/editor/WorksDeletePanel.astro";
import { createWorksEditorDraft } from "../../../../editor/works-draft-state";
import { createWorksAssetDraftState } from "../../../../editor/works-asset-draft";
import {
  readWorksEditorEntry,
  readWorksEditorState,
} from "../../../../editor/works-state";
import EditorLayout from "../../../../layouts/EditorLayout.astro";

export async function getStaticPaths() {
  const state = await readWorksEditorState();
  return Promise.all(
    state.entries.map(async ({ contentId }) => ({
      params: { contentId },
      props: { entry: await readWorksEditorEntry(contentId) },
    })),
  );
}
const { entry } = Astro.props;
const draft = createWorksEditorDraft(entry);
const assetDraft = draft
  ? createWorksAssetDraftState(
      draft.contentId,
      crypto.randomUUID(),
      draft.data.images,
    )
  : undefined;
const serializedDraft = JSON.stringify(draft).replaceAll("<", "\\u003c");
const serializedAssetDraft = JSON.stringify(assetDraft).replaceAll(
  "<",
  "\\u003c",
);
---

<EditorLayout title={entry.data?.title ?? entry.contentId} section="Works">
  <header class="editor-page-heading">
    <p class="editor-eyebrow">Works workspace</p><h1>
      {entry.data?.title ?? entry.contentId}
    </h1><p>{entry.contentId} · Current flat Markdown</p>
  </header>
  <div class="editor-workspace">
    <main class="editor-panel editor-canvas">
      {
        draft ? (
          <WorksDraftForm draft={draft} />
        ) : (
          <p>
            Source cannot be represented as a Draft until validation issues are
            fixed.
          </p>
        )
      }
    </main><aside class="editor-workspace__sidebar">
      <WorksValidationPanel entry={entry} />
      <RenamePanel collection="works" contentId={entry.contentId} />
      <WorksDeletePanel contentId={entry.contentId} />
    </aside>
  </div>
  <ActionBar mode="works" loaded={Boolean(draft)} preview={false} />
</EditorLayout>
<script
  type="application/json"
  is:inline
  id="works-editor-draft"
  set:html={serializedDraft}
/>
<script
  type="application/json"
  is:inline
  id="works-asset-draft"
  set:html={serializedAssetDraft}
/>
<script>
  import {
    isWorksEditorDraftDirty,
    updateWorksEditorDraft,
    validateWorksEditorDraft,
    type WorksEditorDraftState,
  } from "../../../../editor/works-draft-state";
  import type { WorksAssetDraftState } from "../../../../editor/works-asset-draft";
  import type { WorksAssetPublishManifest } from "../../../../editor/works-asset-publish-manifest";
  import type { WorksRenamePublishEvidence } from "../../../../editor/works-publish";
  import {
    addTemporaryWorksAsset,
    removeTemporaryWorksAssetFromDraft,
    replaceExistingWorksAsset,
    reorderWorksAssetDraftImage,
    temporaryWorksAssetPreviewUrl,
    updateWorksAssetDraftAlt,
  } from "../../../../editor/works-asset-draft";
  import {
    editorFailureGuidance,
    isEditorManualRecoveryFailure,
    isEditorSaveShortcut,
    worksWorkspaceUxState,
  } from "../../../../editor/ux";
  const raw = document.querySelector<HTMLScriptElement>(
    "#works-editor-draft",
  )?.textContent;
  const form = document.querySelector<HTMLFormElement>(
    "[data-works-draft-form]",
  );
  const rawAssetDraft =
    document.querySelector<HTMLScriptElement>(
      "#works-asset-draft",
    )?.textContent;
  const button = document.querySelector<HTMLButtonElement>("[data-save-works]");
  const previewButton = document.querySelector<HTMLButtonElement>(
    "[data-preview-works]",
  );
  const publishButton = document.querySelector<HTMLButtonElement>(
    "[data-publish-works]",
  );
  const status = document.querySelector<HTMLElement>(
    "[data-works-action-status]",
  );
  const assetStatus = document.querySelector<HTMLElement>(
    "[data-works-asset-status]",
  );
  const assetList = document.querySelector<HTMLElement>(
    "[data-works-asset-list]",
  );
  const assetFile = document.querySelector<HTMLInputElement>(
    "[data-works-asset-file]",
  );
  const uploadButton = document.querySelector<HTMLButtonElement>(
    "[data-upload-works-assets]",
  );
  if (
    raw &&
    rawAssetDraft &&
    form &&
    button &&
    previewButton &&
    publishButton &&
    assetList &&
    assetFile &&
    uploadButton
  ) {
    let baseline = JSON.parse(raw) as WorksEditorDraftState;
    let draft = baseline;
    let assetDraft = JSON.parse(rawAssetDraft) as WorksAssetDraftState;
    let assetBaseline = structuredClone(assetDraft);
    let publishManifest: WorksAssetPublishManifest | undefined;
    let renameEvidence: WorksRenamePublishEvidence | undefined;
    let savedSincePublish = false;
    let pending: "save" | "preview" | "publish" | "upload" | null = null;
    let recoveryRequired = false;
    let deleteLocked = false;
    let statusMessage: string | null = null;
    const failureMessage = (error: unknown, fallback: string) => {
      const response = error as Error & { code?: string };
      return `${response.message || fallback} ${editorFailureGuidance(response.code).message}`;
    };
    const isDirty = () =>
      isWorksEditorDraftDirty(baseline, draft) ||
      JSON.stringify(assetBaseline) !== JSON.stringify(assetDraft);
    const setActionReason = (action: string, reason: string) => {
      const container = document.querySelector<HTMLElement>(
        `[data-action="${action}"]`,
      );
      const hint = container?.querySelector<HTMLElement>(
        "[data-action-reason]",
      );
      const actionButton =
        container?.querySelector<HTMLButtonElement>("button");
      if (hint) hint.textContent = reason;
      if (actionButton) actionButton.title = reason;
    };
    const renderAssets = () => {
      assetList.replaceChildren(
        ...assetDraft.images.map((image, index) => {
          const fieldset = document.createElement("fieldset");
          fieldset.className = "editor-readonly-group";
          fieldset.dataset.assetIndex = String(index);
          const legend = document.createElement("legend");
          legend.textContent = `Image ${index + 1} · ${image.kind === "existing" ? "Canonical · saved" : image.replaced ? "Replacement pending · temporary" : "New image · temporary"}`;
          const thumbnail = document.createElement("img");
          thumbnail.className = "editor-asset-thumbnail";
          thumbnail.src =
            image.kind === "existing"
              ? image.src
              : temporaryWorksAssetPreviewUrl(
                  image.token,
                  assetDraft.contentId,
                  assetDraft.workspaceId,
                );
          thumbnail.alt = image.alt;
          const source = document.createElement("label");
          source.textContent = "Shared · src";
          const sourceInput = document.createElement("input");
          sourceInput.readOnly = true;
          sourceInput.value =
            image.kind === "existing"
              ? image.src
              : image.replaced
                ? `Temporary candidate (replaces ${image.replaced.src} after Save)`
                : "Temporary candidate (canonical URL assigned after Save)";
          source.append(sourceInput);
          const alt = document.createElement("label");
          alt.textContent = "Localized · alt";
          const textarea = document.createElement("textarea");
          textarea.dataset.assetAlt = "";
          textarea.value = image.alt;
          alt.append(textarea);
          const actions = document.createElement("div");
          actions.className = "editor-asset-actions";
          for (const [action, label, disabled] of [
            ["up", "Move up", index === 0],
            ["down", "Move down", index === assetDraft.images.length - 1],
          ] as const) {
            const move = document.createElement("button");
            move.type = "button";
            move.dataset.assetMove = action;
            move.textContent = label;
            move.disabled = disabled;
            actions.append(move);
          }
          if (image.kind === "temporary") {
            const remove = document.createElement("button");
            remove.type = "button";
            remove.dataset.assetRemove = image.token;
            remove.textContent = image.replaced
              ? "Cancel replacement"
              : "Remove temporary image";
            actions.append(remove);
          } else {
            const replace = document.createElement("button");
            replace.type = "button";
            replace.dataset.assetReplace = "";
            replace.textContent = "Replace image";
            actions.append(replace);
          }
          fieldset.append(legend, thumbnail, source, alt, actions);
          return fieldset;
        }),
      );
    };
    const render = () => {
      const dirty = isDirty();
      const validationDraft: WorksEditorDraftState = {
        ...draft,
        data: {
          ...draft.data,
          images: assetDraft.images.map((image) => ({
            src:
              image.kind === "existing"
                ? image.src
                : temporaryWorksAssetPreviewUrl(
                    image.token,
                    assetDraft.contentId,
                    assetDraft.workspaceId,
                  ),
            alt: image.alt,
          })),
        },
      };
      const capabilities =
        validateWorksEditorDraft(validationDraft).capabilities;
      const operationLocked =
        pending !== null || recoveryRequired || deleteLocked;
      button.disabled = operationLocked || !dirty || !capabilities.save;
      previewButton.disabled = operationLocked || !capabilities.preview;
      publishButton.disabled =
        operationLocked || dirty || !capabilities.publish;
      uploadButton.disabled = operationLocked || assetFile.files?.length === 0;
      assetFile.disabled = operationLocked;
      uploadButton.title = recoveryRequired
        ? "Manual recovery is required before uploading can continue"
        : pending
          ? "Another action is in progress"
          : assetFile.files?.length
            ? "Upload selected files as temporary images"
            : "Choose one or more images first";
      const ux = worksWorkspaceUxState({
        collectionName: "Work",
        pending,
        dirty,
        canSave: capabilities.save,
        canPreview: capabilities.preview,
        canPublish: capabilities.publish,
        savedSincePublish,
        recoveryRequired,
        statusMessage,
      });
      setActionReason("save", ux.saveTitle);
      setActionReason("preview", ux.previewTitle);
      setActionReason("publish", ux.publishTitle);
      form
        .querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
          "input, textarea",
        )
        .forEach((control) => {
          if (control === assetFile || assetList.contains(control)) return;
          control.disabled = operationLocked;
        });
      assetList
        .querySelectorAll<
          HTMLInputElement | HTMLTextAreaElement | HTMLButtonElement
        >("input, textarea, button")
        .forEach((control) => {
          if (
            control instanceof HTMLButtonElement &&
            control.dataset.assetMove
          ) {
            const index = Number(
              control.closest<HTMLElement>("[data-asset-index]")?.dataset
                .assetIndex,
            );
            const atEdge =
              control.dataset.assetMove === "up"
                ? index === 0
                : index === assetDraft.images.length - 1;
            control.disabled = operationLocked || atEdge;
          } else control.disabled = operationLocked;
        });
      const validation =
        document.querySelector<HTMLElement>(".editor-validation");
      if (validation) {
        const result = validateWorksEditorDraft(validationDraft);
        const validationStatus =
          validation.querySelector<HTMLElement>(".editor-status");
        const state = result.issues.length === 0 ? "valid" : "blocked";
        if (validationStatus) {
          validationStatus.textContent = state;
          validationStatus.className = `editor-status editor-status--${state}`;
        }
        const label = (allowed: boolean) => (allowed ? "Available" : "Blocked");
        const summary = validation.querySelector<HTMLElement>(
          "[data-issue-summary]",
        );
        if (summary)
          summary.textContent = result.issues.length
            ? `${result.issues.length} draft issues`
            : "No draft issues";
        for (const [name, allowed] of [
          ["save", result.capabilities.save],
          ["preview", result.capabilities.preview],
          ["publish", result.capabilities.publish],
        ] as const) {
          const value = validation.querySelector<HTMLElement>(`[data-${name}]`);
          if (value) value.textContent = label(allowed);
        }
        const issues =
          validation.querySelector<HTMLUListElement>("[data-issues]");
        if (issues) {
          issues.hidden = result.issues.length === 0;
          issues.replaceChildren(
            ...result.issues.map((issue) => {
              const item = document.createElement("li");
              const severity = document.createElement("strong");
              const field = document.createElement("span");
              const message = document.createElement("small");
              severity.textContent = issue.severity;
              field.textContent = issue.fieldPath ?? "Source";
              message.textContent = issue.messageKey;
              item.append(severity, " ", field, message);
              return item;
            }),
          );
        }
      }
      if (status) {
        status.textContent = ux.status;
        status.dataset.state = pending ? "pending" : dirty ? "dirty" : "saved";
      }
      window.dispatchEvent(
        new CustomEvent("editor:workspace-state", {
          detail: {
            locked: operationLocked || dirty,
            pendingAssetState: assetDraft.images.some(
              (image) => image.kind === "temporary",
            ),
            unpublishedAssetCount: publishManifest?.assets.length ?? 0,
          },
        }),
      );
    };
    form.addEventListener("input", (event) => {
      const field = event.target as HTMLInputElement | HTMLTextAreaElement;
      draft = updateWorksEditorDraft(draft, (next) => {
        const [key, index] = field.name.split(".");
        if (key === "body") next.body = field.value;
        else if (key === "artist") next.data.artist.id = field.value;
        else if (key === "images") return;
        else if (key === "year")
          next.data.year = field.value ? Number(field.value) : undefined;
        else if (key === "inquiry" && index === "type")
          next.data.inquiry =
            field.value === "none"
              ? { type: "none" }
              : field.value === "shop"
                ? { type: "shop", url: "" }
                : { type: "inquiry" };
        else if (key === "inquiry" && next.data.inquiry.type !== "none")
          next.data.inquiry = {
            ...next.data.inquiry,
            url: field.value || undefined,
          } as typeof next.data.inquiry;
        else if (key === "title") next.data.title = field.value;
        else Object.assign(next.data, { [key]: field.value || undefined });
      });
      statusMessage = null;
      render();
    });
    assetFile.addEventListener("change", render);
    uploadButton.addEventListener("click", async () => {
      const files = [...(assetFile.files ?? [])];
      if (pending || files.length === 0) return;
      pending = "upload";
      if (assetStatus)
        assetStatus.textContent = `Uploading ${files.length} image${files.length === 1 ? "" : "s"}…`;
      render();
      let uploaded = 0;
      try {
        for (const file of files) {
          const body = new FormData();
          body.set("workspaceId", assetDraft.workspaceId);
          body.set("file", file);
          const response = await fetch(
            `/editor/api/works-assets/upload/${encodeURIComponent(draft.contentId)}`,
            { method: "POST", body },
          );
          const result = (await response.json()) as {
            asset?: { token: string; originalFilename: string };
            error?: string;
            code?: string;
          };
          if (!response.ok || !result.asset) {
            const failure = new Error(
              result.error ?? `Upload failed for ${file.name}`,
            ) as Error & { code?: string };
            failure.code = result.code;
            throw failure;
          }
          assetDraft = addTemporaryWorksAsset(assetDraft, {
            token: result.asset.token,
            alt: file.name.replace(/\.[^.]+$/, "").replaceAll("-", " "),
          });
          uploaded += 1;
        }
        assetFile.value = "";
        if (assetStatus)
          assetStatus.textContent = `${uploaded} temporary image${uploaded === 1 ? "" : "s"} added. Save to make permanent.`;
        statusMessage = "Unsaved asset changes";
      } catch (error) {
        if (assetStatus)
          assetStatus.textContent = `${failureMessage(error, "Works asset upload failed")} ${uploaded ? `${uploaded} image${uploaded === 1 ? " was" : "s were"} added before the failure.` : ""}`;
      } finally {
        pending = null;
        renderAssets();
        render();
      }
    });
    assetList.addEventListener("input", (event) => {
      const field = event.target as HTMLTextAreaElement;
      if (!field.matches("[data-asset-alt]")) return;
      const index = Number(
        field.closest<HTMLElement>("[data-asset-index]")?.dataset.assetIndex,
      );
      assetDraft = updateWorksAssetDraftAlt(assetDraft, index, field.value);
      statusMessage = null;
      render();
    });
    assetList.addEventListener("click", (event) => {
      const target = event.target as HTMLButtonElement;
      if (pending) return;
      const container = target.closest<HTMLElement>("[data-asset-index]");
      if (!container) return;
      const index = Number(container.dataset.assetIndex);
      if (target.dataset.assetReplace !== undefined) {
        const picker = document.createElement("input");
        picker.type = "file";
        picker.accept = "image/avif,image/jpeg,image/png,image/webp";
        picker.addEventListener("change", async () => {
          const file = picker.files?.[0];
          if (!file || pending) return;
          pending = "upload";
          if (assetStatus)
            assetStatus.textContent = `Uploading replacement for image ${index + 1}…`;
          render();
          try {
            const body = new FormData();
            body.set("workspaceId", assetDraft.workspaceId);
            body.set("file", file);
            const response = await fetch(
              `/editor/api/works-assets/upload/${encodeURIComponent(draft.contentId)}`,
              { method: "POST", body },
            );
            const result = (await response.json()) as {
              asset?: { token: string };
              error?: string;
              code?: string;
            };
            if (!response.ok || !result.asset) {
              const failure = new Error(
                result.error ?? `Upload failed for ${file.name}`,
              ) as Error & { code?: string };
              failure.code = result.code;
              throw failure;
            }
            assetDraft = replaceExistingWorksAsset(assetDraft, index, {
              token: result.asset.token,
            });
            statusMessage = "Unsaved asset replacement";
            if (assetStatus)
              assetStatus.textContent = `Image ${index + 1} replacement is temporary. Save to make permanent.`;
          } catch (error) {
            if (assetStatus)
              assetStatus.textContent = failureMessage(
                error,
                "Works asset replacement failed",
              );
          } finally {
            pending = null;
            renderAssets();
            render();
          }
        });
        picker.click();
        return;
      }
      if (target.dataset.assetMove) {
        const to = target.dataset.assetMove === "up" ? index - 1 : index + 1;
        assetDraft = reorderWorksAssetDraftImage(assetDraft, index, to);
      } else if (target.dataset.assetRemove) {
        // Keep removed bytes until TTL expiry so an accidental removal does not
        // destroy retry/undo data. Save only materializes referenced tokens.
        assetDraft = removeTemporaryWorksAssetFromDraft(
          assetDraft,
          target.dataset.assetRemove,
        );
        if (assetStatus)
          assetStatus.textContent =
            "Temporary image removed and any replaced reference restored.";
      } else return;
      statusMessage = null;
      renderAssets();
      render();
    });
    previewButton.addEventListener("click", async () => {
      if (previewButton.disabled) return;
      const previewWindow = window.open("", "_blank");
      pending = "preview";
      render();
      try {
        const response = await fetch("/editor/api/works-preview/create", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ draft, assetDraft }),
        });
        const result = (await response.json()) as {
          url?: string;
          error?: string;
          code?: string;
        };
        if (!response.ok || !result.url) {
          const failure = new Error(
            result.error ?? "Works preview failed",
          ) as Error & { code?: string };
          failure.code = result.code;
          throw failure;
        }
        if (previewWindow) previewWindow.location.href = result.url;
        else window.open(result.url, "_blank");
      } catch (error) {
        previewWindow?.close();
        statusMessage = failureMessage(error, "Works preview failed");
      } finally {
        pending = null;
        render();
      }
    });
    button.addEventListener("click", async () => {
      if (button.disabled) return;
      pending = "save";
      render();
      try {
        const response = await fetch(
          `/editor/api/works/${encodeURIComponent(draft.contentId)}`,
          {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ draft, baseline, assetDraft }),
          },
        );
        const result = (await response.json()) as {
          draft?: WorksEditorDraftState;
          assetDraft?: WorksAssetDraftState;
          publishManifest?: WorksAssetPublishManifest;
          error?: string;
          code?: string;
        };
        if (!response.ok || !result.draft) {
          const failure = new Error(
            result.error ?? "Works save failed",
          ) as Error & { code?: string };
          failure.code = result.code;
          throw failure;
        }
        baseline = result.draft;
        draft = result.draft;
        if (result.publishManifest) {
          const assets = new Map(
            publishManifest?.assets.map((asset) => [asset.src, asset]) ?? [],
          );
          for (const asset of result.publishManifest.assets)
            assets.set(asset.src, asset);
          publishManifest = {
            ...result.publishManifest,
            assets: [...assets.values()],
          };
        }
        if (result.assetDraft) {
          assetDraft = result.assetDraft;
          assetBaseline = structuredClone(result.assetDraft);
          renderAssets();
        }
        statusMessage = "Saved · unpublished changes ready to publish";
        savedSincePublish = true;
      } catch (error) {
        if (
          isEditorManualRecoveryFailure(
            (error as Error & { code?: string }).code,
          )
        )
          recoveryRequired = true;
        statusMessage = failureMessage(error, "Works save failed");
      } finally {
        pending = null;
        render();
      }
    });
    publishButton.addEventListener("click", async () => {
      const dirty = isDirty();
      if (
        pending ||
        dirty ||
        !validateWorksEditorDraft({
          ...draft,
          data: {
            ...draft.data,
            images: assetDraft.images.map((image) => ({
              src: image.kind === "existing" ? image.src : "",
              alt: image.alt,
            })),
          },
        }).capabilities.publish
      )
        return;
      pending = "publish";
      render();
      try {
        const response = await fetch(
          `/editor/api/works-publish/${encodeURIComponent(draft.contentId)}`,
          {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              draft,
              baseline,
              dirty,
              publishManifest,
              renameEvidence,
            }),
          },
        );
        const result = (await response.json()) as {
          state?: "published" | "committed-push-failed";
          commit?: string;
          error?: string;
          code?: string;
        };
        if (!response.ok || !result.state) {
          const failure = new Error(
            result.error ?? "Works publish failed",
          ) as Error & {
            code?: string;
          };
          failure.code = result.code;
          throw failure;
        }
        statusMessage =
          result.state === "published"
            ? `Published ${result.commit?.slice(0, 7) ?? "commit"}`
            : `Committed ${result.commit?.slice(0, 7) ?? "commit"}; push failed. Retry push outside the Editor.`;
        publishManifest = undefined;
        renameEvidence = undefined;
        savedSincePublish = false;
      } catch (error) {
        statusMessage = failureMessage(error, "Works publish failed");
      } finally {
        pending = null;
        render();
      }
    });
    window.addEventListener("editor:rename-complete", (event) => {
      const detail = event as CustomEvent<{
        draft?: WorksEditorDraftState;
        renameEvidence?: WorksRenamePublishEvidence;
      }>;
      const renamed = detail.detail.draft;
      if (!renamed) return;
      baseline = renamed;
      draft = structuredClone(renamed);
      assetDraft = {
        contentId: renamed.contentId,
        workspaceId: crypto.randomUUID(),
        images: renamed.data.images.map((image) => ({
          kind: "existing" as const,
          ...image,
        })),
      };
      assetBaseline = structuredClone(assetDraft);
      publishManifest = undefined;
      renameEvidence = detail.detail.renameEvidence;
      savedSincePublish = true;
      statusMessage =
        "Renamed · references updated · assets unchanged · unpublished changes ready to publish";
      renderAssets();
      render();
    });
    window.addEventListener("editor:delete-state", (event) => {
      deleteLocked = Boolean(
        (event as CustomEvent<{ locked?: boolean }>).detail?.locked,
      );
      statusMessage = deleteLocked
        ? "Works Delete operation in progress"
        : null;
      render();
    });
    window.addEventListener("beforeunload", (event) => {
      if (isDirty()) {
        event.preventDefault();
        (event as unknown as { returnValue: string }).returnValue = "";
      }
    });
    document.addEventListener("keydown", (event) => {
      if (!isEditorSaveShortcut(event)) return;
      event.preventDefault();
      button.click();
    });
    renderAssets();
    render();
  }
</script>
