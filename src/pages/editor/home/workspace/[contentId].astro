---
import ActionBar from "../../../../components/editor/ActionBar.astro";
import HomeDraftForm from "../../../../components/editor/HomeDraftForm.astro";
import HomeValidationPanel from "../../../../components/editor/HomeValidationPanel.astro";
import { createHomeEditorDraft } from "../../../../editor/home-draft-state";
import { readHomeEditorEntry } from "../../../../editor/home-state";
import EditorLayout from "../../../../layouts/EditorLayout.astro";
export async function getStaticPaths() {
  return [
    {
      params: { contentId: "home" },
      props: { entry: await readHomeEditorEntry() },
    },
  ];
}
const { entry } = Astro.props;
const draft = createHomeEditorDraft(entry);
const serializedDraft = JSON.stringify(draft).replaceAll("<", "\\u003c");
---

<EditorLayout title="Home" section="Home"
  ><header class="editor-page-heading">
    <p class="editor-eyebrow">Home workspace</p><h1>Home</h1><p>
      Singleton · canonical home.md · canonical section images
    </p>
  </header><div class="editor-workspace">
    <main class="editor-panel editor-canvas">
      {
        draft ? (
          <HomeDraftForm draft={draft} />
        ) : (
          <p>
            Source cannot be represented as a Draft until validation issues are
            fixed.
          </p>
        )
      }
    </main><HomeValidationPanel entry={entry} />
  </div><ActionBar
    mode="home"
    loaded={Boolean(draft)}
    preview={false}
  /></EditorLayout
>
<script
  type="application/json"
  is:inline
  id="home-editor-draft"
  set:html={serializedDraft}
/>
<script>
  import {
    isHomeEditorDraftDirty,
    validateHomeEditorDraft,
    type HomeEditorDraftState,
  } from "../../../../editor/home-draft-state";
  import {
    editorFailureGuidance,
    isEditorSaveShortcut,
    renderFlatValidationPanel,
    worksWorkspaceUxState,
  } from "../../../../editor/ux";
  const raw =
    document.querySelector<HTMLScriptElement>(
      "#home-editor-draft",
    )?.textContent;
  const form = document.querySelector<HTMLFormElement>(
    "[data-home-draft-form]",
  );
  const save = document.querySelector<HTMLButtonElement>("[data-save-home]");
  const preview = document.querySelector<HTMLButtonElement>(
    "[data-preview-home]",
  );
  const publish = document.querySelector<HTMLButtonElement>(
    "[data-publish-home]",
  );
  const status = document.querySelector<HTMLElement>(
    "[data-home-action-status]",
  );
  if (raw && form && save && preview && publish && status) {
    let baseline = JSON.parse(raw) as HomeEditorDraftState;
    let draft = structuredClone(baseline);
    let pending: "save" | "preview" | "publish" | null = null;
    let savedSincePublish = false;
    let statusMessage: string | null = null;
    let terminal = false;
    const setActionReason = (action: string, reason: string) => {
      const container = document.querySelector<HTMLElement>(
        '[data-action="' + action + '"]',
      );
      const hint = container?.querySelector<HTMLElement>(
        "[data-action-reason]",
      );
      const actionButton =
        container?.querySelector<HTMLButtonElement>("button");
      if (hint) hint.textContent = reason;
      if (actionButton) actionButton.title = reason;
    };
    const optional = (value: string) => value.trim() || undefined;
    const read = () => {
      const data = new FormData(form);
      const value = (name: string) => String(data.get(name) ?? "");
      const heroType = value("hero_type") as "image" | "video";
      const media =
        heroType === "image"
          ? { type: "image" as const, image: optional(value("hero_image")) }
          : {
              type: "video" as const,
              video: optional(value("hero_video")),
              poster: optional(value("hero_poster")),
            };
      const layout = optional(value("hero_layout"));
      const home_hero =
        data.get("hero_enabled") === "on"
          ? {
              media,
              ...(layout
                ? { layout: layout as "default" | "portrait" | "alternate" }
                : {}),
            }
          : undefined;
      draft = {
        ...draft,
        data: {
          ...(optional(value("title"))
            ? { title: optional(value("title")) }
            : {}),
          ...(optional(value("description"))
            ? { description: optional(value("description")) }
            : {}),
          ...(home_hero ? { home_hero } : {}),
          sections: [0, 1].map((index) => ({
            id: value(`section_${index}_id`) as "artists" | "about",
            title: value(`section_${index}_title`),
            href: value(`section_${index}_href`),
            image: {
              src: value(`section_${index}_image`),
            },
          })),
        },
      };
    };
    const render = () => {
      const dirty = isHomeEditorDraftDirty(baseline, draft);
      const validation = validateHomeEditorDraft(draft);
      const capabilities = validation.capabilities;
      renderFlatValidationPanel(form, validation);
      const locked = pending !== null || terminal;
      save.disabled = locked || !dirty || !capabilities.save;
      preview.disabled = locked || !capabilities.preview;
      publish.disabled = locked || dirty || !capabilities.publish;
      form
        .querySelectorAll<
          HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement
        >("input, textarea, select")
        .forEach((control) => (control.disabled = locked));
      const ux = worksWorkspaceUxState({
        collectionName: "Home",
        pending,
        dirty,
        canSave: capabilities.save,
        canPreview: capabilities.preview,
        canPublish: capabilities.publish,
        savedSincePublish,
        recoveryRequired: terminal,
        statusMessage,
      });
      status.textContent = terminal
        ? (statusMessage ?? "Manual recovery required")
        : ux.status;
      status.dataset.state = pending ? "pending" : dirty ? "dirty" : "saved";
      setActionReason("save", ux.saveTitle);
      setActionReason("preview", ux.previewTitle);
      setActionReason("publish", ux.publishTitle);
    };
    const request = async (url: string, body: unknown) => {
      const response = await fetch(url, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(body),
      });
      const result = await response.json();
      if (!response.ok)
        throw Object.assign(new Error(result.error), { code: result.code });
      return result;
    };
    form.addEventListener("input", () => {
      read();
      statusMessage = null;
      render();
    });
    save.addEventListener("click", async () => {
      pending = "save";
      render();
      try {
        const result = await request("/editor/api/home", { draft, baseline });
        baseline = result.draft;
        draft = structuredClone(baseline);
        savedSincePublish = true;
        statusMessage = "Saved · unpublished changes ready to publish";
      } catch (error) {
        const value = error as Error & { code?: string };
        statusMessage = `${value.message} ${editorFailureGuidance(value.code).message}`;
      } finally {
        pending = null;
        render();
      }
    });
    preview.addEventListener("click", async () => {
      pending = "preview";
      render();
      try {
        const result = await request("/editor/api/home-preview/create", {
          draft,
        });
        window.open(result.url, "_blank", "noopener,noreferrer");
        statusMessage = "Draft preview opened";
      } catch (error) {
        const value = error as Error & { code?: string };
        statusMessage = `${value.message} ${editorFailureGuidance(value.code).message}`;
      } finally {
        pending = null;
        render();
      }
    });
    publish.addEventListener("click", async () => {
      pending = "publish";
      render();
      try {
        const result = await request("/editor/api/home-publish", {
          draft,
          baseline,
          dirty: isHomeEditorDraftDirty(baseline, draft),
        });
        terminal = result.state === "committed-push-failed";
        savedSincePublish = terminal;
        statusMessage =
          result.state === "published"
            ? `Published · ${result.commit.slice(0, 7)}`
            : `Committed · push failed · manual recovery required · ${result.error}`;
      } catch (error) {
        const value = error as Error & { code?: string };
        statusMessage = `${value.message} ${editorFailureGuidance(value.code).message}`;
      } finally {
        pending = null;
        render();
      }
    });
    document.addEventListener("keydown", (event) => {
      if (isEditorSaveShortcut(event) && !save.disabled) {
        event.preventDefault();
        save.click();
      }
    });
    render();
  }
</script>
