---
import ActionBar from "../../../../components/editor/ActionBar.astro";
import HomeDraftForm from "../../../../components/editor/HomeDraftForm.astro";
import { createHomeEditorDraft } from "../../../../editor/home-draft-state.ts";
import { readHomeEditorEntry } from "../../../../editor/home-state.ts";
import EditorLayout from "../../../../layouts/EditorLayout.astro";
export async function getStaticPaths() {
  return [
    {
      params: { contentId: "home" },
      props: { entry: await readHomeEditorEntry() },
    },
  ];
}
const { entry } = Astro.props;
const draft = createHomeEditorDraft(entry);
const serialized = JSON.stringify(draft).replaceAll("<", "\\u003c");
---

<EditorLayout title="Home" section="Home">
  <header class="editor-page-heading">
    <p class="editor-eyebrow">Home workspace</p><h1>Home</h1><p>
      Singleton · Shared + JA + EN · exact three-file Save/Publish
    </p>
  </header>
  <div class="editor-workspace">
    <main class="editor-panel editor-canvas">
      <HomeDraftForm draft={draft} />
    </main>
    <aside class="editor-panel">
      <h2>Capability</h2><dl>
        <dt>JA Preview</dt><dd data-home-capability="ja-preview">
          Available (temporary allowed)
        </dd><dt>JA formal</dt><dd data-home-capability="ja-formal">
          Temporary copy pending
        </dd><dt>EN Preview</dt><dd data-home-capability="en-preview">
          Blocked by placeholder
        </dd><dt>EN Production</dt><dd>
          Blocked: copy, /en/about/, and route projection
        </dd>
      </dl><p>Home has no Create, Rename, or Delete lifecycle.</p>
    </aside>
  </div>
  <ActionBar
    mode="home"
    loaded={true}
    preview={entry.capabilities.preview}
    save={true}
    publish={true}
  />
</EditorLayout>
<script
  type="application/json"
  is:inline
  id="home-editor-draft"
  set:html={serialized}
/>
<script>
  import {
    homeDirtyScopes,
    isHomeEditorDraftDirty,
    validateHomeEditorDraft,
    type HomeEditorDraftState,
  } from "../../../../editor/home-draft-state.ts";
  const raw =
    document.querySelector<HTMLScriptElement>(
      "#home-editor-draft",
    )?.textContent;
  const form = document.querySelector<HTMLFormElement>(
    "[data-home-draft-form]",
  );
  const save = document.querySelector<HTMLButtonElement>("[data-save-home]");
  const publish = document.querySelector<HTMLButtonElement>(
    "[data-publish-home]",
  );
  const previewJa = document.querySelector<HTMLButtonElement>(
    '[data-preview-home="ja"]',
  );
  const previewEn = document.querySelector<HTMLButtonElement>(
    '[data-preview-home="en"]',
  );
  const status = document.querySelector<HTMLElement>(
    "[data-home-action-status]",
  );
  if (raw && form && save && publish && previewJa && previewEn && status) {
    let baseline = JSON.parse(raw) as HomeEditorDraftState;
    let draft = structuredClone(baseline);
    const optional = (v: FormDataEntryValue | null) =>
      String(v ?? "").trim() || undefined;
    const read = () => {
      const data = new FormData(form);
      const heroType = String(data.get("hero_type"));
      if (draft.shared.state === "editable") {
        draft.shared.value = {
          ...(heroType === "image"
            ? {
                home_hero: {
                  media: {
                    type: "image",
                    image: String(data.get("hero_image")),
                  },
                },
              }
            : heroType === "video"
              ? {
                  home_hero: {
                    media: {
                      type: "video",
                      video: String(data.get("hero_video")),
                      ...(optional(data.get("hero_poster"))
                        ? { poster: optional(data.get("hero_poster")) }
                        : {}),
                    },
                  },
                }
              : {}),
          sections: {
            artists: {
              destination: "artists",
              image: {
                src: String(
                  data.get("artists_image"),
                ) as "/images/home/artists-square.jpg",
              },
            },
            about: {
              destination: "about",
              image: {
                src: String(
                  data.get("about_image"),
                ) as "/images/home/about-landscape.jpg",
              },
            },
          },
        };
      }
      for (const locale of ["ja", "en"] as const)
        if (draft.locales[locale].state === "editable") {
          draft.locales[locale].value = {
            about_intro: String(data.get(`${locale}_about_intro`)),
            ...(optional(data.get(`${locale}_seo_title`))
              ? { seo_title: optional(data.get(`${locale}_seo_title`)) }
              : {}),
            ...(optional(data.get(`${locale}_description`))
              ? { description: optional(data.get(`${locale}_description`)) }
              : {}),
          };
          if (locale === "ja")
            draft.copyStatus.ja =
              data.get("ja_copy_approved") === "on" ? "approved" : "temporary";
          else
            draft.copyStatus.en =
              data.get("en_copy_approved") === "on"
                ? "approved"
                : "placeholder";
        }
    };
    const render = () => {
      read();
      const validation = validateHomeEditorDraft(draft);
      const dirty = isHomeEditorDraftDirty(baseline, draft);
      const scopes = homeDirtyScopes(baseline, draft);
      save.disabled = !dirty || !validation.capabilities.save;
      publish.disabled = dirty || !validation.capabilities.publish;
      previewJa.disabled = !validation.capabilities.preview.ja;
      previewEn.disabled = !validation.capabilities.preview.en;
      status.textContent = dirty
        ? `Unsaved: ${Object.entries(scopes)
            .filter(([, v]) => v)
            .map(([k]) => k.toUpperCase())
            .join(", ")}`
        : "Saved · ready";
    };
    form.addEventListener("input", render);
    form.addEventListener("change", render);
    const preview = async (locale: "ja" | "en") => {
      read();
      const response = await fetch("/editor/api/home-preview/create", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ draft, locale }),
      });
      const result = await response.json();
      if (!response.ok) {
        status.textContent = result.error;
        return;
      }
      window.open(result.url, "_blank", "noopener");
    };
    previewJa.addEventListener("click", () => void preview("ja"));
    previewEn.addEventListener("click", () => void preview("en"));
    save.addEventListener("click", async () => {
      read();
      const response = await fetch("/editor/api/home", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ draft, baseline }),
      });
      const result = await response.json();
      if (!response.ok) {
        status.textContent = result.error;
        return;
      }
      baseline = result.draft;
      draft = structuredClone(baseline);
      render();
    });
    publish.addEventListener("click", async () => {
      read();
      const response = await fetch("/editor/api/home-publish", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          draft,
          baseline,
          dirty: isHomeEditorDraftDirty(baseline, draft),
        }),
      });
      const result = await response.json();
      status.textContent = response.ok
        ? `Published ${result.commit}`
        : result.error;
    });
    render();
  }
</script>
