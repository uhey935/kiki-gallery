---
import ActionBar from "../../../../components/editor/ActionBar.astro";
import ExhibitionsDraftForm from "../../../../components/editor/ExhibitionsDraftForm.astro";
import ExhibitionsValidationPanel from "../../../../components/editor/ExhibitionsValidationPanel.astro";
import RenamePanel from "../../../../components/editor/RenamePanel.astro";
import ExhibitionsDeletePanel from "../../../../components/editor/ExhibitionsDeletePanel.astro";
import {
  createExhibitionsEditorDraft,
  validateExhibitionsEditorDraft,
} from "../../../../editor/exhibitions-draft-state";
import {
  readExhibitionsEditorEntry,
  readExhibitionsEditorState,
} from "../../../../editor/exhibitions-state";
import EditorLayout from "../../../../layouts/EditorLayout.astro";
export async function getStaticPaths() {
  const state = await readExhibitionsEditorState();
  return Promise.all(
    state.entries.map(async ({ contentId }) => ({
      params: { contentId },
      props: { entry: await readExhibitionsEditorEntry(contentId) },
    })),
  );
}
const { entry } = Astro.props;
const draft = createExhibitionsEditorDraft(entry);
const initialCapabilities = validateExhibitionsEditorDraft(draft).capabilities;
const serializedDraft = JSON.stringify(draft).replaceAll("<", "\\u003c");
---

<EditorLayout
  title={entry.locales.ja.state === "valid"
    ? entry.locales.ja.value.title
    : entry.contentId}
  section="Exhibitions"
>
  <header class="editor-page-heading">
    <p class="editor-eyebrow">Exhibitions workspace</p><h1>
      {
        entry.locales.ja.state === "valid"
          ? entry.locales.ja.value.title
          : entry.contentId
      }
    </h1><p>
      <span data-workspace-content-id>{entry.contentId}</span> · Three-file Content
      Unit
    </p>
  </header>
  <div class="editor-workspace">
    <main class="editor-panel editor-canvas">
      {
        draft ? (
          <ExhibitionsDraftForm draft={draft} />
        ) : (
          <p>
            Source cannot be represented as a Draft until validation issues are
            fixed.
          </p>
        )
      }
    </main><aside class="editor-workspace__sidebar">
      <ExhibitionsValidationPanel entry={entry} />
      <RenamePanel collection="exhibitions" contentId={entry.contentId} />
    </aside>
  </div>
  <ExhibitionsDeletePanel contentId={entry.contentId} />
  <ActionBar
    mode="exhibitions"
    loaded={Boolean(draft)}
    preview={initialCapabilities.preview}
  />
</EditorLayout>
<script
  type="application/json"
  is:inline
  id="exhibitions-editor-draft"
  set:html={serializedDraft}
/>
<script>
  import {
    isExhibitionsEditorDraftDirty,
    validateExhibitionsEditorDraft,
    type ExhibitionsEditorDraftState,
  } from "../../../../editor/exhibitions-draft-state";
  import {
    editorFailureGuidance,
    isEditorSaveShortcut,
    renderFlatValidationPanel,
    worksWorkspaceUxState,
  } from "../../../../editor/ux";
  const raw = document.querySelector<HTMLScriptElement>(
    "#exhibitions-editor-draft",
  )?.textContent;
  const form = document.querySelector<HTMLFormElement>(
    "[data-exhibitions-draft-form]",
  );
  const save = document.querySelector<HTMLButtonElement>(
    "[data-save-exhibitions]",
  );
  const previews = [
    ...document.querySelectorAll<HTMLButtonElement>(
      "[data-preview-exhibitions]",
    ),
  ];
  const publish = document.querySelector<HTMLButtonElement>(
    "[data-publish-exhibitions]",
  );
  const status = document.querySelector<HTMLElement>(
    "[data-exhibitions-action-status]",
  );
  if (raw && form && save && previews.length === 2 && publish && status) {
    let baseline = JSON.parse(raw) as ExhibitionsEditorDraftState;
    let draft = structuredClone(baseline);
    let pending: "save" | "preview" | "publish" | null = null;
    let savedSincePublish = false;
    let statusMessage: string | null = null;
    let recoveryRequired = false;
    let deleteLocked = false;
    const setActionReason = (action: string, reason: string) => {
      const container = document.querySelector<HTMLElement>(
        '[data-action="' + action + '"]',
      );
      const hint = container?.querySelector<HTMLElement>(
        "[data-action-reason]",
      );
      const actionButton =
        container?.querySelector<HTMLButtonElement>("button");
      if (hint) hint.textContent = reason;
      if (actionButton) actionButton.title = reason;
    };
    const optional = (value: string) => value.trim() || undefined;
    const list = (value: string) =>
      value
        .split("\n")
        .map((id) => id.trim())
        .filter(Boolean);
    const read = () => {
      const data = new FormData(form);
      const value = (name: string) => String(data.get(name) ?? "");
      const display = value("shared.display_artists");
      const localized = (locale: "ja" | "en") => ({
        state: "editable" as const,
        value: {
          title: value(`${locale}.title`),
          hero_alt: value(`${locale}.hero_alt`),
          body: value(`${locale}.body`),
          summary: optional(value(`${locale}.summary`)),
          venue: optional(value(`${locale}.venue`)),
          opening_hours: optional(value(`${locale}.opening_hours`)),
          closed_days: optional(value(`${locale}.closed_days`)),
          attendance: optional(value(`${locale}.attendance`)),
          hero_caption: optional(value(`${locale}.hero_caption`)),
          seo_title: optional(value(`${locale}.seo_title`)),
          description: optional(value(`${locale}.description`)),
        },
      });
      draft = {
        ...draft,
        shared: {
          state: "editable",
          value: {
            artists: list(value("shared.artists")),
            works: list(value("shared.works")),
            start_date: value("shared.start_date"),
            end_date: value("shared.end_date"),
            display_artists:
              display === "default" ? undefined : display === "true",
            hero: {
              image: value("shared.hero.image"),
              orientation: value("shared.hero.orientation") as
                "portrait" | "landscape",
              position: optional(value("shared.hero.position")) as never,
              treatment: optional(value("shared.hero.treatment")) as never,
            },
          },
        },
        locales: { ja: localized("ja"), en: localized("en") },
      };
    };
    const render = () => {
      const dirty = isExhibitionsEditorDraftDirty(baseline, draft);
      const validation = validateExhibitionsEditorDraft(draft);
      const capabilities = validation.capabilities;
      renderFlatValidationPanel(form, {
        ...validation,
        issues: validation.issues as never,
        capabilities: {
          ...validation.capabilities,
          preview:
            validation.capabilities.preview.ja ||
            validation.capabilities.preview.en,
        },
      });
      const locked = pending !== null || recoveryRequired || deleteLocked;
      save.disabled = locked || !dirty || !capabilities.save;
      for (const preview of previews) {
        const locale = preview.dataset.previewExhibitions as "ja" | "en";
        preview.disabled = locked || !capabilities.preview[locale];
        const reason = capabilities.preview[locale]
          ? dirty
            ? `Preview current unsaved ${locale.toUpperCase()} draft`
            : `Preview current ${locale.toUpperCase()} draft`
          : `${locale.toUpperCase()} Preview is blocked by draft validation`;
        preview.title = reason;
        const hint = preview.parentElement?.querySelector<HTMLElement>(
          "[data-action-reason]",
        );
        if (hint) hint.textContent = reason;
      }
      publish.disabled = locked || dirty || !capabilities.publish;
      form
        .querySelectorAll<
          HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement
        >("input, textarea, select")
        .forEach((control) => (control.disabled = locked));
      const ux = worksWorkspaceUxState({
        collectionName: "Exhibition",
        pending,
        dirty,
        ...{
          canSave: capabilities.save,
          canPreview: capabilities.preview.ja || capabilities.preview.en,
          canPublish: capabilities.publish,
        },
        savedSincePublish,
        recoveryRequired,
        statusMessage,
      });
      status.textContent = ux.status;
      status.dataset.state = pending ? "pending" : dirty ? "dirty" : "saved";
      setActionReason("save", ux.saveTitle);
      setActionReason("publish", ux.publishTitle);
      window.dispatchEvent(
        new CustomEvent("editor:workspace-state", {
          detail: { locked: locked || dirty },
        }),
      );
    };
    const request = async (url: string, body: unknown) => {
      const response = await fetch(url, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(body),
      });
      const result = await response.json();
      if (!response.ok)
        throw Object.assign(new Error(result.error), { code: result.code });
      return result;
    };
    form.addEventListener("input", () => {
      read();
      statusMessage = null;
      render();
    });
    save.addEventListener("click", async () => {
      pending = "save";
      render();
      try {
        const result = await request(
          `/editor/api/exhibitions/${encodeURIComponent(draft.contentId)}`,
          { draft, baseline },
        );
        baseline = result.draft;
        draft = structuredClone(baseline);
        savedSincePublish = true;
        statusMessage = "Saved · unpublished changes ready to publish";
      } catch (error) {
        const value = error as Error & { code?: string };
        statusMessage = `${value.message} ${editorFailureGuidance(value.code).message}`;
      } finally {
        pending = null;
        render();
      }
    });
    for (const preview of previews)
      preview.addEventListener("click", async () => {
        const locale = preview.dataset.previewExhibitions as "ja" | "en";
        pending = "preview";
        render();
        try {
          const result = await request(
            "/editor/api/exhibitions-preview/create",
            { draft, locale },
          );
          window.open(result.url, "_blank", "noopener,noreferrer");
          statusMessage = `${locale.toUpperCase()} draft preview opened`;
        } catch (error) {
          const value = error as Error & { code?: string };
          statusMessage = `${value.message} ${editorFailureGuidance(value.code).message}`;
        } finally {
          pending = null;
          render();
        }
      });
    publish.addEventListener("click", async () => {
      pending = "publish";
      render();
      try {
        const result = await request(
          `/editor/api/exhibitions-publish/${encodeURIComponent(draft.contentId)}`,
          {
            draft,
            baseline,
            dirty: isExhibitionsEditorDraftDirty(baseline, draft),
          },
        );
        recoveryRequired = result.state === "committed-push-failed";
        savedSincePublish = recoveryRequired;
        statusMessage =
          result.state === "published"
            ? `Published · ${result.commit.slice(0, 7)}`
            : `Committed · push failed · manual recovery required · ${result.error}`;
      } catch (error) {
        const value = error as Error & { code?: string };
        statusMessage = `${value.message} ${editorFailureGuidance(value.code).message}`;
      } finally {
        pending = null;
        render();
      }
    });
    window.addEventListener("editor:rename-complete", (event) => {
      const renamed = (
        event as CustomEvent<{ draft?: ExhibitionsEditorDraftState }>
      ).detail.draft;
      if (!renamed) return;
      baseline = renamed;
      draft = structuredClone(renamed);
      savedSincePublish = true;
      statusMessage =
        "Renamed · references updated · unpublished changes ready to publish";
      const identity = document.querySelector<HTMLElement>(
        "[data-workspace-content-id]",
      );
      if (identity) identity.textContent = renamed.contentId;
      render();
    });
    window.addEventListener("editor:delete-state", (event) => {
      deleteLocked = Boolean(
        (event as CustomEvent<{ locked?: boolean }>).detail?.locked,
      );
      statusMessage = deleteLocked
        ? "Exhibitions Delete operation in progress"
        : null;
      render();
    });
    document.addEventListener("keydown", (event) => {
      if (isEditorSaveShortcut(event) && !save.disabled) {
        event.preventDefault();
        save.click();
      }
    });
    read();
    baseline = structuredClone(draft);
    render();
  }
</script>
