---
import ActionBar from "../../../../components/editor/ActionBar.astro";
import EntryDraftForm from "../../../../components/editor/EntryDraftForm.astro";
import ValidationPanel from "../../../../components/editor/ValidationPanel.astro";
import { createJournalEditorDraft } from "../../../../editor/journal-draft-state";
import {
  readJournalEditorEntry,
  readJournalEditorState,
} from "../../../../editor/journal-state";
import EditorLayout from "../../../../layouts/EditorLayout.astro";

export async function getStaticPaths() {
  const state = await readJournalEditorState();
  return Promise.all(
    state.entries.map(async ({ contentId }) => ({
      params: { contentId },
      props: { entry: await readJournalEditorEntry(contentId) },
    })),
  );
}

const { entry } = Astro.props;
const draft = createJournalEditorDraft(entry);
const serializedDraft = JSON.stringify(draft).replaceAll("<", "\\u003c");
---

<EditorLayout title={entry.title} section="Journal">
  <header class="editor-page-heading">
    <p class="editor-eyebrow">Journal workspace</p>
    <h1>{entry.title}</h1>
    <p>{entry.contentId} · Canonical three-file editor</p>
  </header>
  <div class="editor-workspace">
    <main class="editor-panel editor-canvas">
      <EntryDraftForm draft={draft} />
    </main>
    <ValidationPanel entry={entry} />
  </div>
  <ActionBar
    loaded
    save={entry.capabilities.save}
    preview={entry.capabilities.preview}
    publish={entry.capabilities.publish}
  />
</EditorLayout>

<script
  type="application/json"
  is:inline
  id="journal-editor-draft"
  set:html={serializedDraft}
/>
<script>
  import {
    isJournalEditorDraftDirty,
    updateJournalEditorDraft,
    validateJournalEditorDraft,
    type JournalEditorDraftState,
  } from "../../../../editor/journal-draft-state";
  import {
    editorFailureGuidance,
    isEditorSaveShortcut,
    journalDraftDirtyFields,
    journalIssueFieldName,
    journalIssueLocation,
  } from "../../../../editor/ux";

  const serialized = document.querySelector<HTMLScriptElement>(
    "#journal-editor-draft",
  )?.textContent;
  const form = document.querySelector<HTMLFormElement>(
    "[data-editor-draft-form]",
  );
  const actionStatus = document.querySelector<HTMLElement>(
    "[data-action-status]",
  );
  const validation = document.querySelector<HTMLElement>(".editor-validation");
  const saveButton = document.querySelector<HTMLButtonElement>(
    "[data-save-journal]",
  );
  const publishButton = document.querySelector<HTMLButtonElement>(
    "[data-publish-journal]",
  );
  const previewButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-preview-journal]"),
  );

  if (serialized && form) {
    let initial = JSON.parse(serialized) as JournalEditorDraftState;
    let current = initial;
    let pending: "preview-ja" | "preview-en" | "save" | "publish" | null = null;
    let statusMessage: string | null = null;

    const resizeTextarea = (textarea: HTMLTextAreaElement) => {
      textarea.style.height = "auto";
      textarea.style.height = `${Math.max(textarea.scrollHeight, 112)}px`;
    };

    const renderFieldState = () => {
      const dirtyFields = journalDraftDirtyFields(initial, current);
      for (const label of form.querySelectorAll<HTMLElement>(
        "[data-editor-field]",
      ))
        label.classList.toggle(
          "is-modified",
          dirtyFields.has(label.dataset.editorField ?? ""),
        );
      for (const section of form.querySelectorAll<HTMLElement>(
        "[data-editor-section]",
      )) {
        const dirty = [...dirtyFields].some((field) =>
          field.startsWith(`${section.dataset.editorSection}.`),
        );
        section.classList.toggle("is-modified", dirty);
        const indicator = section.querySelector<HTMLElement>(
          "[data-section-dirty]",
        );
        if (indicator) indicator.hidden = !dirty;
      }
    };

    const focusIssueField = (target: string) => {
      const field = form.elements.namedItem(target);
      if (!(field instanceof HTMLElement)) return;
      field.scrollIntoView({ behavior: "smooth", block: "center" });
      field.focus({ preventScroll: true });
    };

    const setActionReason = (action: string, reason: string) => {
      const container = document.querySelector<HTMLElement>(
        `[data-action="${action}"]`,
      );
      const hint = container?.querySelector<HTMLElement>(
        "[data-action-reason]",
      );
      const button = container?.querySelector<HTMLButtonElement>("button");
      if (hint) hint.textContent = reason;
      if (button) button.title = reason;
    };

    const renderActions = () => {
      const result = validateJournalEditorDraft(current);
      const dirty = isJournalEditorDraftDirty(initial, current);
      const busy = pending !== null;
      if (actionStatus) {
        actionStatus.textContent =
          statusMessage ??
          (dirty ? "Unsaved changes" : "Saved · ready to publish");
        actionStatus.dataset.state = pending
          ? "pending"
          : dirty
            ? "dirty"
            : "saved";
      }
      for (const locale of ["ja", "en"] as const) {
        const button = previewButtons.find(
          (candidate) => candidate.dataset.previewJournal === locale,
        );
        if (button)
          button.disabled = busy || !result.capabilities.preview[locale];
        setActionReason(
          `preview-${locale}`,
          busy
            ? "Another action is in progress"
            : result.capabilities.preview[locale]
              ? `Preview current ${locale.toUpperCase()} draft`
              : `${locale.toUpperCase()} validation is blocking preview`,
        );
      }
      if (saveButton)
        saveButton.disabled = busy || !dirty || !result.capabilities.save;
      setActionReason(
        "save",
        busy
          ? "Another action is in progress"
          : !result.capabilities.save
            ? "Draft validation is blocking save"
            : !dirty
              ? "No unsaved changes"
              : "Save changes (⌘S / Ctrl+S)",
      );
      if (publishButton)
        publishButton.disabled = busy || dirty || !result.capabilities.publish;
      setActionReason(
        "publish",
        busy
          ? "Another action is in progress"
          : dirty
            ? "Save changes before publishing"
            : !result.capabilities.publish
              ? "Draft validation is blocking publish"
              : "Commit and push the saved canonical files",
      );
      renderFieldState();
    };

    const failureMessage = (error: unknown, fallback: string) => {
      const response = error as Error & { code?: string };
      const guidance = editorFailureGuidance(response.code);
      return `${response.message || fallback} ${guidance.message}`;
    };

    for (const button of previewButtons) {
      button.addEventListener("click", async () => {
        const locale = button.dataset.previewJournal as "ja" | "en";
        if (
          pending ||
          !validateJournalEditorDraft(current).capabilities.preview[locale]
        )
          return;
        const previewWindow = window.open("", "_blank");
        pending = `preview-${locale}`;
        statusMessage = `Preparing ${locale.toUpperCase()} preview…`;
        renderActions();
        try {
          const response = await fetch("/editor/api/journal-preview/create", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ draft: current, locale }),
          });
          const result = (await response.json()) as {
            url?: string;
            error?: string;
            code?: string;
          };
          if (!response.ok || !result.url) {
            const failure = new Error(
              result.error ?? "Journal preview failed",
            ) as Error & { code?: string };
            failure.code = result.code;
            throw failure;
          }
          if (previewWindow) previewWindow.location.href = result.url;
          else window.open(result.url, "_blank", "noopener");
          statusMessage = "Draft preview opened";
        } catch (error) {
          previewWindow?.close();
          statusMessage = failureMessage(error, "Journal preview failed");
        } finally {
          pending = null;
          renderActions();
        }
      });
    }
    const save = async () => {
      const validationResult = validateJournalEditorDraft(current);
      if (
        pending ||
        !isJournalEditorDraftDirty(initial, current) ||
        !validationResult.capabilities.save
      )
        return;
      pending = "save";
      const active = document.activeElement;
      const focusName =
        active instanceof HTMLInputElement ||
        active instanceof HTMLTextAreaElement
          ? active.name
          : null;
      const selection =
        active instanceof HTMLInputElement ||
        active instanceof HTMLTextAreaElement
          ? {
              start: active.selectionStart,
              end: active.selectionEnd,
              direction: active.selectionDirection,
            }
          : null;
      const pageScroll = { x: window.scrollX, y: window.scrollY };
      statusMessage = "Saving…";
      renderActions();
      try {
        const response = await fetch(
          `/editor/api/journal/${encodeURIComponent(current.contentId)}`,
          {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ draft: current, baseline: initial }),
          },
        );
        const result = (await response.json()) as {
          draft?: JournalEditorDraftState;
          error?: string;
          code?: string;
        };
        if (!response.ok || !result.draft) {
          const failure = new Error(
            result.error ?? "Journal save failed",
          ) as Error & { code?: string };
          failure.code = result.code;
          throw failure;
        }
        initial = result.draft;
        current = result.draft;
        statusMessage = "Saved to canonical files";
      } catch (error) {
        statusMessage = failureMessage(error, "Journal save failed");
      } finally {
        pending = null;
        renderActions();
        const field = focusName ? form.elements.namedItem(focusName) : null;
        if (
          field instanceof HTMLInputElement ||
          field instanceof HTMLTextAreaElement
        ) {
          field.focus({ preventScroll: true });
          if (selection && selection.start !== null && selection.end !== null)
            field.setSelectionRange(
              selection.start,
              selection.end,
              selection.direction ?? undefined,
            );
          window.scrollTo(pageScroll.x, pageScroll.y);
        }
      }
    };
    saveButton?.addEventListener("click", save);
    publishButton?.addEventListener("click", async () => {
      const dirty = isJournalEditorDraftDirty(initial, current);
      if (
        pending ||
        dirty ||
        !validateJournalEditorDraft(current).capabilities.publish
      )
        return;
      pending = "publish";
      statusMessage = "Publishing…";
      renderActions();
      try {
        const response = await fetch(
          `/editor/api/journal-publish/${encodeURIComponent(current.contentId)}`,
          {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ draft: current, dirty }),
          },
        );
        const result = (await response.json()) as {
          state?: "published" | "committed-push-failed";
          commit?: string;
          error?: string;
          code?: string;
        };
        if (!response.ok || !result.state) {
          const failure = new Error(
            result.error ?? "Journal publish failed",
          ) as Error & { code?: string };
          failure.code = result.code;
          throw failure;
        }
        statusMessage =
          result.state === "published"
            ? `Published ${result.commit?.slice(0, 7) ?? "commit"}`
            : `Committed ${result.commit?.slice(0, 7) ?? "commit"}; push failed. Retry push outside the Editor.`;
      } catch (error) {
        statusMessage = failureMessage(error, "Journal publish failed");
      } finally {
        pending = null;
        renderActions();
      }
    });
    form.addEventListener("input", (event) => {
      const field = event.target as
        | HTMLInputElement
        | HTMLTextAreaElement
        | HTMLSelectElement;
      if (!field.name) return;
      current = updateJournalEditorDraft(current, (next) => {
        const [scope, key, nested] = field.name.split(".");
        if (scope === "shared" && next.shared.state === "editable") {
          const shared = next.shared.value;
          if (key === "categories")
            shared.categories = field.value
              .split(",")
              .map((value) => value.trim())
              .filter(Boolean) as typeof shared.categories;
          else if (key === "hero" && nested)
            shared.hero[nested as "image" | "hero_caption"] =
              field.value || (undefined as never);
          else if (key === "author") shared.author = field.value || undefined;
          else if (key === "date" || key === "visibility")
            Object.assign(shared, { [key]: field.value });
        } else if (
          (scope === "ja" || scope === "en") &&
          next.locales[scope].state === "editable"
        ) {
          Object.assign(next.locales[scope].value, { [key]: field.value });
        }
      });
      statusMessage = null;
      if (field instanceof HTMLTextAreaElement) resizeTextarea(field);
      const dirty = isJournalEditorDraftDirty(initial, current);
      if (validation) {
        const result = validateJournalEditorDraft(current);
        const status = validation.querySelector<HTMLElement>(".editor-status")!;
        const state = result.issues.length === 0 ? "valid" : "blocked";
        status.textContent = state;
        status.className = `editor-status editor-status--${state}`;
        validation.querySelector<HTMLElement>(
          "[data-issue-summary]",
        )!.textContent =
          result.issues.length === 0
            ? "No draft issues"
            : `${result.issues.length} draft issues`;
        for (const locale of ["ja", "en"] as const) {
          validation.querySelector<HTMLElement>(
            `[data-preview-${locale}]`,
          )!.textContent = result.capabilities.preview[locale]
            ? "Available"
            : "Blocked";
          const previewButton = document.querySelector<HTMLButtonElement>(
            `[data-preview-journal="${locale}"]`,
          );
          if (previewButton)
            previewButton.disabled = !result.capabilities.preview[locale];
        }
        validation.querySelector<HTMLElement>("[data-publish]")!.textContent =
          result.capabilities.publish ? "Available" : "Blocked";
        validation.querySelector<HTMLElement>("[data-save]")!.textContent =
          result.capabilities.save ? "Available" : "Blocked";
        if (saveButton)
          saveButton.disabled = !dirty || !result.capabilities.save;
        if (publishButton)
          publishButton.disabled = dirty || !result.capabilities.publish;
        const issueList =
          validation.querySelector<HTMLUListElement>("[data-issues]")!;
        issueList.hidden = result.issues.length === 0;
        issueList.replaceChildren(
          ...result.issues.map((issue) => {
            const item = document.createElement("li");
            const meta = document.createElement("div");
            const severity = document.createElement("strong");
            const locale = document.createElement("span");
            const field = document.createElement("span");
            const label = document.createElement("span");
            const message = document.createElement("small");
            const location = journalIssueLocation(issue);
            const targetName = journalIssueFieldName(issue);
            if (targetName) item.dataset.issueTarget = targetName;
            meta.className = "editor-issue__meta";
            severity.className = `editor-issue__severity editor-issue__severity--${issue.severity}`;
            severity.textContent = issue.severity;
            locale.textContent = location.locale;
            field.textContent = location.field;
            label.textContent = issue.messageKey;
            message.textContent = issue.ruleId;
            meta.append(severity, locale, field);
            item.append(meta, label, message);
            if (targetName) {
              const link = document.createElement("button");
              link.type = "button";
              link.className = "editor-issue__link";
              link.textContent = "Go to field";
              item.append(link);
            }
            return item;
          }),
        );
      }
      renderActions();
    });

    window.addEventListener("beforeunload", (event) => {
      if (!isJournalEditorDraftDirty(initial, current)) return;
      event.preventDefault();
      (event as unknown as { returnValue: string }).returnValue = "";
    });
    document.addEventListener("keydown", (event) => {
      if (!isEditorSaveShortcut(event)) return;
      event.preventDefault();
      void save();
    });
    validation?.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>(
        ".editor-issue__link",
      );
      const target = button?.closest<HTMLElement>("[data-issue-target]")
        ?.dataset.issueTarget;
      if (target) focusIssueField(target);
    });
    for (const textarea of form.querySelectorAll<HTMLTextAreaElement>(
      "textarea",
    ))
      resizeTextarea(textarea);
    renderActions();
  }
</script>
