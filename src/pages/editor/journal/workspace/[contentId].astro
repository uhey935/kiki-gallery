---
import ActionBar from "../../../../components/editor/ActionBar.astro";
import EntryDraftForm from "../../../../components/editor/EntryDraftForm.astro";
import JournalDeletePanel from "../../../../components/editor/JournalDeletePanel.astro";
import RenamePanel from "../../../../components/editor/RenamePanel.astro";
import ValidationPanel from "../../../../components/editor/ValidationPanel.astro";
import { createJournalEditorDraft } from "../../../../editor/journal-draft-state";
import {
  readJournalEditorEntry,
  readJournalEditorState,
} from "../../../../editor/journal-state";
import EditorLayout from "../../../../layouts/EditorLayout.astro";

export async function getStaticPaths() {
  const state = await readJournalEditorState();
  return Promise.all(
    state.entries.map(async ({ contentId }) => ({
      params: { contentId },
      props: { entry: await readJournalEditorEntry(contentId) },
    })),
  );
}

const { entry } = Astro.props;
const draft = createJournalEditorDraft(entry);
const serializedDraft = JSON.stringify(draft).replaceAll("<", "\\u003c");
---

<EditorLayout title={entry.title} section="Journal">
  <header class="editor-page-heading">
    <p class="editor-eyebrow">Journal workspace</p>
    <h1>{entry.title}</h1>
    <p>
      <span data-workspace-content-id>{entry.contentId}</span> · Canonical three-file
      editor
    </p>
  </header>
  <div class="editor-workspace">
    <main class="editor-panel editor-canvas">
      <EntryDraftForm draft={draft} />
    </main>
    <ValidationPanel entry={entry} />
  </div>
  <RenamePanel collection="journal" contentId={entry.contentId} />
  <JournalDeletePanel contentId={entry.contentId} />
  <ActionBar
    loaded
    save={entry.capabilities.save}
    preview={entry.capabilities.preview}
    publish={entry.capabilities.publish}
  />
</EditorLayout>

<script
  type="application/json"
  is:inline
  id="journal-editor-draft"
  set:html={serializedDraft}
/>
<script>
  import {
    isJournalEditorDraftDirty,
    updateJournalEditorDraft,
    validateJournalEditorDraft,
    type JournalEditorDraftState,
  } from "../../../../editor/journal-draft-state";
  import {
    editorFailureGuidance,
    isEditorManualRecoveryFailure,
    isEditorSaveShortcut,
    journalDraftDirtyFields,
    journalIssueFieldName,
    journalIssueLocation,
  } from "../../../../editor/ux";
  import {
    commitEditorFormBaseline,
    restoreEditorDraftBaseline,
    restoreEditorFormBaseline,
  } from "../../../../editor/cancel";
  import type { JournalHeroAssetDraft } from "../../../../editor/journal-hero-assets";

  const serialized = document.querySelector<HTMLScriptElement>(
    "#journal-editor-draft",
  )?.textContent;
  const form = document.querySelector<HTMLFormElement>(
    "[data-editor-draft-form]",
  );
  const actionStatus = document.querySelector<HTMLElement>(
    "[data-action-status]",
  );
  const validation = document.querySelector<HTMLElement>(".editor-validation");
  const saveButton = document.querySelector<HTMLButtonElement>(
    "[data-save-journal]",
  );
  const cancelButton = document.querySelector<HTMLButtonElement>(
    "[data-cancel-journal]",
  );
  const publishButton = document.querySelector<HTMLButtonElement>(
    "[data-publish-journal]",
  );
  const previewButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-preview-journal]"),
  );

  if (serialized && form) {
    let initial = JSON.parse(serialized) as JournalEditorDraftState;
    let current = initial;
    let pending: "preview-ja" | "preview-en" | "save" | "publish" | null = null;
    let recoveryRequired = false;
    let deleteLocked = false;
    let statusMessage: string | null = null;
    const recoveryStorageKey = `kiki-editor:manual-recovery:journal:${initial.contentId}`;
    const storedRecovery = sessionStorage.getItem(recoveryStorageKey);
    if (storedRecovery) {
      recoveryRequired = true;
      statusMessage = storedRecovery;
    }
    const hero = form.querySelector<HTMLElement>("[data-journal-hero]")!;
    const heroPath = hero.querySelector<HTMLInputElement>(
      "[data-journal-hero-path]",
    )!;
    const heroCurrent = hero.querySelector<HTMLElement>(
      "[data-journal-hero-current]",
    )!;
    const heroDrop = hero.querySelector<HTMLElement>(
      "[data-journal-hero-drop]",
    )!;
    const heroFile = hero.querySelector<HTMLInputElement>(
      "[data-journal-hero-file]",
    )!;
    const heroThumbnail = hero.querySelector<HTMLImageElement>(
      "[data-journal-hero-thumbnail]",
    )!;
    const heroState = hero.querySelector<HTMLElement>(
      "[data-journal-hero-state]",
    )!;
    const heroCanonicalPath = hero.querySelector<HTMLElement>(
      "[data-journal-hero-canonical-path]",
    )!;
    const heroConfirm = hero.querySelector<HTMLElement>(
      "[data-journal-hero-confirm]",
    )!;
    const heroNew = hero.querySelector<HTMLImageElement>(
      "[data-journal-hero-new]",
    )!;
    const heroStatus = hero.querySelector<HTMLElement>(
      "[data-journal-hero-status]",
    )!;
    const workspaceId = crypto.randomUUID();
    let heroAsset: JournalHeroAssetDraft = {
      kind: "existing",
      src:
        current.shared.state === "editable"
          ? current.shared.value.hero.image
          : "",
    };
    let pendingHeroCandidate: Extract<
      JournalHeroAssetDraft,
      { kind: "temporary" }
    > | null = null;
    const heroPreviewUrl = (token: string) =>
      `/editor/api/journal-hero-preview/${encodeURIComponent(current.contentId)}/${encodeURIComponent(workspaceId)}/${encodeURIComponent(token)}`;
    const releaseHero = async (
      candidate: JournalHeroAssetDraft | null,
      keepalive = false,
    ) => {
      if (!candidate || candidate.kind !== "temporary") return;
      await fetch("/editor/api/journal-hero/release", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          token: candidate.token,
          contentId: current.contentId,
          workspaceId,
        }),
        keepalive,
      }).catch(() => undefined);
    };
    const renderHero = () => {
      heroConfirm.hidden = pendingHeroCandidate === null;
      heroDrop.hidden = heroAsset.kind !== "empty";
      heroCurrent.hidden = heroAsset.kind === "empty";
      if (heroAsset.kind === "existing") {
        heroThumbnail.src = heroAsset.src;
        heroPath.value = heroAsset.src;
        heroCanonicalPath.textContent = heroAsset.src;
        heroState.textContent = "Canonical · saved";
      } else if (heroAsset.kind === "temporary") {
        heroThumbnail.src = heroPreviewUrl(heroAsset.token);
        heroPath.value = heroAsset.proposedSrc;
        heroCanonicalPath.textContent = heroAsset.proposedSrc;
        heroState.textContent = heroAsset.replaces
          ? "Replacement pending · temporary / unsaved"
          : "New image · temporary / unsaved";
      } else heroPath.value = "";
    };
    const syncHeroDraft = () =>
      heroPath.dispatchEvent(new Event("input", { bubbles: true }));

    const resizeTextarea = (textarea: HTMLTextAreaElement) => {
      textarea.style.height = "auto";
      textarea.style.height = `${Math.max(textarea.scrollHeight, 112)}px`;
    };

    const renderFieldState = () => {
      const dirtyFields = journalDraftDirtyFields(initial, current);
      for (const label of form.querySelectorAll<HTMLElement>(
        "[data-editor-field]",
      ))
        label.classList.toggle(
          "is-modified",
          dirtyFields.has(label.dataset.editorField ?? ""),
        );
      for (const section of form.querySelectorAll<HTMLElement>(
        "[data-editor-section]",
      )) {
        const sectionName = section.dataset.editorSection;
        const dirty = [...dirtyFields].some((field) =>
          sectionName === "metadata"
            ? /^(?:ja|en)\.(?:seo_title|description)$/.test(field)
            : field.startsWith(`${sectionName}.`),
        );
        section.classList.toggle("is-modified", dirty);
        const indicator = section.querySelector<HTMLElement>(
          "[data-section-dirty]",
        );
        if (indicator) indicator.hidden = !dirty;
      }
    };

    const focusIssueField = (target: string) => {
      const field = form.elements.namedItem(target);
      if (!(field instanceof HTMLElement)) return;
      field.scrollIntoView({ behavior: "smooth", block: "center" });
      field.focus({ preventScroll: true });
    };

    const setActionReason = (action: string, reason: string) => {
      const container = document.querySelector<HTMLElement>(
        `[data-action="${action}"]`,
      );
      const hint = container?.querySelector<HTMLElement>(
        "[data-action-reason]",
      );
      const button = container?.querySelector<HTMLButtonElement>("button");
      if (hint) hint.textContent = reason;
      if (button) button.title = reason;
    };

    const renderActions = () => {
      const result = validateJournalEditorDraft(current);
      const dirty = isJournalEditorDraftDirty(initial, current);
      const busy = pending !== null;
      const operationLocked = busy || recoveryRequired || deleteLocked;
      for (const control of form.querySelectorAll<
        | HTMLInputElement
        | HTMLTextAreaElement
        | HTMLSelectElement
        | HTMLButtonElement
      >("input, textarea, select, button"))
        control.disabled = operationLocked;
      if (actionStatus) {
        actionStatus.textContent = recoveryRequired
          ? (statusMessage ?? "Operations stopped · manual recovery required")
          : (statusMessage ??
            (dirty
              ? "Unsaved changes"
              : result.capabilities.publish
                ? "Saved · publish available"
                : "Saved · Publish blocked by validation"));
        actionStatus.dataset.state = pending
          ? "pending"
          : dirty
            ? "dirty"
            : "saved";
      }
      for (const locale of ["ja", "en"] as const) {
        const button = previewButtons.find(
          (candidate) => candidate.dataset.previewJournal === locale,
        );
        if (button)
          button.disabled =
            operationLocked || !result.capabilities.preview[locale];
        setActionReason(
          `preview-${locale}`,
          recoveryRequired
            ? "Manual recovery is required before preview can continue"
            : busy
              ? "Another action is in progress"
              : result.capabilities.preview[locale]
                ? `Preview current ${locale.toUpperCase()} draft`
                : `${locale.toUpperCase()} validation is blocking preview`,
        );
      }
      if (saveButton)
        saveButton.disabled =
          operationLocked || !dirty || !result.capabilities.save;
      if (cancelButton) cancelButton.disabled = operationLocked || !dirty;
      setActionReason(
        "save",
        recoveryRequired
          ? "Manual recovery is required before editing can continue"
          : busy
            ? "Another action is in progress"
            : !result.capabilities.save
              ? "Draft validation is blocking save"
              : !dirty
                ? "No unsaved changes"
                : "Save changes to the canonical Journal (⌘S / Ctrl+S)",
      );
      if (publishButton)
        publishButton.disabled =
          operationLocked || dirty || !result.capabilities.publish;
      setActionReason(
        "publish",
        recoveryRequired
          ? "Manual recovery is required before publishing can continue"
          : busy
            ? "Another action is in progress"
            : dirty
              ? "Save changes before publishing"
              : !result.capabilities.publish
                ? "Draft validation is blocking publish"
                : "Publish the saved canonical Journal",
      );
      renderFieldState();
      window.dispatchEvent(
        new CustomEvent("editor:workspace-state", {
          detail: { locked: operationLocked || dirty },
        }),
      );
    };

    const failureMessage = (error: unknown, fallback: string) => {
      const response = error as Error & { code?: string };
      const guidance = editorFailureGuidance(response.code);
      return `${response.message || fallback} ${guidance.message}`;
    };

    const uploadHero = async (file: File) => {
      if (pending || recoveryRequired) return;
      pending = "save";
      heroStatus.textContent = "Validating and staging image…";
      renderActions();
      try {
        const data = new FormData();
        data.append("file", file);
        data.append("workspaceId", workspaceId);
        const response = await fetch(
          `/editor/api/journal-hero/upload/${encodeURIComponent(current.contentId)}`,
          { method: "POST", body: data },
        );
        const result = await response.json();
        if (!response.ok)
          throw Object.assign(new Error(result.error ?? "Hero upload failed"), {
            code: result.code,
          });
        if (result.state === "reuse") {
          await releaseHero(heroAsset);
          await releaseHero(pendingHeroCandidate);
          pendingHeroCandidate = null;
          heroAsset = { kind: "existing", src: result.src };
          heroStatus.textContent = "Identical canonical image reused";
        } else {
          const candidate = {
            kind: "temporary" as const,
            token: result.asset.token,
            workspaceId,
            proposedSrc: result.asset.proposedSrc,
            sha256: result.asset.sha256,
            ...(result.asset.replaces
              ? { replaces: result.asset.replaces }
              : {}),
          };
          if (result.state === "replace-confirmation") {
            await releaseHero(pendingHeroCandidate);
            pendingHeroCandidate = candidate;
            heroNew.src = heroPreviewUrl(candidate.token);
            heroStatus.textContent =
              "Confirm replacement. Canonical image is unchanged.";
          } else {
            await releaseHero(heroAsset);
            await releaseHero(pendingHeroCandidate);
            pendingHeroCandidate = null;
            heroAsset = candidate;
            heroStatus.textContent = "Temporary image staged · Save to confirm";
          }
        }
        renderHero();
        syncHeroDraft();
      } catch (error) {
        heroStatus.textContent = failureMessage(error, "Hero upload failed");
      } finally {
        pending = null;
        heroFile.value = "";
        renderActions();
      }
    };

    hero
      .querySelector("[data-journal-hero-select]")
      ?.addEventListener("click", () => heroFile.click());
    hero
      .querySelector("[data-journal-hero-replace]")
      ?.addEventListener("click", () => heroFile.click());
    heroFile.addEventListener("change", () => {
      const file = heroFile.files?.[0];
      if (file) void uploadHero(file);
    });
    hero.addEventListener("dragover", (event) => event.preventDefault());
    hero.addEventListener("drop", (event) => {
      event.preventDefault();
      const file = event.dataTransfer?.files[0];
      if (file) void uploadHero(file);
    });
    hero
      .querySelector("[data-journal-hero-remove]")
      ?.addEventListener("click", () => {
        void releaseHero(heroAsset);
        void releaseHero(pendingHeroCandidate);
        pendingHeroCandidate = null;
        heroAsset = { kind: "empty", previousSrc: heroPath.value };
        renderHero();
        syncHeroDraft();
        heroStatus.textContent =
          "Hero removed from draft · select a replacement before Save";
      });
    hero
      .querySelector("[data-journal-hero-reject]")
      ?.addEventListener("click", () => {
        void releaseHero(pendingHeroCandidate);
        pendingHeroCandidate = null;
        renderHero();
        heroStatus.textContent =
          "Replacement canceled · canonical image unchanged";
      });
    hero
      .querySelector("[data-journal-hero-accept]")
      ?.addEventListener("click", () => {
        if (!pendingHeroCandidate) return;
        void releaseHero(heroAsset);
        heroAsset = pendingHeroCandidate;
        pendingHeroCandidate = null;
        renderHero();
        syncHeroDraft();
        heroStatus.textContent =
          "Replacement staged · canonical image remains unchanged until Save";
      });

    for (const button of previewButtons) {
      button.addEventListener("click", async () => {
        const locale = button.dataset.previewJournal as "ja" | "en";
        if (
          pending ||
          recoveryRequired ||
          !validateJournalEditorDraft(current).capabilities.preview[locale]
        )
          return;
        const previewWindow = window.open("", "_blank");
        pending = `preview-${locale}`;
        statusMessage = `Preparing ${locale.toUpperCase()} preview…`;
        renderActions();
        try {
          const response = await fetch("/editor/api/journal-preview/create", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              draft: (() => {
                const value = structuredClone(current);
                if (
                  heroAsset.kind === "temporary" &&
                  value.shared.state === "editable"
                )
                  value.shared.value.hero.image = heroPreviewUrl(
                    heroAsset.token,
                  );
                return value;
              })(),
              locale,
            }),
          });
          const result = (await response.json()) as {
            url?: string;
            error?: string;
            code?: string;
          };
          if (!response.ok || !result.url) {
            const failure = new Error(
              result.error ?? "Journal preview failed",
            ) as Error & { code?: string };
            failure.code = result.code;
            throw failure;
          }
          if (previewWindow) previewWindow.location.href = result.url;
          else window.open(result.url, "_blank", "noopener");
          statusMessage = "Draft preview opened";
        } catch (error) {
          previewWindow?.close();
          statusMessage = failureMessage(error, "Journal preview failed");
        } finally {
          pending = null;
          renderActions();
        }
      });
    }
    const save = async () => {
      const validationResult = validateJournalEditorDraft(current);
      if (
        pending ||
        recoveryRequired ||
        !isJournalEditorDraftDirty(initial, current) ||
        !validationResult.capabilities.save
      )
        return;
      pending = "save";
      const active = document.activeElement;
      const focusName =
        active instanceof HTMLInputElement ||
        active instanceof HTMLTextAreaElement
          ? active.name
          : null;
      const selection =
        active instanceof HTMLInputElement ||
        active instanceof HTMLTextAreaElement
          ? {
              start: active.selectionStart,
              end: active.selectionEnd,
              direction: active.selectionDirection,
            }
          : null;
      const pageScroll = { x: window.scrollX, y: window.scrollY };
      statusMessage = "Saving…";
      renderActions();
      try {
        const response = await fetch(
          `/editor/api/journal/${encodeURIComponent(current.contentId)}`,
          {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              draft: current,
              baseline: initial,
              hero: heroAsset,
            }),
          },
        );
        const result = (await response.json()) as {
          draft?: JournalEditorDraftState;
          error?: string;
          code?: string;
        };
        if (!response.ok || !result.draft) {
          const failure = new Error(
            result.error ?? "Journal save failed",
          ) as Error & { code?: string };
          failure.code = result.code;
          throw failure;
        }
        initial = result.draft;
        current = result.draft;
        heroAsset = {
          kind: "existing",
          src:
            result.draft.shared.state === "editable"
              ? result.draft.shared.value.hero.image
              : "",
        };
        pendingHeroCandidate = null;
        renderHero();
        commitEditorFormBaseline(form);
        statusMessage = "Saved to canonical files";
      } catch (error) {
        if (
          isEditorManualRecoveryFailure(
            (error as Error & { code?: string }).code,
          )
        ) {
          recoveryRequired = true;
          sessionStorage.setItem(
            recoveryStorageKey,
            failureMessage(error, "Journal save failed"),
          );
        }
        statusMessage = failureMessage(error, "Journal save failed");
      } finally {
        pending = null;
        renderActions();
        const field = focusName ? form.elements.namedItem(focusName) : null;
        if (
          field instanceof HTMLInputElement ||
          field instanceof HTMLTextAreaElement
        ) {
          field.focus({ preventScroll: true });
          if (selection && selection.start !== null && selection.end !== null)
            field.setSelectionRange(
              selection.start,
              selection.end,
              selection.direction ?? undefined,
            );
          window.scrollTo(pageScroll.x, pageScroll.y);
        }
      }
    };
    saveButton?.addEventListener("click", save);
    cancelButton?.addEventListener("click", () => {
      void releaseHero(heroAsset);
      void releaseHero(pendingHeroCandidate);
      pendingHeroCandidate = null;
      restoreEditorFormBaseline(form);
      current = restoreEditorDraftBaseline(initial);
      heroAsset = {
        kind: "existing",
        src:
          initial.shared.state === "editable"
            ? initial.shared.value.hero.image
            : "",
      };
      renderHero();
      statusMessage = "Changes canceled · saved draft restored";
      for (const textarea of form.querySelectorAll<HTMLTextAreaElement>(
        "textarea",
      ))
        resizeTextarea(textarea);
      renderActions();
    });
    publishButton?.addEventListener("click", async () => {
      const dirty = isJournalEditorDraftDirty(initial, current);
      if (
        pending ||
        recoveryRequired ||
        dirty ||
        !validateJournalEditorDraft(current).capabilities.publish
      )
        return;
      pending = "publish";
      statusMessage = "Publishing…";
      renderActions();
      try {
        const response = await fetch(
          `/editor/api/journal-publish/${encodeURIComponent(current.contentId)}`,
          {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ draft: current, dirty }),
          },
        );
        const result = (await response.json()) as {
          state?: "published" | "committed-push-failed";
          commit?: string;
          error?: string;
          code?: string;
        };
        if (!response.ok || !result.state) {
          const failure = new Error(
            result.error ?? "Journal publish failed",
          ) as Error & { code?: string };
          failure.code = result.code;
          throw failure;
        }
        statusMessage =
          result.state === "published"
            ? `Published ${result.commit?.slice(0, 7) ?? "commit"}`
            : `Committed ${result.commit?.slice(0, 7) ?? "commit"}; push failed. Retry push outside the Editor.`;
      } catch (error) {
        statusMessage = failureMessage(error, "Journal publish failed");
      } finally {
        pending = null;
        renderActions();
      }
    });
    window.addEventListener("editor:rename-complete", (event) => {
      const renamed = (
        event as CustomEvent<{ draft?: JournalEditorDraftState }>
      ).detail.draft;
      if (!renamed) return;
      initial = renamed;
      current = structuredClone(renamed);
      statusMessage = "Renamed · unpublished changes ready to publish";
      const identity = document.querySelector<HTMLElement>(
        "[data-workspace-content-id]",
      );
      if (identity) identity.textContent = renamed.contentId;
      renderActions();
    });
    window.addEventListener("editor:delete-state", (event) => {
      deleteLocked = Boolean(
        (event as CustomEvent<{ locked?: boolean }>).detail?.locked,
      );
      if (deleteLocked) statusMessage = "Journal Delete operation in progress";
      else if (statusMessage === "Journal Delete operation in progress")
        statusMessage = null;
      renderActions();
    });
    form.addEventListener("input", (event) => {
      const field = event.target as
        HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
      if (!field.name) return;
      current = updateJournalEditorDraft(current, (next) => {
        const [scope, key, nested] = field.name.split(".");
        if (scope === "shared" && next.shared.state === "editable") {
          const shared = next.shared.value;
          if (key === "category")
            shared.category = field.value as typeof shared.category;
          else if (key === "hero" && nested)
            shared.hero[nested as "image" | "hero_caption"] =
              field.value || (undefined as never);
          else if (key === "date" || key === "visibility")
            Object.assign(shared, { [key]: field.value });
        } else if (
          (scope === "ja" || scope === "en") &&
          next.locales[scope].state === "editable"
        ) {
          Object.assign(next.locales[scope].value, {
            [key]:
              key === "seo_title" || key === "description"
                ? field.value || undefined
                : field.value,
          });
        }
      });
      statusMessage = null;
      if (field instanceof HTMLTextAreaElement) resizeTextarea(field);
      const dirty = isJournalEditorDraftDirty(initial, current);
      if (validation) {
        const result = validateJournalEditorDraft(current);
        const status = validation.querySelector<HTMLElement>(".editor-status")!;
        const state = result.issues.length === 0 ? "valid" : "blocked";
        status.textContent = state;
        status.className = `editor-status editor-status--${state}`;
        validation.querySelector<HTMLElement>(
          "[data-issue-summary]",
        )!.textContent =
          result.issues.length === 0
            ? "No draft issues"
            : `${result.issues.length} draft issues`;
        for (const locale of ["ja", "en"] as const) {
          validation.querySelector<HTMLElement>(
            `[data-preview-${locale}]`,
          )!.textContent = result.capabilities.preview[locale]
            ? "Available"
            : "Blocked";
          const previewButton = document.querySelector<HTMLButtonElement>(
            `[data-preview-journal="${locale}"]`,
          );
          if (previewButton)
            previewButton.disabled = !result.capabilities.preview[locale];
        }
        validation.querySelector<HTMLElement>("[data-publish]")!.textContent =
          result.capabilities.publish ? "Available" : "Blocked";
        validation.querySelector<HTMLElement>("[data-save]")!.textContent =
          result.capabilities.save ? "Available" : "Blocked";
        if (saveButton)
          saveButton.disabled = !dirty || !result.capabilities.save;
        if (publishButton)
          publishButton.disabled = dirty || !result.capabilities.publish;
        const issueList =
          validation.querySelector<HTMLUListElement>("[data-issues]")!;
        issueList.hidden = result.issues.length === 0;
        issueList.replaceChildren(
          ...result.issues.map((issue) => {
            const item = document.createElement("li");
            const meta = document.createElement("div");
            const severity = document.createElement("strong");
            const locale = document.createElement("span");
            const field = document.createElement("span");
            const label = document.createElement("span");
            const message = document.createElement("small");
            const location = journalIssueLocation(issue);
            const targetName = journalIssueFieldName(issue);
            if (targetName) item.dataset.issueTarget = targetName;
            meta.className = "editor-issue__meta";
            severity.className = `editor-issue__severity editor-issue__severity--${issue.severity}`;
            severity.textContent = issue.severity;
            locale.textContent = location.locale;
            field.textContent = location.field;
            label.textContent = issue.messageKey;
            message.textContent = issue.ruleId;
            meta.append(severity, locale, field);
            item.append(meta, label, message);
            if (targetName) {
              const link = document.createElement("button");
              link.type = "button";
              link.className = "editor-issue__link";
              link.textContent = "Go to field";
              item.append(link);
            }
            return item;
          }),
        );
      }
      renderActions();
    });

    window.addEventListener("beforeunload", (event) => {
      if (!isJournalEditorDraftDirty(initial, current)) return;
      event.preventDefault();
      (event as unknown as { returnValue: string }).returnValue = "";
    });
    window.addEventListener("pagehide", () => {
      void releaseHero(heroAsset, true);
      void releaseHero(pendingHeroCandidate, true);
    });
    renderHero();
    document.addEventListener("keydown", (event) => {
      if (!isEditorSaveShortcut(event)) return;
      event.preventDefault();
      void save();
    });
    validation?.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>(
        ".editor-issue__link",
      );
      const target = button?.closest<HTMLElement>("[data-issue-target]")
        ?.dataset.issueTarget;
      if (target) focusIssueField(target);
    });
    for (const textarea of form.querySelectorAll<HTMLTextAreaElement>(
      "textarea",
    ))
      resizeTextarea(textarea);
    renderActions();
  }
</script>
