---
import ActionBar from "../../../components/editor/ActionBar.astro";
import EntryDraftForm from "../../../components/editor/EntryDraftForm.astro";
import { createNewJournalDraft } from "../../../editor/journal-create";
import EditorLayout from "../../../layouts/EditorLayout.astro";

const draft = createNewJournalDraft("");
const serializedDraft = JSON.stringify(draft).replaceAll("<", "\\u003c");
---

<EditorLayout title="Create Journal" section="Journal">
  <header class="editor-page-heading">
    <p class="editor-eyebrow">Journal create</p>
    <h1>New Content Unit</h1>
    <p>
      Draft Preview is temporary. First Save creates the canonical three-file
      unit.
    </p>
  </header>
  <div class="editor-workspace">
    <main class="editor-panel editor-canvas">
      <label data-editor-field="contentId">
        <span
          >Content ID <small class="editor-field-badge">Required</small></span
        >
        <input
          name="contentId"
          form="journal-create-fields"
          autocomplete="off"
          placeholder="lowercase-hyphenated-id"
        />
      </label>
      <div id="journal-create-fields">
        <EntryDraftForm draft={draft} create />
      </div>
    </main>
    <aside class="editor-panel editor-validation">
      <p class="editor-eyebrow">Create boundary</p>
      <h2>Validation</h2>
      <p data-create-validation>Complete the Content ID and required fields.</p>
      <small>Assets are not created or moved by this operation.</small>
    </aside>
  </div>
  <ActionBar
    loaded
    preview={{ ja: false, en: false }}
    save={false}
    publish={false}
  />
</EditorLayout>

<script
  type="application/json"
  is:inline
  id="journal-create-draft"
  set:html={serializedDraft}
/>
<script>
  import {
    isJournalEditorDraftDirty,
    updateJournalEditorDraft,
    validateJournalEditorDraft,
    type JournalEditorDraftState,
  } from "../../../editor/journal-draft-state";
  import { editorFailureGuidance } from "../../../editor/ux";
  import type { JournalHeroAssetMetadata } from "../../../editor/journal-hero-assets";

  const raw = document.querySelector<HTMLScriptElement>(
    "#journal-create-draft",
  )?.textContent;
  const form = document.querySelector<HTMLFormElement>(
    "[data-editor-draft-form]",
  );
  const idInput = document.querySelector<HTMLInputElement>(
    'input[name="contentId"]',
  );
  const saveButton = document.querySelector<HTMLButtonElement>(
    "[data-save-journal]",
  );
  const publishButton = document.querySelector<HTMLButtonElement>(
    "[data-publish-journal]",
  );
  const cancelButton = document.querySelector<HTMLButtonElement>(
    "[data-cancel-journal]",
  );
  const previewButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-preview-journal]"),
  );
  const status = document.querySelector<HTMLElement>("[data-action-status]");
  const validationText = document.querySelector<HTMLElement>(
    "[data-create-validation]",
  );

  if (raw && form && idInput) {
    const initial = JSON.parse(raw) as JournalEditorDraftState;
    let current = initial;
    let pending = false;
    const createWorkspaceId = crypto.randomUUID();
    const ownerContentId = `create-${createWorkspaceId}`;
    const hero = form.querySelector<HTMLElement>("[data-journal-hero]")!;
    const heroPath = hero.querySelector<HTMLInputElement>("[data-journal-hero-path]")!;
    const heroCurrent = hero.querySelector<HTMLElement>("[data-journal-hero-current]")!;
    const heroDrop = hero.querySelector<HTMLElement>("[data-journal-hero-drop]")!;
    const heroFile = hero.querySelector<HTMLInputElement>("[data-journal-hero-file]")!;
    const heroThumbnail = hero.querySelector<HTMLImageElement>("[data-journal-hero-thumbnail]")!;
    const heroCanonicalPath = hero.querySelector<HTMLElement>("[data-journal-hero-canonical-path]")!;
    const heroStatus = hero.querySelector<HTMLElement>("[data-journal-hero-status]")!;
    let heroAsset: JournalHeroAssetMetadata | undefined;
    const previewUrl = (token: string) =>
      `/editor/api/journal-hero-preview/${encodeURIComponent(ownerContentId)}/${encodeURIComponent(createWorkspaceId)}/${encodeURIComponent(token)}`;
    const releaseHero = async (asset = heroAsset, keepalive = false) => {
      if (!asset) return;
      await fetch("/editor/api/journal-hero/release", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ token: asset.token, contentId: ownerContentId, workspaceId: createWorkspaceId }),
        keepalive,
      }).catch(() => undefined);
    };
    const syncHero = () => {
      const validId = /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(current.contentId);
      const target = heroAsset && validId
        ? `/images/journal/${current.contentId}.${heroAsset.format}`
        : "";
      heroPath.value = target;
      if (current.shared.state === "editable") current.shared.value.hero.image = target;
      heroDrop.hidden = Boolean(heroAsset);
      heroCurrent.hidden = !heroAsset;
      if (heroAsset) {
        heroThumbnail.src = previewUrl(heroAsset.token);
        heroCanonicalPath.textContent = target;
      }
    };

    const setReason = (action: string, message: string) => {
      const container = document.querySelector<HTMLElement>(
        `[data-action="${action}"]`,
      );
      const hint = container?.querySelector<HTMLElement>(
        "[data-action-reason]",
      );
      const button = container?.querySelector<HTMLButtonElement>("button");
      if (hint) hint.textContent = message;
      if (button) button.title = message;
    };

    const render = (message?: string) => {
      const result = validateJournalEditorDraft(current);
      const idValid = /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(current.contentId);
      const busy = pending;
      for (const control of document.querySelectorAll<
        HTMLInputElement | HTMLTextAreaElement | HTMLButtonElement
      >("input, textarea, button"))
        control.disabled = busy;
      if (status)
        status.textContent =
          message ??
          (result.capabilities.save && idValid
            ? "Unsaved new entry"
            : "Create blocked by validation");
      if (validationText)
        validationText.textContent = !idValid
          ? "Content ID must use lowercase letters, numbers, and single hyphens."
          : result.issues.length === 0
            ? "Draft is valid for first Save."
            : `${result.issues.length} draft validation issue${result.issues.length === 1 ? "" : "s"}.`;
      for (const locale of ["ja", "en"] as const) {
        const button = previewButtons.find(
          (candidate) => candidate.dataset.previewJournal === locale,
        );
        if (button)
          button.disabled =
            busy || !idValid || !result.capabilities.preview[locale];
        setReason(
          `preview-${locale}`,
          result.capabilities.preview[locale] && idValid
            ? `Preview the unsaved ${locale.toUpperCase()} draft`
            : "Draft validation is blocking preview",
        );
      }
      if (saveButton)
        saveButton.disabled = busy || !idValid || !result.capabilities.save;
      if (publishButton) publishButton.disabled = true;
      setReason(
        "save",
        result.capabilities.save && idValid
          ? "Atomically create index.yaml, ja.md, and en.md"
          : "Draft validation is blocking first Save",
      );
      setReason(
        "publish",
        "First Save the new entry; Publish remains a separate workspace action",
      );
    };

    const uploadHero = async (file: File) => {
      if (pending) return;
      pending = true;
      render("Validating and staging Hero…");
      try {
        const data = new FormData();
        data.append("file", file);
        data.append("createWorkspaceId", createWorkspaceId);
        const response = await fetch("/editor/api/journal-hero/create-upload", {
          method: "POST",
          body: data,
        });
        const result = await response.json();
        if (!response.ok)
          throw Object.assign(new Error(result.error ?? "Hero upload failed"), {
            code: result.code,
          });
        const previous = heroAsset;
        heroAsset = result.asset;
        if (previous) await releaseHero(previous);
        syncHero();
        heroStatus.textContent = "Temporary Hero ready · target follows Content ID";
      } catch (error) {
        const failure = error as Error & { code?: string };
        heroStatus.textContent = `${failure.message} ${editorFailureGuidance(failure.code).message ?? "Try again."}`;
      } finally {
        pending = false;
        heroFile.value = "";
        render();
      }
    };
    hero.querySelector("[data-journal-hero-select]")?.addEventListener("click", () => heroFile.click());
    hero.querySelector("[data-journal-hero-replace]")?.addEventListener("click", () => heroFile.click());
    heroFile.addEventListener("change", () => {
      const file = heroFile.files?.[0];
      if (file) void uploadHero(file);
    });
    hero.addEventListener("dragover", (event) => event.preventDefault());
    hero.addEventListener("drop", (event) => {
      event.preventDefault();
      const file = event.dataTransfer?.files[0];
      if (file) void uploadHero(file);
    });
    hero.querySelector("[data-journal-hero-remove]")?.addEventListener("click", () => {
      const previous = heroAsset;
      heroAsset = undefined;
      syncHero();
      if (previous) void releaseHero(previous);
      heroStatus.textContent = "Hero removed · select a replacement before First Save";
      render();
    });

    const updateField = (field: HTMLInputElement | HTMLTextAreaElement) => {
      current = updateJournalEditorDraft(current, (next) => {
        if (field.name === "contentId") {
          next.contentId = field.value;
          return;
        }
        const [scope, key, nested] = field.name.split(".");
        if (scope === "shared" && next.shared.state === "editable") {
          const shared = next.shared.value;
          if (key === "category")
            shared.category = field.value as typeof shared.category;
          else if (key === "hero" && nested)
            shared.hero[nested as "image" | "hero_caption"] =
              field.value || (undefined as never);
          else if (key === "date" || key === "visibility")
            Object.assign(shared, { [key]: field.value });
        } else if (
          (scope === "ja" || scope === "en") &&
          next.locales[scope].state === "editable"
        )
          Object.assign(next.locales[scope].value, {
            [key]:
              key === "seo_title" || key === "description"
                ? field.value || undefined
                : field.value,
          });
      });
      if (field.name === "contentId") syncHero();
      render();
    };
    document.addEventListener("input", (event) => {
      const field = event.target;
      if (
        field instanceof HTMLInputElement ||
        field instanceof HTMLTextAreaElement
      )
        updateField(field);
    });

    for (const button of previewButtons)
      button.addEventListener("click", async () => {
        const locale = button.dataset.previewJournal as "ja" | "en";
        if (
          pending ||
          !validateJournalEditorDraft(current).capabilities.preview[locale]
        )
          return;
        const popup = window.open("", "_blank");
        pending = true;
        render(`Preparing ${locale.toUpperCase()} preview…`);
        try {
          const response = await fetch("/editor/api/journal-preview/create", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              draft: (() => {
                const value = structuredClone(current);
                if (heroAsset && value.shared.state === "editable")
                  value.shared.value.hero.image = previewUrl(heroAsset.token);
                return value;
              })(),
              locale,
            }),
          });
          const result = (await response.json()) as {
            url?: string;
            error?: string;
            code?: string;
          };
          if (!response.ok || !result.url)
            throw Object.assign(
              new Error(result.error ?? "Journal preview failed"),
              { code: result.code },
            );
          if (popup) popup.location.href = result.url;
          else window.open(result.url, "_blank", "noopener");
        } catch (error) {
          popup?.close();
          const failure = error as Error & { code?: string };
          render(
            `${failure.message} ${editorFailureGuidance(failure.code).message ?? "Try again."}`,
          );
        } finally {
          pending = false;
          render();
        }
      });

    saveButton?.addEventListener("click", async () => {
      if (pending || !validateJournalEditorDraft(current).capabilities.save)
        return;
      pending = true;
      render("Creating canonical Content Unit…");
      try {
        const response = await fetch("/editor/api/journal-create", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            draft: current,
            ...(heroAsset
              ? {
                  hero: {
                    token: heroAsset.token,
                    createWorkspaceId,
                    sha256: heroAsset.sha256,
                    format: heroAsset.format,
                  },
                }
              : {}),
          }),
        });
        const result = (await response.json()) as {
          workspaceUrl?: string;
          error?: string;
          code?: string;
        };
        if (!response.ok || !result.workspaceUrl)
          throw Object.assign(
            new Error(result.error ?? "Journal create failed"),
            { code: result.code },
          );
        window.location.assign(result.workspaceUrl);
      } catch (error) {
        pending = false;
        const failure = error as Error & { code?: string };
        render(
          `${failure.message} ${editorFailureGuidance(failure.code).message ?? "Try again."}`,
        );
      }
    });
    window.addEventListener("beforeunload", (event) => {
      if (!isJournalEditorDraftDirty(initial, current)) return;
      event.preventDefault();
      (event as unknown as { returnValue: string }).returnValue = "";
    });
    cancelButton?.addEventListener("click", () => {
      void releaseHero(heroAsset);
      window.location.assign("/editor/journal/workspace/");
    });
    window.addEventListener("pagehide", () => void releaseHero(heroAsset, true));
    syncHero();
    render();
  }
</script>
