---
import ActionBar from "../../../../components/editor/ActionBar.astro";
import NewsDraftForm from "../../../../components/editor/NewsDraftForm.astro";
import NewsValidationPanel from "../../../../components/editor/NewsValidationPanel.astro";
import RenamePanel from "../../../../components/editor/RenamePanel.astro";
import NewsDeletePanel from "../../../../components/editor/NewsDeletePanel.astro";
import {
  createNewsEditorDraft,
  validateNewsEditorDraft,
} from "../../../../editor/news-draft-state";
import {
  readNewsEditorEntry,
  readNewsEditorState,
} from "../../../../editor/news-state";
import EditorLayout from "../../../../layouts/EditorLayout.astro";
export async function getStaticPaths() {
  const state = await readNewsEditorState();
  return Promise.all(
    state.entries.map(async ({ contentId }) => ({
      params: { contentId },
      props: { entry: await readNewsEditorEntry(contentId) },
    })),
  );
}
const { entry } = Astro.props;
const draft = createNewsEditorDraft(entry);
const initialCapabilities = draft
  ? validateNewsEditorDraft(draft).capabilities
  : { save: false, preview: { ja: false, en: false }, publish: false };
const serializedDraft = JSON.stringify(draft).replaceAll("<", "\\u003c");
---

<EditorLayout title={entry.data?.title ?? entry.contentId} section="News">
  <header class="editor-page-heading">
    <p class="editor-eyebrow">News workspace</p><h1>
      {entry.data?.title ?? entry.contentId}
    </h1><p>
      <span data-workspace-content-id>{entry.contentId}</span> · Localized three-file
      draft
    </p>
  </header>
  <div class="editor-workspace">
    <main class="editor-panel editor-canvas">
      {
        draft ? (
          <NewsDraftForm draft={draft} />
        ) : (
          <p>
            Source cannot be represented as a Draft until validation issues are
            fixed.
          </p>
        )
      }
    </main><NewsValidationPanel entry={entry} />
  </div>
  <RenamePanel collection="news" contentId={entry.contentId} />
  <NewsDeletePanel contentId={entry.contentId} />
  <ActionBar
    mode="news"
    loaded={Boolean(draft)}
    preview={initialCapabilities.preview}
  />
</EditorLayout>
<script
  type="application/json"
  is:inline
  id="news-editor-draft"
  set:html={serializedDraft}
/>
<script>
  import {
    isNewsEditorDraftDirty,
    updateNewsEditorDraft,
    validateNewsEditorDraft,
    type NewsEditorDraftState,
  } from "../../../../editor/news-draft-state";
  import {
    editorFailureGuidance,
    isEditorSaveShortcut,
    renderFlatValidationPanel,
    worksWorkspaceUxState,
  } from "../../../../editor/ux";
  const raw =
    document.querySelector<HTMLScriptElement>(
      "#news-editor-draft",
    )?.textContent;
  const form = document.querySelector<HTMLFormElement>(
    "[data-news-draft-form]",
  );
  const save = document.querySelector<HTMLButtonElement>("[data-save-news]");
  const previews = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-preview-news]"),
  );
  const publish = document.querySelector<HTMLButtonElement>(
    "[data-publish-news]",
  );
  const status = document.querySelector<HTMLElement>(
    "[data-news-action-status]",
  );
  if (raw && form && save && previews.length === 2 && publish && status) {
    let baseline = JSON.parse(raw) as NewsEditorDraftState;
    let draft = structuredClone(baseline);
    let pending: "save" | "preview" | "publish" | null = null;
    let savedSincePublish = false;
    let statusMessage: string | null = null;
    let recoveryRequired = false;
    let deleteLocked = false;
    const setActionReason = (action: string, reason: string) => {
      const container = document.querySelector<HTMLElement>(
        '[data-action="' + action + '"]',
      );
      const hint = container?.querySelector<HTMLElement>(
        "[data-action-reason]",
      );
      const actionButton =
        container?.querySelector<HTMLButtonElement>("button");
      if (hint) hint.textContent = reason;
      if (actionButton) actionButton.title = reason;
    };
    const optional = (value: string) => value.trim() || undefined;
    const read = () => {
      const data = new FormData(form);
      const value = (name: string) => String(data.get(name) ?? "");
      draft = updateNewsEditorDraft(draft, (next) => {
        if (next.shared.state === "editable") {
          next.shared.value.date = value("shared.date");
          next.shared.value.news_type = value(
            "shared.news_type",
          ) as NewsEditorDraftState["data"]["news_type"];
          next.shared.value.link = optional(value("shared.link"));
          next.shared.value.show_on_home =
            data.get("shared.show_on_home") === "on";
        }
        for (const locale of ["ja", "en"] as const) {
          const source = next.locales[locale];
          if (source.state !== "editable") continue;
          source.value.title = value(`${locale}.title`);
          source.value.summary = optional(value(`${locale}.summary`));
        }
      });
    };
    const render = () => {
      const dirty = isNewsEditorDraftDirty(baseline, draft);
      const validation = validateNewsEditorDraft(draft);
      const capabilities = validation.capabilities;
      renderFlatValidationPanel(form, {
        ...validation,
        capabilities: {
          ...capabilities,
          preview: capabilities.preview.ja || capabilities.preview.en,
        },
      });
      const locked = pending !== null || recoveryRequired || deleteLocked;
      save.disabled = locked || !dirty || !capabilities.save;
      for (const locale of ["ja", "en"] as const) {
        const preview = previews.find(
          (candidate) => candidate.dataset.previewNews === locale,
        );
        if (preview) preview.disabled = locked || !capabilities.preview[locale];
        const capability = document.querySelector<HTMLElement>(
          `[data-preview-${locale}]`,
        );
        if (capability)
          capability.textContent = capabilities.preview[locale]
            ? "Available"
            : "Blocked";
        setActionReason(
          `preview-${locale}`,
          capabilities.preview[locale]
            ? `Preview current ${locale.toUpperCase()} draft`
            : `${locale.toUpperCase()} validation is blocking preview`,
        );
      }
      publish.disabled = locked || dirty || !capabilities.publish;
      form
        .querySelectorAll<
          HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement
        >("input, textarea, select")
        .forEach((control) => (control.disabled = locked));
      const ux = worksWorkspaceUxState({
        collectionName: "News",
        pending,
        dirty,
        canSave: capabilities.save,
        canPreview: capabilities.preview.ja || capabilities.preview.en,
        canPublish: capabilities.publish,
        savedSincePublish,
        recoveryRequired,
        statusMessage,
      });
      status.textContent = ux.status;
      status.dataset.state = pending ? "pending" : dirty ? "dirty" : "saved";
      setActionReason("save", ux.saveTitle);
      setActionReason("publish", ux.publishTitle);
      window.dispatchEvent(
        new CustomEvent("editor:workspace-state", {
          detail: { locked: locked || dirty },
        }),
      );
    };
    const request = async (url: string, body: unknown) => {
      const response = await fetch(url, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(body),
      });
      const result = await response.json();
      if (!response.ok)
        throw Object.assign(new Error(result.error), { code: result.code });
      return result;
    };
    form.addEventListener("input", () => {
      read();
      statusMessage = null;
      render();
    });
    save.addEventListener("click", async () => {
      pending = "save";
      render();
      try {
        const result = await request(
          `/editor/api/news/${encodeURIComponent(draft.contentId)}`,
          { draft, baseline },
        );
        baseline = result.draft;
        draft = structuredClone(baseline);
        savedSincePublish = true;
        statusMessage = "Saved · unpublished changes ready to publish";
      } catch (error) {
        const value = error as Error & { code?: string };
        statusMessage = `${value.message} ${editorFailureGuidance(value.code).message}`;
      } finally {
        pending = null;
        render();
      }
    });
    for (const preview of previews)
      preview.addEventListener("click", async () => {
        const locale = preview.dataset.previewNews as "ja" | "en";
        if (!validateNewsEditorDraft(draft).capabilities.preview[locale])
          return;
        pending = "preview";
        render();
        try {
          const result = await request("/editor/api/news-preview/create", {
            draft,
            locale,
          });
          window.open(result.url, "_blank", "noopener,noreferrer");
          statusMessage = `${locale.toUpperCase()} draft preview opened`;
        } catch (error) {
          const value = error as Error & { code?: string };
          statusMessage = `${value.message} ${editorFailureGuidance(value.code).message}`;
        } finally {
          pending = null;
          render();
        }
      });
    publish.addEventListener("click", async () => {
      pending = "publish";
      render();
      try {
        const result = await request(
          `/editor/api/news-publish/${encodeURIComponent(draft.contentId)}`,
          { draft, baseline, dirty: isNewsEditorDraftDirty(baseline, draft) },
        );
        recoveryRequired = result.state === "committed-push-failed";
        savedSincePublish = recoveryRequired;
        statusMessage =
          result.state === "published"
            ? `Published · ${result.commit.slice(0, 7)}`
            : `Committed · push failed · manual recovery required · ${result.error}`;
      } catch (error) {
        const value = error as Error & { code?: string };
        statusMessage = `${value.message} ${editorFailureGuidance(value.code).message}`;
      } finally {
        pending = null;
        render();
      }
    });
    window.addEventListener("editor:rename-complete", (event) => {
      const renamed = (event as CustomEvent<{ draft?: NewsEditorDraftState }>)
        .detail.draft;
      if (!renamed) return;
      baseline = renamed;
      draft = structuredClone(renamed);
      savedSincePublish = true;
      statusMessage = "Renamed · unpublished changes ready to publish";
      const identity = document.querySelector<HTMLElement>(
        "[data-workspace-content-id]",
      );
      if (identity) identity.textContent = renamed.contentId;
      render();
    });
    window.addEventListener("editor:delete-state", (event) => {
      deleteLocked = Boolean(
        (event as CustomEvent<{ locked?: boolean }>).detail?.locked,
      );
      statusMessage = deleteLocked ? "News Delete operation in progress" : null;
      render();
    });
    document.addEventListener("keydown", (event) => {
      if (isEditorSaveShortcut(event) && !save.disabled) {
        event.preventDefault();
        save.click();
      }
    });
    render();
  }
</script>
