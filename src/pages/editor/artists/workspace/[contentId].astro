---
import ActionBar from "../../../../components/editor/ActionBar.astro";
import ArtistsDraftForm from "../../../../components/editor/ArtistsDraftForm.astro";
import ArtistsValidationPanel from "../../../../components/editor/ArtistsValidationPanel.astro";
import ArtistsDeletePanel from "../../../../components/editor/ArtistsDeletePanel.astro";
import RenamePanel from "../../../../components/editor/RenamePanel.astro";
import { createArtistsEditorDraft } from "../../../../editor/artists-draft-state";
import {
  readArtistsEditorEntry,
  readArtistsEditorState,
} from "../../../../editor/artists-state";
import EditorLayout from "../../../../layouts/EditorLayout.astro";
export async function getStaticPaths() {
  const state = await readArtistsEditorState();
  return Promise.all(
    state.entries.map(async ({ contentId }) => ({
      params: { contentId },
      props: { entry: await readArtistsEditorEntry(contentId) },
    })),
  );
}
const { entry } = Astro.props;
const draft = createArtistsEditorDraft(entry);
const serializedDraft = JSON.stringify(draft).replaceAll("<", "\\u003c");
---

<EditorLayout
  title={entry.data?.display_name ?? entry.data?.name ?? entry.contentId}
  section="Artists"
>
  <header class="editor-page-heading">
    <p class="editor-eyebrow">Artists workspace</p><h1>
      {entry.data?.display_name ?? entry.data?.name ?? entry.contentId}
    </h1><p>{entry.contentId} · Current flat Markdown</p>
  </header>
  <div class="editor-workspace">
    <main class="editor-panel editor-canvas">
      {
        draft ? (
          <ArtistsDraftForm draft={draft} />
        ) : (
          <p>
            Source cannot be represented as a Draft until validation issues are
            fixed.
          </p>
        )
      }
    </main><aside class="editor-workspace__sidebar">
      <ArtistsValidationPanel entry={entry} />
      <RenamePanel collection="artists" contentId={entry.contentId} />
      <ArtistsDeletePanel contentId={entry.contentId} />
    </aside>
  </div>
  <ActionBar mode="artists" loaded={Boolean(draft)} preview={false} />
</EditorLayout>
<script
  type="application/json"
  is:inline
  id="artists-editor-draft"
  set:html={serializedDraft}
/>
<script>
  import {
    isArtistsEditorDraftDirty,
    validateArtistsEditorDraft,
    type ArtistsEditorDraftState,
  } from "../../../../editor/artists-draft-state";
  import {
    editorFailureGuidance,
    isEditorSaveShortcut,
    renderFlatValidationPanel,
    worksWorkspaceUxState,
  } from "../../../../editor/ux";
  const raw = document.querySelector<HTMLScriptElement>(
    "#artists-editor-draft",
  )?.textContent;
  const form = document.querySelector<HTMLFormElement>(
    "[data-artists-draft-form]",
  );
  const save = document.querySelector<HTMLButtonElement>("[data-save-artists]");
  const preview = document.querySelector<HTMLButtonElement>(
    "[data-preview-artists]",
  );
  const publish = document.querySelector<HTMLButtonElement>(
    "[data-publish-artists]",
  );
  const status = document.querySelector<HTMLElement>(
    "[data-artists-action-status]",
  );
  if (raw && form && save && preview && publish && status) {
    let baseline = JSON.parse(raw) as ArtistsEditorDraftState;
    let draft = structuredClone(baseline);
    let pending: "save" | "preview" | "publish" | null = null;
    let savedSincePublish = false;
    let statusMessage: string | null = null;
    let recoveryRequired = false;
    let inputInvalid = false;
    let deleteLocked = false;
    const setActionReason = (action: string, reason: string) => {
      const container = document.querySelector<HTMLElement>(
        '[data-action="' + action + '"]',
      );
      const hint = container?.querySelector<HTMLElement>(
        "[data-action-reason]",
      );
      const actionButton =
        container?.querySelector<HTMLButtonElement>("button");
      if (hint) hint.textContent = reason;
      if (actionButton) actionButton.title = reason;
    };
    const optional = (value: string) => value.trim() || undefined;
    const read = () => {
      const data = new FormData(form);
      const value = (name: string) => String(data.get(name) ?? "");
      try {
        const layouts = JSON.parse(value("works_layout")) as Array<{
          layout: "single-a" | "single-b" | "double-a" | "double-b";
          works: string[];
        }>;
        draft = {
          ...draft,
          body: value("body"),
          data: {
            ...draft.data,
            name: value("name"),
            display_name: optional(value("display_name")),
            short_bio: value("short_bio"),
            biography: optional(value("biography")),
            medium: value("medium")
              .split("\n")
              .map((item) => item.trim())
              .filter(Boolean),
            hero: { image: value("hero.image") },
            hero_alt: value("hero_alt"),
            works_layout: layouts.length
              ? layouts.map((section) => ({
                  layout: section.layout,
                  works: section.works.map((id) => ({
                    id,
                    collection: "works" as const,
                  })),
                }))
              : undefined,
            seo_title: optional(value("seo_title")),
            description: optional(value("description")),
          },
        };
        inputInvalid = false;
      } catch {
        inputInvalid = true;
      }
    };
    const render = () => {
      const dirty = isArtistsEditorDraftDirty(baseline, draft) || inputInvalid;
      const validation = validateArtistsEditorDraft(draft);
      if (inputInvalid) {
        validation.issues = [
          {
            ruleId: "content.artist.works-layout-json",
            severity: "error",
            category: "structure",
            collection: "artists",
            contentId: draft.contentId,
            fieldPath: "works_layout",
            messageKey: "Works layout must be valid JSON",
            recovery: { kind: "edit-field", fieldPath: "works_layout" },
          },
        ];
        validation.capabilities = {
          save: false,
          preview: false,
          publish: false,
        };
      }
      const validated = validation.capabilities;
      const capabilities = {
        save: validated.save && !inputInvalid,
        preview: validated.preview && !inputInvalid,
        publish: validated.publish && !inputInvalid,
      };
      renderFlatValidationPanel(form, validation);
      const locked = pending !== null || recoveryRequired || deleteLocked;
      for (const control of form.elements)
        if (
          control instanceof HTMLInputElement ||
          control instanceof HTMLTextAreaElement ||
          control instanceof HTMLSelectElement
        )
          control.disabled = deleteLocked;
      save.disabled = locked || !dirty || !capabilities.save;
      preview.disabled = locked || !capabilities.preview;
      publish.disabled = locked || dirty || !capabilities.publish;
      form
        .querySelectorAll<
          HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement
        >("input, textarea, select")
        .forEach((control) => (control.disabled = locked));
      const ux = worksWorkspaceUxState({
        collectionName: "Artist",
        pending,
        dirty,
        canSave: capabilities.save,
        canPreview: capabilities.preview,
        canPublish: capabilities.publish,
        savedSincePublish,
        recoveryRequired,
        statusMessage: inputInvalid
          ? "Works layout must be valid JSON"
          : statusMessage,
      });
      status.textContent = ux.status;
      status.dataset.state = pending ? "pending" : dirty ? "dirty" : "saved";
      setActionReason("save", ux.saveTitle);
      setActionReason("preview", ux.previewTitle);
      setActionReason("publish", ux.publishTitle);
      window.dispatchEvent(
        new CustomEvent("editor:workspace-state", {
          detail: { locked: locked || dirty },
        }),
      );
    };
    const request = async (url: string, body: unknown) => {
      const response = await fetch(url, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(body),
      });
      const result = await response.json();
      if (!response.ok)
        throw Object.assign(new Error(result.error), { code: result.code });
      return result;
    };
    form.addEventListener("input", () => {
      read();
      statusMessage = null;
      render();
    });
    save.addEventListener("click", async () => {
      pending = "save";
      render();
      try {
        const result = await request(
          `/editor/api/artists/${encodeURIComponent(draft.contentId)}`,
          { draft, baseline },
        );
        baseline = result.draft;
        draft = structuredClone(baseline);
        savedSincePublish = true;
        statusMessage = "Saved · unpublished changes ready to publish";
      } catch (error) {
        const value = error as Error & { code?: string };
        statusMessage = `${value.message} ${editorFailureGuidance(value.code).message}`;
      } finally {
        pending = null;
        render();
      }
    });
    preview.addEventListener("click", async () => {
      pending = "preview";
      render();
      try {
        const result = await request("/editor/api/artists-preview/create", {
          draft,
        });
        window.open(result.url, "_blank", "noopener,noreferrer");
        statusMessage = "Draft preview opened";
      } catch (error) {
        const value = error as Error & { code?: string };
        statusMessage = `${value.message} ${editorFailureGuidance(value.code).message}`;
      } finally {
        pending = null;
        render();
      }
    });
    publish.addEventListener("click", async () => {
      pending = "publish";
      render();
      try {
        const result = await request(
          `/editor/api/artists-publish/${encodeURIComponent(draft.contentId)}`,
          {
            draft,
            baseline,
            dirty: isArtistsEditorDraftDirty(baseline, draft),
          },
        );
        recoveryRequired = result.state === "committed-push-failed";
        savedSincePublish = recoveryRequired;
        statusMessage =
          result.state === "published"
            ? `Published · ${result.commit.slice(0, 7)}`
            : `Committed · push failed · manual recovery required · ${result.error}`;
      } catch (error) {
        const value = error as Error & { code?: string };
        statusMessage = `${value.message} ${editorFailureGuidance(value.code).message}`;
      } finally {
        pending = null;
        render();
      }
    });
    window.addEventListener("editor:rename-complete", (event) => {
      const renamed = (
        event as CustomEvent<{ draft?: ArtistsEditorDraftState }>
      ).detail.draft;
      if (!renamed) return;
      baseline = renamed;
      draft = structuredClone(renamed);
      savedSincePublish = true;
      statusMessage =
        "Renamed · references updated · unpublished changes ready to publish";
      render();
    });
    window.addEventListener("editor:delete-state", (event) => {
      deleteLocked = Boolean(
        (event as CustomEvent<{ locked?: boolean }>).detail?.locked,
      );
      statusMessage = deleteLocked
        ? "Artists Delete operation in progress"
        : null;
      render();
    });
    document.addEventListener("keydown", (event) => {
      if (isEditorSaveShortcut(event) && !save.disabled) {
        event.preventDefault();
        save.click();
      }
    });
    read();
    baseline = structuredClone(draft);
    render();
  }
</script>
