---
import ActionBar from "../../../../components/editor/ActionBar.astro";
import ArtistsDraftForm from "../../../../components/editor/ArtistsDraftForm.astro";
import ArtistsValidationPanel from "../../../../components/editor/ArtistsValidationPanel.astro";
import ArtistsDeletePanel from "../../../../components/editor/ArtistsDeletePanel.astro";
import RenamePanel from "../../../../components/editor/RenamePanel.astro";
import {
  createArtistsEditorDraft,
  validateArtistsEditorDraft,
} from "../../../../editor/artists-draft-state";
import {
  readArtistsEditorEntry,
  readArtistsEditorState,
} from "../../../../editor/artists-state";
import EditorLayout from "../../../../layouts/EditorLayout.astro";
export async function getStaticPaths() {
  const state = await readArtistsEditorState();
  return Promise.all(
    state.entries.map(async ({ contentId }) => ({
      params: { contentId },
      props: { entry: await readArtistsEditorEntry(contentId) },
    })),
  );
}
const { entry } = Astro.props;
const draft = createArtistsEditorDraft(entry);
const initialCapabilities = draft
  ? validateArtistsEditorDraft(draft).capabilities
  : { localePreview: { ja: false, en: false } };
const serializedDraft = JSON.stringify(draft).replaceAll("<", "\\u003c");
---

<EditorLayout
  title={entry.data?.display_name ?? entry.data?.name ?? entry.contentId}
  section="Artists"
>
  <header class="editor-page-heading">
    <p class="editor-eyebrow">Artists workspace</p><h1>
      {entry.data?.display_name ?? entry.data?.name ?? entry.contentId}
    </h1><p>{entry.contentId} · Localized three-file draft</p>
  </header>
  <div class="editor-workspace">
    <main class="editor-panel editor-canvas">
      {
        draft ? (
          <ArtistsDraftForm draft={draft} />
        ) : (
          <p>
            Source cannot be represented as a Draft until validation issues are
            fixed.
          </p>
        )
      }
    </main><aside class="editor-workspace__sidebar">
      <ArtistsValidationPanel entry={entry} />
      <RenamePanel collection="artists" contentId={entry.contentId} />
      <ArtistsDeletePanel contentId={entry.contentId} />
    </aside>
  </div>
  <ActionBar
    mode="artists"
    loaded={Boolean(draft)}
    preview={initialCapabilities.localePreview}
  />
</EditorLayout>
<script
  type="application/json"
  is:inline
  id="artists-editor-draft"
  set:html={serializedDraft}
/>
<script>
  import {
    isArtistsEditorDraftDirty,
    validateArtistsEditorDraft,
    type ArtistsEditorDraftState,
  } from "../../../../editor/artists-draft-state";
  import {
    editorFailureGuidance,
    isEditorSaveShortcut,
    renderFlatValidationPanel,
    worksWorkspaceUxState,
  } from "../../../../editor/ux";
  import {
    commitEditorFormBaseline,
    restoreEditorDraftBaseline,
    restoreEditorFormBaseline,
  } from "../../../../editor/cancel";
  import type {
    ArtistsHeroAssetDraft,
    ArtistsHeroAssetMetadata,
  } from "../../../../editor/artists-hero-assets";
  const raw = document.querySelector<HTMLScriptElement>(
    "#artists-editor-draft",
  )?.textContent;
  const form = document.querySelector<HTMLFormElement>(
    "[data-artists-draft-form]",
  );
  const save = document.querySelector<HTMLButtonElement>("[data-save-artists]");
  const cancel = document.querySelector<HTMLButtonElement>(
    "[data-cancel-artists]",
  );
  const previews = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-preview-artists]"),
  ];
  const publish = document.querySelector<HTMLButtonElement>(
    "[data-publish-artists]",
  );
  const status = document.querySelector<HTMLElement>(
    "[data-artists-action-status]",
  );
  if (
    raw &&
    form &&
    save &&
    cancel &&
    previews.length === 2 &&
    publish &&
    status
  ) {
    let baseline = JSON.parse(raw) as ArtistsEditorDraftState;
    let draft = structuredClone(baseline);
    let pending: "save" | "preview" | "publish" | null = null;
    let savedSincePublish = false;
    let statusMessage: string | null = null;
    let recoveryRequired = false;
    let inputInvalid = false;
    let deleteLocked = false;
    const workspaceId = crypto.randomUUID();
    const temporaryArtistsHeroPreviewUrl = (
      contentId: string,
      workspace: string,
      token: string,
    ) =>
      `/editor/api/artists-hero-preview/${encodeURIComponent(contentId)}/${encodeURIComponent(workspace)}/${encodeURIComponent(token)}`;
    let heroAsset: ArtistsHeroAssetDraft = {
      kind: "existing",
      src: baseline.data.hero.image,
    };
    let pendingHeroCandidate: ArtistsHeroAssetMetadata | null = null;
    const hero = document.querySelector<HTMLElement>("[data-artists-hero]")!;
    const heroPath = hero.querySelector<HTMLInputElement>("[data-artists-hero-path]")!;
    const heroCurrent = hero.querySelector<HTMLElement>("[data-artists-hero-current]")!;
    const heroDrop = hero.querySelector<HTMLElement>("[data-artists-hero-drop]")!;
    const heroFile = hero.querySelector<HTMLInputElement>("[data-artists-hero-file]")!;
    const heroThumbnail = hero.querySelector<HTMLImageElement>("[data-artists-hero-thumbnail]")!;
    const heroState = hero.querySelector<HTMLElement>("[data-artists-hero-state]")!;
    const heroCanonicalPath = hero.querySelector<HTMLElement>("[data-artists-hero-canonical-path]")!;
    const heroConfirm = hero.querySelector<HTMLElement>("[data-artists-hero-confirm]")!;
    const heroNew = hero.querySelector<HTMLImageElement>("[data-artists-hero-new]")!;
    const heroStatus = hero.querySelector<HTMLElement>("[data-artists-hero-status]")!;
    const releaseHero = async (candidate: ArtistsHeroAssetMetadata | ArtistsHeroAssetDraft | null) => {
      if (!candidate || !("token" in candidate)) return;
      await fetch("/editor/api/artists-hero/release", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ token: candidate.token, contentId: draft.contentId, workspaceId }),
      }).catch(() => undefined);
    };
    const showHero = () => {
      const empty = heroAsset.kind === "empty";
      heroCurrent.hidden = empty;
      heroDrop.hidden = !empty;
      heroConfirm.hidden = pendingHeroCandidate === null;
      if (heroAsset.kind === "temporary") {
        heroThumbnail.src = temporaryArtistsHeroPreviewUrl(draft.contentId, workspaceId, heroAsset.token);
        heroState.textContent = heroAsset.replaces ? "Replacement pending · temporary / unsaved" : "New image · temporary / unsaved";
        heroCanonicalPath.textContent = heroAsset.proposedSrc;
      } else if (heroAsset.kind === "existing") {
        heroThumbnail.src = heroAsset.src;
        heroState.textContent = "Canonical · saved";
        heroCanonicalPath.textContent = heroAsset.src;
      }
    };
    const applyTemporary = (asset: ArtistsHeroAssetMetadata) => {
      heroAsset = {
        kind: "temporary",
        token: asset.token,
        workspaceId,
        proposedSrc: asset.proposedSrc,
        sha256: asset.sha256,
        ...(asset.replaces ? { replaces: asset.replaces } : {}),
      };
      heroPath.value = asset.proposedSrc;
      read();
      showHero();
      render();
    };
    const uploadHero = async (file: File) => {
      heroStatus.textContent = "Validating and staging image…";
      const body = new FormData();
      body.set("file", file);
      body.set("workspaceId", workspaceId);
      try {
        const response = await fetch(`/editor/api/artists-hero/upload/${encodeURIComponent(draft.contentId)}`, { method: "POST", body });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error);
        if (result.state === "reuse") {
          await releaseHero(heroAsset);
          await releaseHero(pendingHeroCandidate);
          pendingHeroCandidate = null;
          heroAsset = { kind: "existing", src: result.src };
          heroPath.value = result.src;
          read(); showHero(); render();
          heroStatus.textContent = "Identical canonical image reused";
        } else if (result.state === "replace-confirmation") {
          await releaseHero(pendingHeroCandidate);
          pendingHeroCandidate = result.asset;
          heroNew.src = temporaryArtistsHeroPreviewUrl(draft.contentId, workspaceId, result.asset.token);
          showHero();
          render();
          heroStatus.textContent = "Confirm replacement. Canonical image is unchanged.";
        } else {
          await releaseHero(heroAsset);
          await releaseHero(pendingHeroCandidate);
          pendingHeroCandidate = null;
          applyTemporary(result.asset);
          heroStatus.textContent = "Temporary image staged · Save to confirm";
        }
      } catch (error) {
        heroStatus.textContent = error instanceof Error ? error.message : "Hero upload failed";
      } finally { heroFile.value = ""; }
    };
    const setActionReason = (action: string, reason: string) => {
      const container = document.querySelector<HTMLElement>(
        '[data-action="' + action + '"]',
      );
      const hint = container?.querySelector<HTMLElement>(
        "[data-action-reason]",
      );
      const actionButton =
        container?.querySelector<HTMLButtonElement>("button");
      if (hint) hint.textContent = reason;
      if (actionButton) actionButton.title = reason;
    };
    const optional = (value: string) => value.trim() || undefined;
    const read = () => {
      const data = new FormData(form);
      const value = (name: string) => String(data.get(name) ?? "");
      try {
        const layouts = JSON.parse(value("works_layout")) as Array<{
          layout: "single-a" | "single-b" | "double-a" | "double-b";
          works: string[];
        }>;
        draft = {
          ...draft,
          body: "",
          locales: {
            ...draft.locales,
            en: {
              ...(draft.locales.en.state === "editable"
                ? draft.locales.en
                : {}),
              state: "editable",
              value: {
                name: value("en.name"),
                medium_label: value("en.medium_label"),
                short_bio: value("en.short_bio"),
                biography: optional(value("en.biography")),
                hero_alt: value("en.hero_alt"),
                seo_title: optional(value("en.seo_title")),
                description: optional(value("en.description")),
                body: "",
              },
            },
          },
          data: {
            ...draft.data,
            name: value("name"),
            display_name: optional(value("display_name")),
            medium_label: value("medium_label"),
            short_bio: value("short_bio"),
            biography: optional(value("biography")),
            medium: value("medium")
              .split("\n")
              .map((item) => item.trim())
              .filter(Boolean),
            hero: { image: value("hero.image") },
            hero_alt: value("hero_alt"),
            works_layout: layouts.length
              ? layouts.map((section) => ({
                  layout: section.layout,
                  works: section.works.map((id) => ({
                    id,
                    collection: "works" as const,
                  })),
                }))
              : undefined,
            seo_title: optional(value("seo_title")),
            description: optional(value("description")),
          },
        };
        inputInvalid = false;
      } catch {
        inputInvalid = true;
      }
    };
    const render = () => {
      const dirty = isArtistsEditorDraftDirty(baseline, draft) || inputInvalid || heroAsset.kind === "temporary" || pendingHeroCandidate !== null;
      const validation = validateArtistsEditorDraft(draft);
      if (inputInvalid) {
        validation.issues = [
          {
            ruleId: "content.artist.works-layout-json",
            severity: "error",
            category: "structure",
            collection: "artists",
            contentId: draft.contentId,
            fieldPath: "works_layout",
            messageKey: "Works layout must be valid JSON",
            recovery: { kind: "edit-field", fieldPath: "works_layout" },
          },
        ];
        validation.capabilities = {
          save: false,
          preview: false,
          localePreview: { ja: false, en: false },
          publish: false,
        };
      }
      const validated = validation.capabilities;
      const capabilities = {
        save: validated.save && !inputInvalid,
        preview: validated.preview && !inputInvalid,
        publish: validated.publish && !inputInvalid,
      };
      renderFlatValidationPanel(form, validation);
      const locked = pending !== null || recoveryRequired || deleteLocked;
      for (const control of form.elements)
        if (
          control instanceof HTMLInputElement ||
          control instanceof HTMLTextAreaElement ||
          control instanceof HTMLSelectElement
        )
          control.disabled = deleteLocked;
      save.disabled =
        locked ||
        !dirty ||
        !capabilities.save ||
        pendingHeroCandidate !== null;
      cancel.disabled = locked || !dirty;
      for (const preview of previews) {
        const locale = preview.dataset.previewArtists as "ja" | "en";
        preview.disabled =
          locked || !validation.capabilities.localePreview[locale];
      }
      publish.disabled = locked || dirty || !capabilities.publish;
      form
        .querySelectorAll<
          HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement
        >("input, textarea, select")
        .forEach((control) => (control.disabled = locked));
      const ux = worksWorkspaceUxState({
        collectionName: "Artist",
        pending,
        dirty,
        canSave: capabilities.save,
        canPreview:
          validation.capabilities.localePreview.ja ||
          validation.capabilities.localePreview.en,
        canPublish: capabilities.publish,
        savedSincePublish,
        recoveryRequired,
        statusMessage: inputInvalid
          ? "Works layout must be valid JSON"
          : statusMessage,
      });
      status.textContent = ux.status;
      status.dataset.state = pending ? "pending" : dirty ? "dirty" : "saved";
      setActionReason("save", ux.saveTitle);
      setActionReason("preview", ux.previewTitle);
      setActionReason("publish", ux.publishTitle);
      window.dispatchEvent(
        new CustomEvent("editor:workspace-state", {
          detail: { locked: locked || dirty },
        }),
      );
    };
    const request = async (url: string, body: unknown) => {
      const response = await fetch(url, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(body),
      });
      const result = await response.json();
      if (!response.ok)
        throw Object.assign(new Error(result.error), { code: result.code });
      return result;
    };
    form.addEventListener("input", () => {
      read();
      statusMessage = null;
      render();
    });
    hero.querySelector("[data-artists-hero-select]")?.addEventListener("click", () => heroFile.click());
    hero.querySelector("[data-artists-hero-replace]")?.addEventListener("click", () => heroFile.click());
    heroFile.addEventListener("change", () => { const file = heroFile.files?.[0]; if (file) void uploadHero(file); });
    heroDrop.addEventListener("dragover", (event) => { event.preventDefault(); heroDrop.classList.add("is-dragging"); });
    heroDrop.addEventListener("dragleave", () => heroDrop.classList.remove("is-dragging"));
    heroDrop.addEventListener("drop", (event) => {
      event.preventDefault(); heroDrop.classList.remove("is-dragging");
      const file = event.dataTransfer?.files[0]; if (file) void uploadHero(file);
    });
    hero.querySelector("[data-artists-hero-remove]")?.addEventListener("click", () => {
      void releaseHero(heroAsset);
      heroAsset = { kind: "empty", previousSrc: baseline.data.hero.image };
      heroPath.value = ""; read(); showHero(); render();
      heroStatus.textContent = "Hero reference removed from draft · select an image or Cancel";
    });
    hero.querySelector("[data-artists-hero-reject]")?.addEventListener("click", () => {
      void releaseHero(pendingHeroCandidate); pendingHeroCandidate = null; showHero();
      heroStatus.textContent = "Replacement canceled · canonical image unchanged";
      render();
    });
    hero.querySelector("[data-artists-hero-accept]")?.addEventListener("click", () => {
      if (!pendingHeroCandidate) return;
      const candidate = pendingHeroCandidate; pendingHeroCandidate = null;
      void releaseHero(heroAsset); applyTemporary(candidate);
      heroStatus.textContent = "Replacement staged · canonical image remains unchanged until Save";
    });
    cancel.addEventListener("click", () => {
      void releaseHero(heroAsset);
      void releaseHero(pendingHeroCandidate);
      pendingHeroCandidate = null;
      restoreEditorFormBaseline(form);
      draft = restoreEditorDraftBaseline(baseline);
      heroAsset = { kind: "existing", src: baseline.data.hero.image };
      heroPath.value = baseline.data.hero.image;
      inputInvalid = false;
      statusMessage = "Changes canceled · saved draft restored";
      heroStatus.textContent = "Temporary Hero changes canceled";
      showHero();
      render();
    });
    save.addEventListener("click", async () => {
      pending = "save";
      render();
      try {
        const result = await request(
          `/editor/api/artists/${encodeURIComponent(draft.contentId)}`,
          { draft, baseline, hero: heroAsset },
        );
        baseline = result.draft;
        draft = structuredClone(baseline);
        heroAsset = { kind: "existing", src: baseline.data.hero.image };
        pendingHeroCandidate = null;
        commitEditorFormBaseline(form);
        savedSincePublish = true;
        statusMessage = "Saved · unpublished changes ready to publish";
      } catch (error) {
        const value = error as Error & { code?: string };
        statusMessage = `${value.message} ${editorFailureGuidance(value.code).message}`;
      } finally {
        pending = null;
        render();
      }
    });
    for (const preview of previews)
      preview.addEventListener("click", async () => {
        const locale = preview.dataset.previewArtists as "ja" | "en";
        pending = "preview";
        render();
        try {
          const previewDraft = structuredClone(draft);
          if (heroAsset.kind === "temporary")
            previewDraft.data.hero.image = temporaryArtistsHeroPreviewUrl(draft.contentId, workspaceId, heroAsset.token);
          const result = await request("/editor/api/artists-preview/create", {
            draft: previewDraft,
            locale,
          });
          window.open(result.url, "_blank", "noopener,noreferrer");
          statusMessage = `${locale.toUpperCase()} draft preview opened`;
        } catch (error) {
          const value = error as Error & { code?: string };
          statusMessage = `${value.message} ${editorFailureGuidance(value.code).message}`;
        } finally {
          pending = null;
          render();
        }
      });
    publish.addEventListener("click", async () => {
      pending = "publish";
      render();
      try {
        const result = await request(
          `/editor/api/artists-publish/${encodeURIComponent(draft.contentId)}`,
          {
            draft,
            baseline,
            dirty: isArtistsEditorDraftDirty(baseline, draft),
          },
        );
        recoveryRequired = result.state === "committed-push-failed";
        savedSincePublish = recoveryRequired;
        statusMessage =
          result.state === "published"
            ? `Published · ${result.commit.slice(0, 7)}`
            : `Committed · push failed · manual recovery required · ${result.error}`;
      } catch (error) {
        const value = error as Error & { code?: string };
        statusMessage = `${value.message} ${editorFailureGuidance(value.code).message}`;
      } finally {
        pending = null;
        render();
      }
    });
    window.addEventListener("editor:rename-complete", (event) => {
      const renamed = (
        event as CustomEvent<{ draft?: ArtistsEditorDraftState }>
      ).detail.draft;
      if (!renamed) return;
      baseline = renamed;
      draft = structuredClone(renamed);
      savedSincePublish = true;
      statusMessage =
        "Renamed · references updated · unpublished changes ready to publish";
      render();
    });
    window.addEventListener("editor:delete-state", (event) => {
      deleteLocked = Boolean(
        (event as CustomEvent<{ locked?: boolean }>).detail?.locked,
      );
      statusMessage = deleteLocked
        ? "Artists Delete operation in progress"
        : null;
      render();
    });
    document.addEventListener("keydown", (event) => {
      if (isEditorSaveShortcut(event) && !save.disabled) {
        event.preventDefault();
        save.click();
      }
    });
    read();
    baseline = structuredClone(draft);
    showHero();
    render();
  }
</script>
