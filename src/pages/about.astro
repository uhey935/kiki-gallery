---
import { render } from "astro:content";
import { getAboutProductionFacade } from "../content-boundaries/about-production";
import { presentAboutHours } from "../content-loaders/about/hours-presenter";
import AboutView from "../components/AboutView.astro";
import Layout from "../layouts/Layout.astro";

const aboutFacade = await getAboutProductionFacade();
const about = aboutFacade.formal("ja") ?? aboutFacade.developmentJa();
const { Content } = await render(about);
const hours = presentAboutHours(about.data.hours, "ja");
---

<Layout
  title={about.data.seo_title ?? "About"}
  description={about.data.description}
>
  <AboutView
    locale="ja"
    contentStatus={about.data.content_status}
    hero={about.data.images.hero}
    gallery={about.data.images.gallery}
    address={about.data.address}
    hours={hours}
    contact={about.data.contact}
  >
    <Content slot="statement" />
  </AboutView>
</Layout>
