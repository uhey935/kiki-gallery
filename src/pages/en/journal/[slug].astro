---
import { render } from "astro:content";
import { journalRouteRegistry } from "../../../content-boundaries/journal";
import { getJournalProductionFacade } from "../../../content-boundaries/journal-production";
import Layout from "../../../layouts/Layout.astro";
import JournalDetailPresentation from "../../../components/JournalDetailPresentation.astro";
import { createJournalDetailPresentationModel } from "../../../components/journal-detail-presentation";

export async function getStaticPaths() {
  const journal = (await getJournalProductionFacade()).forDetail("en");
  return journal.map((item) => ({
    params: journalRouteRegistry.params({
      collection: "journal",
      contentId: item.data.contentId,
      locale: "en",
    }),
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const model = createJournalDetailPresentationModel({
  locale: "en",
  hero: item.data.hero,
  heroAlt: item.data.hero_alt,
  title: item.data.title,
  date: item.data.date,
});
---

<Layout
  title={item.data.title}
  description={item.data.summary}
  image={item.data.hero.image}
  locale="en"
>
  <JournalDetailPresentation {model}>
    <Content />
  </JournalDetailPresentation>
</Layout>
