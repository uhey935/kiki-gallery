---
import { render, type CollectionEntry } from "astro:content";
import { getAboutProductionFacade } from "../../content-boundaries/about-production.ts";
import { getHomeProductionFacade } from "../../content-boundaries/home-production.ts";
import { presentAboutHours } from "../../content-loaders/about/hours-presenter.ts";
import AboutView from "../../components/AboutView.astro";
import HomePresentation from "../../components/HomePresentation.astro";
import { createHomeMetadataModel } from "../../components/home-metadata.ts";
import { createHomePresentationModel } from "../../content-boundaries/home-composition.ts";
import Layout from "../../layouts/Layout.astro";

type Props =
  | { kind: "home"; entry: CollectionEntry<"homeThreeFile"> }
  | { kind: "about"; entry: CollectionEntry<"aboutThreeFile"> };

export async function getStaticPaths() {
  const about = (await getAboutProductionFacade()).formal("en");
  const home = (await getHomeProductionFacade()).formal("en");
  return [
    ...(home
      ? [
          {
            params: { singleton: undefined },
            props: { kind: "home" as const, entry: home },
          },
        ]
      : []),
    ...(about
      ? [
          {
            params: { singleton: "about" },
            props: { kind: "about" as const, entry: about },
          },
        ]
      : []),
  ];
}

const props = Astro.props as Props;
const home = props.kind === "home" ? props.entry : undefined;
const about = props.kind === "about" ? props.entry : undefined;
const rendered = about ? await render(about) : undefined;
const AboutContent = rendered?.Content;
const hours = about ? presentAboutHours(about.data.hours, "en") : undefined;
const homePresentation = home
  ? await createHomePresentationModel("en", home.data, home.data)
  : undefined;
const homeMetadata = home
  ? createHomeMetadataModel(home.data, home.data)
  : undefined;
---

{
  home ? (
    <Layout
      locale="en"
      flush={true}
      title={homeMetadata!.title}
      description={homeMetadata!.description}
      image={homeMetadata!.image}
    >
      <HomePresentation {...homePresentation!} />
    </Layout>
  ) : about && AboutContent ? (
    <Layout
      locale="en"
      title={about.data.seo_title ?? "About"}
      description={about.data.description}
    >
      <AboutView
        locale="en"
        contentStatus={about.data.content_status}
        hero={about.data.images.hero}
        gallery={about.data.images.gallery}
        address={about.data.address}
        hours={hours}
        contact={about.data.contact}
      >
        <AboutContent slot="statement" />
      </AboutView>
    </Layout>
  ) : null
}
