---
import { getArtistsProductionFacade } from "../../../content-boundaries/artists-production";
import Layout from "../../../layouts/Layout.astro";
import { getExhibitionsProductionFacade } from "../../../content-boundaries/exhibitions-production";

export async function getStaticPaths() {
  return (await getArtistsProductionFacade()).forLocale("en").map((artist) => ({
    params: { slug: artist.id },
    props: { artist },
  }));
}

const { artist } = Astro.props;
const exhibitionsFacade = await getExhibitionsProductionFacade();
const exhibitions = exhibitionsFacade.forArtist(artist.id, "en");
---

<Layout
  title={artist.data.seo_title ?? artist.data.name}
  description={artist.data.description ?? artist.data.short_bio}
>
  <article>
    <section class="section artists-intro">
      <div class="artists-intro__left">
        <h1 class="artists-h1-title">{artist.data.name}</h1>
        <p class="artists-intro__medium">
          {artist.data.medium.join(", ")}
        </p>
      </div>
      <div class="artists-intro__right">
        <p class="artists-bio-short">{artist.data.short_bio}</p>
      </div>
    </section>
    {
      artist.data.biography && (
        <section class="section artists-bio">
          <h2 class="detail-h2-title">Biography</h2>
          <div class="artists-bio-layout">
            <div class="artists-bio-image">
              <img
                src={artist.data.hero.image}
                alt={artist.data.hero_alt}
                width="400"
              />
            </div>
            <p class="artists-bio-text">{artist.data.biography}</p>
          </div>
        </section>
      )
    }
    {
      exhibitions.length > 0 && (
        <section class="section artists-exhibitions">
          <h2 class="detail-h2-title">Exhibitions</h2>
          <div class="artists-exhibitions-list">
            {exhibitions.map((exhibition) => (
              <article class="artists-exhibitions-card">
                <a href={exhibitionsFacade.detailRoute(exhibition.id, "en")}>
                  <div class="artists-exhibitions-card-image">
                    <img
                      src={exhibition.data.hero.image}
                      alt={exhibition.data.hero_alt}
                    />
                  </div>
                  <div class="artists-exhibitions-card-meta">
                    <h3 class="artists-exhibitions-card-title">
                      {exhibition.data.title}
                    </h3>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </section>
      )
    }
  </article>
</Layout>
