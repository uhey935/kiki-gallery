---
import ArtistDetailPresentation from "../../../components/ArtistDetailPresentation.astro";
import { getArtistsProductionFacade } from "../../../content-boundaries/artists-production";
import { getExhibitionsProductionFacade } from "../../../content-boundaries/exhibitions-production";
import { getWorksProductionFacade } from "../../../content-boundaries/works-production";
import Layout from "../../../layouts/Layout.astro";

export async function getStaticPaths() {
  return (await getArtistsProductionFacade()).forLocale("en").map((artist) => ({
    params: { slug: artist.id },
    props: { artist },
  }));
}

const { artist } = Astro.props;
const worksFacade = await getWorksProductionFacade();
const workById = new Map(
  worksFacade.forLocale("en").map((work) => [work.contentId, work]),
);
const workSections = (artist.data.works_layout ?? []).flatMap((section) => {
  const works = section.works.flatMap((reference) => {
    const work = workById.get(reference.id);
    if (!work || work.data.artist !== artist.id) return [];
    return [
      {
        contentId: work.contentId,
        href: worksFacade.detailRoute(work.contentId, "en")!,
        image: { src: work.data.images[0].src, alt: work.data.images[0].alt },
        title: work.data.title,
      },
    ];
  });
  return works.length ? [{ layout: section.layout, works }] : [];
});

const exhibitionsFacade = await getExhibitionsProductionFacade();
const exhibitions = exhibitionsFacade
  .forArtist(artist.id, "en")
  .map((exhibition) => ({
    contentId: exhibition.contentId,
    href: exhibitionsFacade.detailRoute(exhibition.id, "en")!,
    image: { src: exhibition.data.hero.image, alt: exhibition.data.hero_alt },
    title: exhibition.data.title,
  }));
---

<Layout
  title={artist.data.seo_title ?? artist.data.name}
  description={artist.data.description ?? artist.data.short_bio}
  locale="en"
>
  <ArtistDetailPresentation
    locale="en"
    artist={{
      contentId: artist.contentId,
      name: artist.data.name,
      mediumLabel: artist.data.medium_label,
      shortBio: artist.data.short_bio,
      biography: artist.data.biography,
      hero: { src: artist.data.hero.image, alt: artist.data.hero_alt },
    }}
    {workSections}
    {exhibitions}
  />
</Layout>
