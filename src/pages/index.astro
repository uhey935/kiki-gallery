---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { formatDateRangeJa } from "../utils/date";

const exhibitions = await getCollection("exhibitions");
const artists = await getCollection("artists");

const artistMap = new Map(artists.map((a) => [a.id, a.data]));

const SEPARATOR = "、";
const HERO_FALLBACK_FIRST = true;// false = 個展ファースト, true = fallbackファースト

const getArtistDisplayNames = (artistIds: string[] | string | undefined) => {
  const ids = Array.isArray(artistIds)
    ? artistIds
    : artistIds
      ? [artistIds]
      : [];

  return ids
    .map((id) => {
      const data = artistMap.get(id);
      return data?.nameJa || data?.name || id;
    })
    .filter(Boolean);
};

const getDisplayTitle = (title: string | undefined, names: string[]) => {
  if (title && title.trim() !== "") return title;
  if (names.length === 0) return "Exhibition";

  return names.length > 1
    ? `${names.join(SEPARATOR)} 合同展`
    : `${names[0]} 個展`;
};

const parseDate = (date: string | undefined) => {
  if (!date) return null;

  const [year, month, day] = date.split("-").map(Number);

  return new Date(year, month - 1, day);
};

const today = new Date();
today.setHours(0, 0, 0, 0);

const getStatus = (start: Date | null, end: Date | null) => {
  if (!start) return "past";

  const compare = new Date(end ?? start);
  compare.setHours(23, 59, 59, 999);

  if (start > today) return "upcoming";
  if (compare >= today) return "ongoing";

  return "past";
};

const formattedExhibitions = exhibitions
  .map((exh) => {
    const names = getArtistDisplayNames(exh.data.artist);
    const startDate = parseDate(exh.data.date);
    const endDate = parseDate(exh.data.end_date);

    return {
      ...exh,
      artistNames: names,
      displayTitle: getDisplayTitle(exh.data.title, names),
      status: getStatus(startDate, endDate),
      startDate,
      endDate,
    };
  })
  .sort((a, b) => {
    if (!a.startDate) return 1;
    if (!b.startDate) return -1;

    return b.startDate.getTime() - a.startDate.getTime();
  });



const heroExhibition = HERO_FALLBACK_FIRST
  ? null
  : formattedExhibitions.find((exh) => exh.status === "ongoing") ||
    formattedExhibitions.find((exh) => exh.status === "upcoming") ||
    null;

const ongoingExhibitions = formattedExhibitions.filter(
  (exh) => exh.status === "ongoing",
);

const upcomingExhibitions = formattedExhibitions.filter(
  (exh) => exh.status === "upcoming",
);

const pastExhibitions = formattedExhibitions.filter(
  (exh) => exh.status === "past",
);

const homeExhibitions = [
  ...ongoingExhibitions,
  ...upcomingExhibitions,
  ...pastExhibitions,
].slice(0, 2);
---

<Layout flush={true}>
  <div class="home">
    <section
      class:list={[
        "home-hero",
        {
          "home-hero--light": heroExhibition?.data.hero_text_color === "light",

          "home-hero--dark": heroExhibition?.data.hero_text_color === "dark",
        },
      ]}
    >
      {
        heroExhibition ? (
          <a href={`/exhibitions/${heroExhibition.id}`} class="home-hero__link">
            <figure class="home-hero__media">
              <img
                src={
                  heroExhibition.data.hero_media ||
                  heroExhibition.data.image ||
                  "/images/home/fallback-hero.webp"
                }
                alt={heroExhibition.displayTitle}
              />
            </figure>

            <div
              class:list={[
                "home-hero__content",
                {
                  "home-hero__content--left-center":
                    heroExhibition?.data.hero_text_position === "left-center",

                  "home-hero__content--right-bottom":
                    heroExhibition?.data.hero_text_position === "right-bottom",

                  "home-hero__content--right-center":
                    heroExhibition?.data.hero_text_position === "right-center",
                },
              ]}
            >
              <p class="home-hero__artist">
                {heroExhibition.artistNames.join(SEPARATOR)}
              </p>

              <h1 class="home-hero__title">{heroExhibition.displayTitle}</h1>

              <p class="home-hero__date">
                {heroExhibition.data.date
                  ? formatDateRangeJa(
                      heroExhibition.data.date,
                      heroExhibition.data.end_date,
                    )
                  : ""}
              </p>
            </div>
          </a>
        ) : (
          <div class="home-hero__fallback">
            <img
              src="/images/home/fallback-hero.webp"
              alt="KiKi Gallery"
              class="home-hero__fallback-image"
            />

            <div class="home-hero__content">
              <h1 class="home-hero__title">KiKi Gallery</h1>
            </div>
          </div>
        )
      }
    </section>

    <section class="home-exhibition" aria-labelledby="home-exhibition-heading">
      <div class="home-exhibition__inner">
        <h2 id="home-exhibition-heading" class="home-exhibition__heading">
          Exhibition
        </h2>

        <div class="home-exhibition__list">
          {
            homeExhibitions.map((exhibition) => {
              const dateString = exhibition.data.date
                ? formatDateRangeJa(
                    exhibition.data.date,
                    exhibition.data.end_date,
                  )
                : "";

              return (
                <article class="home-exhibition__item">
                  <a
                    href={`/exhibitions/${exhibition.id}`}
                    class="home-exhibition__link"
                  >
                    <figure class="home-exhibition__media">
                      <img
                        src={exhibition.data.image}
                        alt={exhibition.displayTitle}
                      />
                    </figure>

                    <div class="home-exhibition__content">
                      <p class="home-exhibition__artist">
                        {exhibition.artistNames.join(SEPARATOR)}
                      </p>

                      <h3 class="home-exhibition__title">
                        {exhibition.displayTitle}
                      </h3>

                      <p class="home-exhibition__date">{dateString}</p>
                    </div>
                  </a>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>
  </div>
</Layout>
