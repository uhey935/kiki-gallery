---
import HomePresentation from "../components/HomePresentation.astro";
import { createHomeMetadataModel } from "../components/home-metadata.ts";
import { createHomePresentationModel } from "../content-boundaries/home-composition.ts";
import { getHomeProductionFacade } from "../content-boundaries/home-production.ts";
import Layout from "../layouts/Layout.astro";

const homeFacade = await getHomeProductionFacade();
const home = homeFacade.formal("ja");
if (!home) throw new Error("JA Home is not formally capable");
const presentation = await createHomePresentationModel(
  "ja",
  home.data,
  home.data,
);
const metadata = createHomeMetadataModel(home.data, home.data);
---

<Layout
  title={metadata.title}
  description={metadata.description}
  image={metadata.image}
  flush={true}
>
  <HomePresentation {...presentation} />
</Layout>
