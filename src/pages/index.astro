---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getWeekday } from "../utils/date";
import {
  getArtistDisplayName,
  getExhibitionDisplayTitle,
  resolveExhibitionArtists,
} from "../utils/exhibitionDisplay";
import { getExhibitionStatus } from "../utils/exhibitionStatus";
import { resolveNewsImage } from "../utils/resolveNewsImage";
import { journalRouteRegistry } from "../content-boundaries/journal";
import { getJournalProductionFacade } from "../content-boundaries/journal-production";

/* =========================
   Home
========================= */

const [home] = await getCollection("home");

if (!home) {
  throw new Error("Missing home content.");
}

/* =========================
   Collections
========================= */

const exhibitions = await getCollection("exhibitions");
const artists = await getCollection("artists");
const journal = await getJournalProductionFacade();
const news = await getCollection("news");

/* =========================
   Helpers
========================= */

const artistMap = new Map(artists.map((artist) => [artist.id, artist]));
const newsImageCollections = {
  exhibitions: new Map(
    exhibitions.map((exhibition) => [exhibition.id, exhibition]),
  ),
  artists: artistMap,
  journal: journal.forNewsIntegration("ja"),
};

const SEPARATOR = "、";
const homeHeroMedia = home.data.home_hero?.media;

const parseDate = (date: string | undefined) => {
  if (!date) return null;

  const [year, month, day] = date.split("-").map(Number);

  return new Date(year, month - 1, day);
};

/* =========================
   Exhibitions
========================= */

const formattedExhibitions = exhibitions
  .map((exh) => {
    const resolvedArtists = resolveExhibitionArtists(exh, artistMap);
    const artistNames = resolvedArtists.map(getArtistDisplayName);
    const startDate = exh.data.start_date;
    const endDate = exh.data.end_date;

    return {
      ...exh,
      artistNames,
      displayTitle: getExhibitionDisplayTitle(exh, resolvedArtists),
      status: getExhibitionStatus(startDate, endDate),
      startDate,
      endDate,
      startDateValue: startDate.toISOString().slice(0, 10),
      endDateValue: endDate.toISOString().slice(0, 10),
    };
  })
  .sort((a, b) => {
    return b.startDate.getTime() - a.startDate.getTime();
  });

const ongoingExhibitions = formattedExhibitions.filter(
  (exh) => exh.status === "ongoing",
);

const upcomingExhibitions = formattedExhibitions.filter(
  (exh) => exh.status === "upcoming",
);

const pastExhibitions = formattedExhibitions.filter(
  (exh) => exh.status === "past",
);

const homeExhibitions = [
  ...ongoingExhibitions,
  ...upcomingExhibitions,
  ...pastExhibitions,
].slice(0, 2);

/* =========================
   Stories
========================= */

const newsStories = news
  .filter((item) => item.data.show_on_home === true && item.data.link)
  .map((item) => {
    const image = resolveNewsImage(item, newsImageCollections);

    if (!image || !item.data.link) return null;

    return {
      id: item.id,
      title: item.data.title,
      date: item.data.date,
      type: item.data.news_type,
      image: image.image,
      alt: image.alt,
      href: item.data.link,
    };
  })
  .filter((item) => item !== null);

const journalStories = journal
  .forHomeStories("ja")
  .filter((item) => item.data.hero.image && item.data.categories?.length)
  .map((item) => ({
    id: item.data.contentId,
    title: item.data.title,
    date: item.data.date,
    type: item.data.categories?.[0],
    image: item.data.hero.image,
    alt: item.data.hero_alt,
    href: journalRouteRegistry.build({
      collection: "journal",
      contentId: item.data.contentId,
      locale: "ja",
    }),
  }));

const stories = [...newsStories, ...journalStories]
  .sort((a, b) => {
    const aDate = parseDate(a.date);
    const bDate = parseDate(b.date);

    if (!aDate) return 1;
    if (!bDate) return -1;

    return bDate.getTime() - aDate.getTime();
  })
  .slice(0, 6);

const artistsSection = home.data.sections.find(
  (section) => section.id === "artists",
);

const aboutSection = home.data.sections.find(
  (section) => section.id === "about",
);

if (!artistsSection || !aboutSection) {
  throw new Error("Missing home sections.");
}
---

<Layout flush={true}>
  <div class="home">
    <section class="home-hero">
      <div class="home-hero__fallback">
        <div class="home-hero__fallback-image-wrap">
          {
            homeHeroMedia?.type === "video" ? (
              <video
                src={homeHeroMedia.video}
                poster={homeHeroMedia.poster}
                class="home-hero__fallback-image"
                autoplay
                muted
                loop
                playsinline
              />
            ) : (
              <img
                src={
                  homeHeroMedia?.type === "image"
                    ? homeHeroMedia.image
                    : "/images/home/fallback-hero.webp"
                }
                alt="KiKi Gallery"
                class="home-hero__fallback-image"
              />
            )
          }

          <span class="home-hero__cover home-hero__cover--1"></span>
          <span class="home-hero__cover home-hero__cover--2"></span>
          <span class="home-hero__cover home-hero__cover--3"></span>
        </div>

        <div class="home-hero__content">
          <h1 class="home-hero__title">KiKi Gallery</h1>
        </div>
      </div>
    </section>

    <section class="home-exhibition" aria-labelledby="home-exhibition-heading">
      <div class="home-exhibition__inner">
        <header class="home-section__header">
          <h2 id="home-exhibition-heading" class="home-section__heading">
            Exhibitions
          </h2>

          <a class="home-section__action" href="/exhibitions/"> View All </a>
        </header>

        <div class="home-exhibition__list">
          {
            homeExhibitions.map((exhibition) => {
              return (
                <article class="home-exhibition__item">
                  <a
                    href={`/exhibitions/${exhibition.id}`}
                    class="home-exhibition__link"
                  >
                    <div class="home-exhibition__image">
                      <figure class="home-exhibition__media">
                        <img
                          src={exhibition.data.hero.image}
                          alt={exhibition.data.hero_alt}
                        />
                      </figure>

                      <span
                        class={`home-exhibition__status home-exhibition__status--${exhibition.status}`}
                      >
                        {exhibition.status}
                      </span>
                    </div>

                    <div class="home-exhibition__content">
                      <div class="home-exhibition__heading-row">
                        <div class="home-exhibition__heading-left">
                          {exhibition.data.display_artists !== false && (
                            <p class="home-exhibition__artist">
                              {exhibition.artistNames.join(SEPARATOR)}
                            </p>
                          )}

                          <h3 class="home-exhibition__title">
                            {exhibition.displayTitle}
                          </h3>
                        </div>

                        <p class="home-exhibition__date">
                          <span class="home-exhibition__date-value">
                            {`${exhibition.startDate.getFullYear()}.${String(exhibition.startDate.getMonth() + 1).padStart(2, "0")}.${String(exhibition.startDate.getDate()).padStart(2, "0")}`}
                          </span>

                          <span class="home-exhibition__date-weekday">
                            {getWeekday(exhibition.startDateValue)}
                          </span>

                          <span class="home-exhibition__date-separator">
                            {" "}
                            -{" "}
                          </span>

                          <span class="home-exhibition__date-value">
                            {`${String(exhibition.endDate.getMonth() + 1).padStart(2, "0")}.${String(exhibition.endDate.getDate()).padStart(2, "0")}`}
                          </span>

                          <span class="home-exhibition__date-weekday">
                            {getWeekday(exhibition.endDateValue)}
                          </span>
                        </p>
                      </div>
                    </div>
                  </a>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>

    <section class="home-sections">
      <div class="home-sections__inner">
        <div class="home-sections__artists">
          <h2 class="home-sections__artists-title">
            {artistsSection.title}
          </h2>

          <a href={artistsSection.href} class="home-sections__link">
            <figure class="home-sections__artists-media home-sections__media">
              <img src={artistsSection.image.square} alt="" />
            </figure>
          </a>
        </div>

        <div class="home-sections__about">
          <a href={aboutSection.href} class="home-sections__link">
            <figure class="home-sections__about-media home-sections__media">
              <img src={aboutSection.image.landscape} alt="" />
            </figure>

            <h2 class="home-sections__about-title">
              {aboutSection.title}
            </h2>

            <p class="home-sections__description">
              GALLERY
              crossingは2017年岐阜県美濃加茂市にオープンしたアートギャラリーです。ギャラリーの位置する旧中山道・太田宿は、江戸時代には宿場町として栄え、並行して流れる木曽川と共に、人と物のクロスポイントとなる場所でした。
              <span class="home-sections__learn-more">Learn More</span>
            </p>
          </a>
        </div>
      </div>
    </section>

    <section class="home-stories" aria-labelledby="home-stories-heading">
      <div class="home-stories__inner">
        <header class="home-section__header">
          <h2 id="home-stories-heading" class="home-section__heading">
            Stories
          </h2>

          <a class="home-section__action" href="/journal/"> View All </a>
        </header>

        <div class="home-stories__list">
          {
            stories.map((story) => (
              <article class="home-stories__item">
                <a href={story.href} class="home-stories__link">
                  <figure class="home-stories__media">
                    <img src={story.image} alt={story.alt} loading="lazy" />
                  </figure>

                  <div class="home-stories__body">
                    {story.type && (
                      <p class="home-stories__kind">{story.type}</p>
                    )}

                    <h3 class="home-stories__title">{story.title}</h3>
                  </div>
                </a>
              </article>
            ))
          }
        </div>

        <div class="home-stories__progress" aria-hidden="true">
          <div class="home-stories__progress-bar"></div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  /* =========================
     Home Sections Fade
  ========================= */

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      });
    },
    {
      threshold: 0.1,
    },
  );

  document
    .querySelectorAll(".home-sections__media")
    .forEach((element) => observer.observe(element));

  /* =========================
   Stories Progress
========================= */

  const mediaQuery = window.matchMedia("(max-width: 767px)");

  if (mediaQuery.matches) {
    const storiesList = document.querySelector<HTMLElement>(
      ".home-stories__list",
    );

    const progressBar = document.querySelector<HTMLElement>(
      ".home-stories__progress-bar",
    );

    if (storiesList && progressBar) {
      const updateProgress = () => {
        const maxScroll = storiesList.scrollWidth - storiesList.clientWidth;

        const progress = maxScroll > 0 ? storiesList.scrollLeft / maxScroll : 0;

        const scale = 0.25 + progress * 0.75;

        progressBar.style.transform = `scaleX(${scale})`;
      };

      updateProgress();

      storiesList.addEventListener("scroll", updateProgress);
      window.addEventListener("resize", updateProgress);
    }
  }

  /* =========================
   Home Sections Parallax
========================= */

  const homeSections = document.querySelector<HTMLElement>(".home-sections");
  const aboutSection = document.querySelector<HTMLElement>(
    ".home-sections__about",
  );

  if (homeSections && aboutSection) {
    let ticking = false;

    const updateParallax = () => {
      const rect = homeSections.getBoundingClientRect();
      const viewportHeight = window.innerHeight;

      // セクションが画面外ならリセット
      if (rect.bottom <= 0 || rect.top >= viewportHeight) {
        aboutSection.style.transform = "";
        ticking = false;
        return;
      }

      // セクション内での進行度（0〜1）
      const startOffset = viewportHeight * 0.3;

      const progress = Math.min(
        Math.max(
          (viewportHeight - rect.top - startOffset) /
            (viewportHeight + rect.height - startOffset),
          0,
        ),
        1,
      );

      // Aboutのみパララックス（上方向）
      aboutSection.style.transform = `translateY(${-progress * 97}px)`;

      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(updateParallax);
        ticking = true;
      }
    };

    window.addEventListener("scroll", onScroll);
    window.addEventListener("resize", onScroll);

    onScroll();
  }
</script>
