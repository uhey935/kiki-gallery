---
import "../../styles/works.css";

import WorkLayout from "../../layouts/WorkLayout.astro";

import { render } from "astro:content";
import { getWorksProductionFacade } from "../../content-boundaries/works-production";

export async function getStaticPaths() {
  const works = (await getWorksProductionFacade()).forLocale("ja");
  return works.map((work) => {
    return {
      params: {
        slug: work.contentId,
      },
      props: {
        work,
        artist: work.artist,
      },
    };
  });
}

const { work, artist } = Astro.props;
const artistName = artist.data.display_name ?? artist.data.name;

const { Content } = await render(work);

const hasStatement = (work.body ?? "").trim().length > 0;

const workTitle = work.data.title;
const description = `${workTitle} | KiKi Gallery`;

const artistHref = `/artists/${artist.id}/`;

const inquiry = work.data.inquiry;
const showInquiry = inquiry.type !== "none";
const inquiryLabel = inquiry.type === "shop" ? "Shop" : "Inquire";
const inquiryHref = "url" in inquiry ? inquiry.url : undefined;

const images = work.data.images;

const isSingleLandscape =
  images.length === 1 && work.data.orientation === "landscape";
---

<WorkLayout title={workTitle} description={description}>
  <button class="works-detail-close" type="button" aria-label="Close viewer">
    <svg
      width="18"
      height="18"
      viewBox="0 0 18 18"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        d="M4 4L14 14"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"></path>
      <path
        d="M14 4L4 14"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"></path>
    </svg>
  </button>
  <main
    class:list={["works-detail", { "works-detail--single": isSingleLandscape }]}
  >
    {
      isSingleLandscape ? (
        <section class="works-detail-section works-detail-section--single">
          <figure class="works-detail-image">
            <img
              src={images[0].src}
              alt={images[0].alt ?? workTitle}
              decoding="async"
              fetchpriority="high"
              loading="eager"
            />
          </figure>

          <div class="works-detail-meta">
            <h1 class="works-detail-title">{workTitle}</h1>

            <p class="works-detail-artist">
              <a href={artistHref}>{artistName}</a>
            </p>

            <dl class="works-detail-information">
              {work.data.material && (
                <>
                  <dt>Material</dt>
                  <dd>{work.data.material}</dd>
                </>
              )}

              {work.data.size && (
                <>
                  <dt>Size</dt>
                  <dd>{work.data.size}</dd>
                </>
              )}

              {work.data.year && (
                <>
                  <dt>Year</dt>
                  <dd>{work.data.year}</dd>
                </>
              )}
            </dl>

            {hasStatement && (
              <div class="works-detail-statement">
                <Content />
              </div>
            )}

            {showInquiry && (
              <p class="works-detail-inquiry">
                {inquiryHref ? (
                  <a href={inquiryHref} class="action-link">
                    {inquiryLabel}
                  </a>
                ) : (
                  <span class="action-link">{inquiryLabel}</span>
                )}
              </p>
            )}
          </div>
        </section>
      ) : (
        <>
          {images.map((image, index) => (
            <section class="works-detail-section">
              <figure class="works-detail-image">
                <img
                  src={image.src}
                  alt={image.alt ?? workTitle}
                  decoding="async"
                  fetchpriority={index === 0 ? "high" : undefined}
                  loading={index >= 3 ? "lazy" : undefined}
                />
              </figure>
            </section>
          ))}

          <section class="works-detail-section">
            <div class="works-detail-meta">
              <h1 class="works-detail-title">{workTitle}</h1>

              <p class="works-detail-artist">
                <a href={artistHref}>{artistName}</a>
              </p>

              <dl class="works-detail-information">
                {work.data.material && (
                  <>
                    <dt>Material</dt>
                    <dd>{work.data.material}</dd>
                  </>
                )}

                {work.data.size && (
                  <>
                    <dt>Size</dt>
                    <dd>{work.data.size}</dd>
                  </>
                )}

                {work.data.year && (
                  <>
                    <dt>Year</dt>
                    <dd>{work.data.year}</dd>
                  </>
                )}
              </dl>

              {hasStatement && (
                <div class="works-detail-statement">
                  <Content />
                </div>
              )}

              {showInquiry && (
                <p class="works-detail-inquiry">
                  {inquiryHref ? (
                    <a href={inquiryHref} class="action-link">
                      {inquiryLabel}
                    </a>
                  ) : (
                    <span class="action-link">{inquiryLabel}</span>
                  )}
                </p>
              )}
            </div>
          </section>
        </>
      )
    }
  </main>
</WorkLayout>

<script define:vars={{ artistHref }}>
  const worksDetail = document.querySelector(".works-detail");
  const closeButton = document.querySelector(".works-detail-close");

  requestAnimationFrame(() => {
    worksDetail?.classList.add("is-ready");
  });

  closeButton?.addEventListener("click", () => {
    if (document.referrer.includes("/artists/")) {
      history.back();
      return;
    }

    window.location.assign(artistHref);
  });
</script>
