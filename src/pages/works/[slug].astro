---
import "../../styles/works.css";

import WorkLayout from "../../layouts/WorkLayout.astro";

import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const works = await getCollection("works");
  const artists = await getCollection("artists");

  return works.map((work) => {
    const artist = artists.find((a) => a.id === work.data.artist);

    return {
      params: {
        slug: work.id,
      },
      props: {
        work,
        artistName:
          artist?.data.nameJa ?? artist?.data.name ?? work.data.artist,
        artistHref: `/artists/${work.data.artist}`,
      },
    };
  });
}

const { work, artistName, artistHref } = Astro.props;
const { Content } = await render(work);
const hasStatement = (work.body ?? "").trim().length > 0;

const workTitle = work.data.title;

const description = `${workTitle} | KiKi Gallery`;

const inquiryHref = "mailto:info@kiki-gallery.com";
---

<WorkLayout title={workTitle} description={description}>
  <button class="works-detail-close" type="button" aria-label="Close viewer">
    <svg
      width="18"
      height="18"
      viewBox="0 0 18 18"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        d="M4 4L14 14"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"></path>
      <path
        d="M14 4L4 14"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"></path>
    </svg>
  </button>
  <main class="works-detail">
    <section class="works-detail-section">
      <figure class="works-detail-image">
        <img src={work.data.image} alt={work.data.alt ?? workTitle} />
      </figure>
    </section>

    <section class="works-detail-section">
      <div class="works-detail-meta">
        <h1 class="works-detail-title">{workTitle}</h1>

        <p class="works-detail-artist">
          <a href={artistHref}>
            {artistName}
          </a>
        </p>

        <dl class="works-detail-information">
          {
            work.data.material && (
              <>
                <dt>Material</dt>
                <dd>{work.data.material}</dd>
              </>
            )
          }

          {
            work.data.size && (
              <>
                <dt>Size</dt>
                <dd>{work.data.size}</dd>
              </>
            )
          }

          {
            work.data.year && (
              <>
                <dt>Year</dt>
                <dd>{work.data.year}</dd>
              </>
            )
          }
        </dl>

        {
          hasStatement && (
            <div class="works-detail-statement">
              <Content />
            </div>
          )
        }

        {
          work.data.inquiry && (
            <p class="works-detail-inquiry">
              <a href={inquiryHref}>Inquire</a>
            </p>
          )
        }
      </div>
    </section>
  </main>
</WorkLayout>

<script define:vars={{ artistHref }}>
  const closeButton = document.querySelector(".works-detail-close");

  closeButton?.addEventListener("click", () => {
    window.location.assign(artistHref);
  });
</script>
