---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

// 1. 型定義
type NewsItem = {
  id: string;
  href: string | null;
  title: string;
  date: Date | null;
  type: "News" | "Exhibition" | "Journal";
  excerpt: string;
};

// 2. データ取得
const [news, exhibitions, artists, journal] = await Promise.all([
  getCollection("news"),
  getCollection("exhibitions"),
  getCollection("artists"),
  getCollection("journal"),
]);

// Artist lookup map
const artistMap = new Map(artists.map((a) => [a.id, a.data]));

// ヘルパー: テキスト丸め
const truncate = (text: string, limit: number) => {
  const cleanText = text.replace(/\n/g, "");
  return cleanText.length > limit
    ? cleanText.slice(0, limit) + "..."
    : cleanText;
};

// 3. Newsの整形
const newsItems: NewsItem[] = news.map((item) => ({
  id: item.id,
  // 外部リンク(link)があれば優先、なければ詳細ページ、それもなければnull
  href:
    item.data.link ||
    (item.data.has_page !== false ? `/news/${item.id}` : null),
  title: item.data.title,
  date: item.data.date ? new Date(item.data.date) : null,
  type: "News",
  excerpt: item.data.excerpt || truncate(item.body || "", 80),
}));

// 4. Exhibitionの整形
const exhibitionItems: NewsItem[] = exhibitions.map((item) => {
  const artistIds = Array.isArray(item.data.artist)
    ? item.data.artist
    : [item.data.artist];

  const artistNames = artistIds
    .map((id) => {
      const data = artistMap.get(id);
      return data ? data.nameJa || data.name : null;
    })
    .filter((name): name is string => !!name);

  // タイトル決定ロジック
  let displayTitle = item.data.news_title || item.data.title;
  if (!displayTitle && artistNames.length > 0) {
    displayTitle =
      artistNames.join(", ") + (artistIds.length > 1 ? " 合同展" : " 個展");
  }

  return {
    id: item.id,
    href: `/exhibitions/${item.id}`,
    title: displayTitle || "Exhibition",
    date: item.data.date ? new Date(item.data.date) : null,
    type: "Exhibition",
    excerpt: truncate(item.body || "", 80),
  };
});

const journalItems: NewsItem[] = journal.map((item) => ({
  id: item.id,
  href:
    item.data.link ||
    (item.data.has_page !== false ? `/journal/${item.id}` : null),
  title: item.data.title,
  date: item.data.date ? new Date(item.data.date) : null,
  type: "Journal",
  excerpt: item.data.excerpt || truncate(item.body || "", 80),
}));
// 5. 統合 + ソート
const sortedItems: NewsItem[] = [
  ...newsItems,
  ...journalItems,
  ...exhibitionItems,
].sort((a, b) => (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0));

// 日付フォーマット
const formatDate = (date: Date) =>
  date.toLocaleDateString("ja-JP", {
    year: "numeric",
    month: "numeric",
    day: "numeric",
  });
---

<Layout title="News" breadcrumb={[{ label: "News", href: "/news" }]}>
  <section>
    <h1>News</h1>

    <ul>
      {
        sortedItems.map((item) => {
          const targetHref = item.href;
          // 案3: シンプルな外部リンク判定
          const isExternal =
            targetHref?.startsWith("http") || targetHref?.startsWith("//");

          return (
            <li>
              <h2>
                {targetHref ? (
                  <a
                    href={targetHref}
                    target={isExternal ? "_blank" : undefined}
                    rel={isExternal ? "noopener noreferrer" : undefined}
                  >
                    {item.title}
                  </a>
                ) : (
                  item.title
                )}
              </h2>

              <p>{item.excerpt}</p>

              <div>
                <span>{item.type}</span>
                {item.date && (
                  <time datetime={item.date.toISOString()}>
                    | {formatDate(item.date)}
                  </time>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>

    {sortedItems.length === 0 && <p>現在、お知らせはありません。</p>}
  </section>
</Layout>
