---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

/* =========================
   データ取得
========================= */
const exhibitions = await getCollection("exhibitions");
const artists = await getCollection("artists");

/* =========================
   exhibition整形
========================= */
const exhibitionItems = exhibitions.map((item) => {

  const artistIds = Array.isArray(item.data.artist)
    ? item.data.artist
    : [item.data.artist];

  const artistNames = artistIds
    .map((id) => {
      const artist = artists.find((a) => a.id === id);

      return artist
        ? artist.data.nameJa || artist.data.name
        : id;
    })
    .filter(Boolean)
    .join(", ");

  const displayTitle =
    item.data.title && item.data.title !== ""
      ? item.data.title
      : artistNames
        ? (artistIds.length > 1
            ? `${artistNames} 合同展`
            : `${artistNames} 個展`)
        : "Exhibition";

  const artistNamesFallback = Array.isArray(item.data.artist_name)
    ? item.data.artist_name
    : item.data.artist_name
      ? [item.data.artist_name]
      : [displayTitle];

  return {
    id: item.id,
    href: `/exhibitions/${item.id}`, // ← 明示的に追加
    title: displayTitle,
    artistNames: artistNamesFallback.join(", "),
    date: item.data.published_at || item.data.date || "",
    type: "exhibition", // ← 仮固定
  };
});

/* =========================
   sort（新しい順）
========================= */
const newsItems = exhibitionItems.sort((a, b) => {
  return new Date(b.date).getTime() - new Date(a.date).getTime();
});
---

<Layout
  title="News"
  breadcrumb={[
    { label: "News", href: "/news" }
  ]}
>
  <section>
    <h1>News</h1>

    <ul>
      {newsItems.map((item) => (
        <li>
          <a href={item.href}>
            <strong>{item.title}</strong>
          </a>

          <div>
            {item.artistNames}
          </div>

          <div>
            {item.date}
          </div>
        </li>
      ))}
    </ul>

  </section>
</Layout>