---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

// 1. 型定義
type NewsItem = {
  id: string;
  href: string | null;
  title: string;
  date: Date | null;
  type: "News" | "Exhibition" | "Journal";
  excerpt: string;
};

// 2. データ取得
const [news, journal] = await Promise.all([
  getCollection("news"),
  getCollection("journal"),
]);

// ヘルパー: テキスト丸め
const truncate = (text: string, limit: number) => {
  const cleanText = text.replace(/\n/g, " ");

  return cleanText.length > limit
    ? cleanText.slice(0, limit) + "..."
    : cleanText;
};

// 3. Newsの整形
const newsItems: NewsItem[] = news.map((item) => ({
  id: item.id,
  href:
    item.data.link ||
    (item.data.has_page !== false ? `/news/${item.id}` : null),
  title: item.data.title,
  date: item.data.date ? new Date(item.data.date) : null,
  type: "News",
  excerpt: item.data.excerpt || truncate(item.body || "", 80),
}));

// 4. Journalの整形
const journalItems: NewsItem[] = journal.map((item) => ({
  id: item.id,
  href:
    item.data.link ||
    (item.data.has_page !== false ? `/journal/${item.id}` : null),
  title: item.data.title,
  date: item.data.date ? new Date(item.data.date) : null,
  type: "Journal",
  excerpt: item.data.excerpt || truncate(item.body || "", 80),
}));

// 5. 統合 + ソート
const sortedItems: NewsItem[] = [
  ...newsItems,
  ...journalItems,
].sort((a, b) => (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0));

// 6. 年でグループ化
const groupedByYear: Record<string, NewsItem[]> =
  sortedItems.reduce<Record<string, NewsItem[]>>((acc, item) => {
    const year = item.date
      ? String(item.date.getFullYear())
      : "Unknown";

    acc[year] ??= [];
    acc[year].push(item);

    return acc;
  }, {});

// 7. 年配列（降順 + Unknown最後）
const years: string[] = Object.keys(groupedByYear).sort((a, b) => {
  if (a === "Unknown") return 1;
  if (b === "Unknown") return -1;

  return Number(b) - Number(a);
});

// 7. 日付フォーマット
const formatDate = (date: Date) => {
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");

  return `${month}.${day}`;
};

// 8. リンク
const categoryLinks = {
  Exhibition: "/exhibitions",
  Journal: "/journal",
};
---

<Layout
  title="News"
>
  <section class="news-index section">
    <h1 class="index-h1">News</h1>

    {
      years.map((year) => (
        <section class="news-year" data-year={year}>
          <div class="news-year-row">
            {/* 左（sticky） */}
            <div class="news-year-left">
              <h2 class="news-year-heading">{year}</h2>
            </div>

            {/* 右（list） */}
            <div class="news-year-right">
              <ul class="news-list">
                {
                  groupedByYear[year].map((item) => (
                    <li class="news-item">
                      <article class="news-card">
                        {/* 上段メタ */}
                        <div class="news-meta">
                          {item.date && (
                            <span class="news-date">
                              {formatDate(item.date)}
                            </span>
                          )}

                          <span class="news-separator"> | </span>

                          <span class="news-category">
                            {item.type === "News" ? (
                              item.type
                            ) : (
                              <a href={categoryLinks[item.type]}>
                                {item.type}
                              </a>
                            )}
                          </span>
                        </div>

                        {/* タイトル */}
                        <h3 class="news-card-title">
                          {item.href ? (
                            <a href={item.href}>
                              {item.title}
                            </a>
                          ) : (
                            item.title
                          )}
                        </h3>

                        {/* 本文 */}
                        <p class="news-excerpt">
                          {item.excerpt}
                        </p>
                      </article>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </section>
      ))
    }
  </section>
</Layout>