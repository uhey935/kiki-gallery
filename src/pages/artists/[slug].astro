---
import ArtistDetailPresentation from "../../components/ArtistDetailPresentation.astro";
import { getArtistsProductionFacade } from "../../content-boundaries/artists-production";
import type { ArtistProductionEntry } from "../../content-boundaries/artists-production";
import { getExhibitionsProductionFacade } from "../../content-boundaries/exhibitions-production";
import { getWorksProductionFacade } from "../../content-boundaries/works-production";
import Layout from "../../layouts/Layout.astro";
import { formatDateRangeJa } from "../../utils/date";
import {
  getExhibitionDisplayTitle,
  resolveExhibitionArtists,
} from "../../utils/exhibitionDisplay";

export async function getStaticPaths() {
  return (await getArtistsProductionFacade()).forLocale("ja").map((artist) => ({
    params: { slug: artist.id },
    props: { artist },
  }));
}

const { artist } = Astro.props as { artist: ArtistProductionEntry };
const artistName = artist.data.display_name || artist.data.name;
const description = artist.data.short_bio
  ? `${artistName}の作品・経歴を紹介｜KiKi Gallery`
  : artistName;

const worksFacade = await getWorksProductionFacade();
const workById = new Map(
  worksFacade.forLocale("ja").map((work) => [work.contentId, work]),
);
const displayedWorkIds = new Set<string>();
const workSections = (artist.data.works_layout ?? []).map((section) => ({
  layout: section.layout,
  works: section.works.map((reference) => {
    const work = workById.get(reference.id);
    if (!work)
      throw new Error(
        `Artist "${artist.id}" references missing work "${reference.id}".`,
      );
    if (work.data.artist !== artist.id)
      throw new Error(
        `Artist "${artist.id}" references work "${reference.id}" owned by "${work.data.artist}".`,
      );
    if (displayedWorkIds.has(reference.id))
      throw new Error(
        `Artist "${artist.id}" references work "${reference.id}" more than once.`,
      );
    displayedWorkIds.add(reference.id);
    return {
      contentId: work.contentId,
      href: worksFacade.detailRoute(work.contentId, "ja")!,
      image: {
        src: work.data.images[0].src,
        alt: work.data.images[0].alt ?? work.data.title,
      },
      title: work.data.title,
      year: work.data.year,
      size: work.data.size,
      material: work.data.material,
    };
  }),
}));

const exhibitionsFacade = await getExhibitionsProductionFacade();
const allArtists = (await getArtistsProductionFacade()).forLocale("ja");
const artistMap = new Map(allArtists.map((item) => [item.id, item]));
const exhibitions = exhibitionsFacade
  .forArtist(artist.id, "ja")
  .map((exhibition) => ({
    contentId: exhibition.contentId,
    href: exhibitionsFacade.detailRoute(exhibition.id, "ja")!,
    image: { src: exhibition.data.hero.image, alt: exhibition.data.hero_alt },
    title: getExhibitionDisplayTitle(
      exhibition,
      resolveExhibitionArtists(exhibition, artistMap),
    ),
    date: formatDateRangeJa(
      exhibition.data.start_date.toISOString().slice(0, 10),
      exhibition.data.end_date.toISOString().slice(0, 10),
    ),
    venue: exhibition.data.venue,
  }));

const siteUrl = Astro.site
  ? new URL(`/artists/${artist.id}`, Astro.site).href
  : null;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: artistName,
  description: artist.data.short_bio,
  ...(siteUrl && { url: siteUrl }),
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Artists",
      item: `${Astro.site}/artists`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: artistName,
      item: `${Astro.site}/artists/${artist.id}`,
    },
  ],
};
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(breadcrumbJsonLd)}
/>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<Layout title={artistName} description={description} locale="ja">
  <ArtistDetailPresentation
    locale="ja"
    artist={{
      contentId: artist.contentId,
      name: artistName,
      mediumLabel: artist.data.medium_label,
      shortBio: artist.data.short_bio,
      biography: artist.data.biography,
      hero: { src: artist.data.hero.image, alt: artist.data.hero_alt },
    }}
    {workSections}
    {exhibitions}
  />
</Layout>
