---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { formatDateRangeJa } from "../../utils/date";

/* =========================
   getStaticPaths
========================= */
export async function getStaticPaths() {
  const artists = await getCollection("artists");

  return artists.map((artist) => ({
    params: { slug: artist.id },
    props: { artist },
  }));
}

/* =========================
   Props
========================= */
const { artist } = Astro.props as {
  artist: CollectionEntry<"artists">;
};

const artistName = artist.data.nameJa || artist.data.name;

/* =========================
   description
========================= */
const description = artist.data.bio_short
  ? `${artistName}の作品・経歴を紹介｜KiKi Gallery`
  : artistName;

/* =========================
   Date安全処理
========================= */
const parseDate = (value: string | undefined) => {
  return value ? new Date(value) : null;
};

/* =========================
   works
========================= */
const allWorks = await getCollection("works");

const works = allWorks.filter((work) => {
  return work.data.artist === artist.id;
});

/* ▼ layout別に分ける */
const works_1_3 = works
  .filter((w) => w.data.layout === "1-3")
  .sort((a, b) => (a.data.position ?? 0) - (b.data.position ?? 0));

const works_1_left = works.filter((w) => w.data.layout === "1-left");

const works_3_2 = works
  .filter((w) => w.data.layout === "3-2")
  .sort((a, b) => (a.data.position ?? 0) - (b.data.position ?? 0));

const works_1_right = works.filter((w) => w.data.layout === "1-right");

/* =========================
   exhibitions
========================= */
const rawExhibitions = await getCollection("exhibitions", ({ data }) =>
  Array.isArray(data.artist)
    ? data.artist.includes(artist.id)
    : data.artist === artist.id
);

/* ▼ 日付ソート */
rawExhibitions.sort((a, b) => {
  const dateA = parseDate(a.data.date);
  const dateB = parseDate(b.data.date);

  const timeA = dateA ? dateA.getTime() : 0;
  const timeB = dateB ? dateB.getTime() : 0;

  return timeB - timeA;
});

/* ▼ ステータス判定 */
const now = new Date();
now.setHours(0, 0, 0, 0);

const exhibitions = rawExhibitions.map((exh) => {
  const start = parseDate(exh.data.date);
  const end = parseDate(exh.data.end_date) || start;

  if (!start || !end) {
    return { ...exh, status: "past" };
  }

  const compareEnd = new Date(end);
  compareEnd.setHours(23, 59, 59, 999);

  let status = "past";
  if (start > now) status = "upcoming";
  else if (compareEnd >= now) status = "ongoing";

  return { ...exh, status };
});

/* =========================
   URL
========================= */
const siteUrl = Astro.site
  ? new URL(`/artists/${artist.id}`, Astro.site).href
  : null;

/* =========================
   JSON-LD
========================= */
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: artistName,
  description: artist.data.bio_short,
  ...(siteUrl && { url: siteUrl }),
};
---

<!-- ▼ Breadcrumb -->
<script type="application/ld+json">
  {JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Artists",
        item: `${Astro.site}/artists`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: artistName,
        item: `${Astro.site}/artists/${artist.id}`,
      },
    ],
  })}
</script>

<!-- ▼ Person -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<Layout
  title={artistName}
  description={description}
  breadcrumb={[
    { label: "Artists", href: "/artists" },
    { label: artistName, href: `/artists/${artist.id}` },
  ]}
>
  <article>
    <section class="section artists-intro">
      <div class="artists-intro__left">
        <h1 class="artists-h1-title">{artistName}</h1>

        {artist.data.medium && (
          <p class="artists-intro__medium">
            {Array.isArray(artist.data.medium)
              ? artist.data.medium.join(", ")
              : artist.data.medium}
          </p>
        )}
      </div>

      <div class="artists-intro__right">
        <p class="artists-bio-short">{artist.data.bio_short}</p>

        <a href="#full-biography" class="artists-biography-link">
          Read full biography
        </a>
      </div>
    </section>

    {/* =========================
       Works
    ========================= */}
    <section class="section artists-works">
      <h2 class="detail-h2-title">Works</h2>

      {works.length > 0 ? (
        <>
          {/* =========================
             1-3
          ========================= */}
          <div class="artists-works-card artists-works-card--1-3">
            {works_1_3.map((work) => (
              <figure class="artists-works-card__item">
                <a
                  href={`/works/${work.id}`}
                  class="artists-works-link"
                >
                  <img
                    class="artists-works-image"
                    src={work.data.image}
                    alt={work.data.alt || work.data.title}
                  />

                  <figcaption class="artists-works-caption">
                    <p class="artists-works-title">
                      {work.data.year
                        ? `${work.data.title.trim()}, ${work.data.year}`
                        : work.data.title.trim()}
                    </p>

                    {(work.data.size || work.data.material) && (
                      <p class="artists-works-meta">
                        {[work.data.size, work.data.material]
                          .filter(Boolean)
                          .join(", ")}
                      </p>
                    )}
                  </figcaption>
                </a>
              </figure>
            ))}
          </div>

          {/* =========================
             1-left
          ========================= */}
          {works_1_left.length > 0 && (
            <div class="artists-works-card artists-works-card--1-left">
              {works_1_left.map((work) => (
                <figure class="artists-works-card__item">
                  <a
                    href={`/works/${work.id}`}
                    class="artists-works-link"
                  >
                    <img
                      class="artists-works-image"
                      src={work.data.image}
                      alt={work.data.alt || work.data.title}
                    />

                    <figcaption class="artists-works-caption">
                      <p class="artists-works-title">
                        {work.data.year
                          ? `${work.data.title.trim()}, ${work.data.year}`
                          : work.data.title.trim()}
                      </p>

                      {(work.data.size || work.data.material) && (
                        <p class="artists-works-meta">
                          {[work.data.size, work.data.material]
                            .filter(Boolean)
                            .join(", ")}
                        </p>
                      )}
                    </figcaption>
                  </a>
                </figure>
              ))}
            </div>
          )}

          {/* =========================
             3-2
          ========================= */}
          {works_3_2.length > 0 && (
            <div class="artists-works-card artists-works-card--3-2">
              {works_3_2.map((work) => (
                <figure class="artists-works-card__item">
                  <a
                    href={`/works/${work.id}`}
                    class="artists-works-link"
                  >
                    <img
                      class="artists-works-image"
                      src={work.data.image}
                      alt={work.data.alt || work.data.title}
                    />

                    <figcaption class="artists-works-caption">
                      <p class="artists-works-title">
                        {work.data.year
                          ? `${work.data.title.trim()}, ${work.data.year}`
                          : work.data.title.trim()}
                      </p>

                      {(work.data.size || work.data.material) && (
                        <p class="artists-works-meta">
                          {[work.data.size, work.data.material]
                            .filter(Boolean)
                            .join(", ")}
                        </p>
                      )}
                    </figcaption>
                  </a>
                </figure>
              ))}
            </div>
          )}

          {/* =========================
             1-right
          ========================= */}
          {works_1_right.length > 0 && (
            <div class="artists-works-card artists-works-card--1-right">
              {works_1_right.map((work) => (
                <figure class="artists-works-card__item">
                  <a
                    href={`/works/${work.id}`}
                    class="artists-works-link"
                  >
                    <img
                      class="artists-works-image"
                      src={work.data.image}
                      alt={work.data.alt || work.data.title}
                    />

                    <figcaption class="artists-works-caption">
                      <p class="artists-works-title">
                        {work.data.year
                          ? `${work.data.title.trim()}, ${work.data.year}`
                          : work.data.title.trim()}
                      </p>

                      {(work.data.size || work.data.material) && (
                        <p class="artists-works-meta">
                          {[work.data.size, work.data.material]
                            .filter(Boolean)
                            .join(", ")}
                        </p>
                      )}
                    </figcaption>
                  </a>
                </figure>
              ))}
            </div>
          )}
        </>
      ) : (
        <p class="artists-exhibitions-empty">No works available.</p>
      )}
    </section>

    {/* =========================
       Shop
    ========================= */}
    {artist.data.shop_url && (
      <p class="shop-link">
        <a
          href={artist.data.shop_url}
          target="_blank"
          rel="noopener noreferrer"
        >
          Explore available works
        </a>
      </p>
    )}

    {/* =========================
       Biography
    ========================= */}
    <section class="section artists-bio" id="full-biography">
      <h2 class="detail-h2-title">Biography</h2>

      <div class="artists-bio-layout">
        {artist.data.image && (
          <div class="artists-bio-image">
            <img src={artist.data.image} alt={artistName} width="400" />
          </div>
        )}

        <p class="artists-bio-text">{artist.data.bio}</p>
      </div>
    </section>

    {/* =========================
       Exhibitions
    ========================= */}
    <section class="section artists-exhibitions">
      <h2 class="detail-h2-title">Exhibitions</h2>

      <div class="artists-exhibitions-list">
        {rawExhibitions.length > 0 ? (
          rawExhibitions.map((exh) => (
            <article class="artists-exhibitions-card">
              <a href={`/exhibitions/${exh.id}`}>
                {/* 画像 */}
                {exh.data.image && (
                  <div class="artists-exhibitions-card-image">
                    <img src={exh.data.image} alt={exh.data.title || ""} />
                  </div>
                )}

                {/* テキスト */}
                <div class="artists-exhibitions-card-meta">
                  <h3 class="artists-exhibitions-card-title">
                    {exh.data.title || artistName}
                  </h3>

                  <p class="artists-exhibitions-card-date">
                    {formatDateRangeJa(
                      exh.data.date ?? "",
                      exh.data.end_date ?? ""
                    )}
                  </p>

                  {exh.data.venue?.name && (
                    <p class="artists-exhibitions-card-venue">
                      {exh.data.venue.name}
                    </p>
                  )}
                </div>
              </a>
            </article>
          ))
        ) : (
          <p class="artists-exhibitions-empty">No exhibitions available.</p>
        )}
      </div>
    </section>

    <nav class="detail-navigation" aria-label="Artist navigation">
      <a href="/artists" class="detail-navigation-link">
        View All Artists
      </a>
    </nav>
  </article>
</Layout>

<script>
  const bioImage = document.querySelector(".artists-bio-image");

  if (bioImage) {
    const observer = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];

        if (entry.isIntersecting) {
          bioImage.classList.add("is-visible");
          observer.unobserve(bioImage);
        }
      },
      {
        threshold: 0.4,
      }
    );

    observer.observe(bioImage);
  }
</script>