---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getArtistsProductionFacade } from "../../content-boundaries/artists-production";

const artists = (await getArtistsProductionFacade()).forLocale("ja");

/* =========================
   英語（姓）ベースでソート
========================= */
const sortedArtists = artists
  .filter((artist) => artist.data.name) // nameがないデータを除外して安全性を確保
  .sort((a, b) => {
    const getLastName = (name: string = "") => {
      const parts = name.trim().split(/\s+/);
      return parts.length > 0 ? parts[parts.length - 1] : "";
    };

    const lastA = getLastName(a.data.name || "");
    const lastB = getLastName(b.data.name || "");

    return lastA.localeCompare(lastB, "en", { sensitivity: "base" });
  });
---

<Layout title="Artists">
  <section class="section artists">
    <h1 class="index-h1">Artists</h1>

    <div class="artists-grid">
      {
        sortedArtists.map((artist) => (
          <article class="artists-card">
            <a href={`/artists/${artist.id}`} class="artists-link">
              {artist.data.hero.image && (
                <div class="artists-image">
                  <Image
                    src={artist.data.hero.image}
                    alt={artist.data.hero_alt}
                    width={600}
                    height={600}
                  />
                </div>
              )}

              <div class="artists-meta">
                <h2 class="artists-name">
                  {artist.data.display_name ?? artist.data.name}
                </h2>

                <p class="artists-medium">{artist.data.medium.join(" / ")}</p>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
