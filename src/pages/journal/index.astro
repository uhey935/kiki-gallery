---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

/* =========================
   データ取得
========================= */
const journal = await getCollection("journal");

/* =========================
   ヘルパー
========================= */
const stripHtml = (text: string) => text.replace(/<[^>]*>?/gm, "");

const truncate = (text: string, limit: number) => {
  const clean = stripHtml(text).replace(/\n/g, "").trim();
  return clean.length > limit ? clean.slice(0, limit) + "..." : clean;
};

const parseDate = (value?: string) => {
  if (!value) return null;
  const d = new Date(value);
  return isNaN(d.getTime()) ? null : d;
};

/* =========================
   整形
========================= */
const items = journal
  .map((item) => ({
    id: item.id,
    href:
      item.data.link ||
      (item.data.has_page !== false ? `/journal/${item.id}` : null),
    title: item.data.title,
    date: parseDate(item.data.date),
    excerpt: item.data.excerpt || truncate(item.body || "", 80),
    type: item.data.categories?.[0] ?? null,
    hero_image: item.data.hero_image,
  }))
  .sort((a, b) => (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0));

const hero = items[0];
const topItems = items.slice(1, 5);
const restItems = items.slice(5);

/* =========================
   日付フォーマット
========================= */
const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    weekday: "long",
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<Layout title="Journal" breadcrumb={[{ label: "Journal", href: "/journal" }]}>
  <section class="journal">
    <h1 class="page-title">Journal</h1>

    {/* =========================
        上段（hero + 4card）
    ========================= */}
    <div class="journal-grid">
      {/* HERO */}
      {hero && hero.href && (
        <article class="journal-card journal-card--hero">
          <a href={hero.href}>
            {hero.hero_image && (
              <div class="journal-image">
                <img src={hero.hero_image} alt="" />
              </div>
            )}

            <div class="journal-meta">
              {hero.type && <p>{hero.type}</p>}
              <h2 class="journal-title">{hero.title}</h2>
              {hero.date && (
                <time datetime={hero.date.toISOString()}>
                  {formatDate(hero.date)}
                </time>
              )}
            </div>
          </a>
        </article>
      )}

      {/* 4カード */}
      {topItems.map((item) =>
        item.href ? (
          <article class="journal-card">
            <a href={item.href}>
              {item.hero_image && (
                <div class="journal-image">
                  <img src={item.hero_image} alt="" />
                </div>
              )}

              <div class="journal-meta">
                {item.type && <p>{item.type}</p>}
                <h2 class="journal-card-title">{item.title}</h2>
                {item.date && (
                  <time datetime={item.date.toISOString()}>
                    {formatDate(item.date)}
                  </time>
                )}
              </div>
            </a>
          </article>
        ) : null
      )}
    </div>

    {/* =========================
        下段（通常grid）
    ========================= */}
    <div class="journal-grid--list">
      {restItems.map((item) =>
        item.href ? (
          <article class="journal-card">
            <a href={item.href}>
              {item.hero_image && (
                <div class="journal-image">
                  <img src={item.hero_image} alt="" />
                </div>
              )}

              <div class="journal-meta">
                {item.type && <p>{item.type}</p>}
                <h2 class="journal-card-title">{item.title}</h2>
                {item.date && (
                  <time datetime={item.date.toISOString()}>
                    {formatDate(item.date)}
                  </time>
                )}
              </div>
            </a>
          </article>
        ) : null
      )}
    </div>
  </section>
</Layout>