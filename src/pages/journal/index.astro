---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

/* =========================
   1. データ取得
========================= */
const journal = await getCollection("journal");

// 日付の表示用フォーマット（Template側で使用）
const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    weekday: "long",
    year: "numeric",
    month: "short",
    day: "numeric",
  });

/* =========================
   3. データ整形（Mapping）
========================= */
const items = journal
  .map((item) => {
    // 日付オブジェクトの生成（不正な日付はnull）
    const date = item.data.date ? new Date(item.data.date) : null;

    return {
      id: item.id,
      href: `/journal/${item.id}`,
      title: item.data.title,
      date, // 派生データ（ISO文字列等）は持たせずDateオブジェクトのみ
      summary: item.data.summary,
      categories: item.data.categories ?? [], // 配列として保持
      hero: item.data.hero,
      hero_alt: item.data.hero_alt,
    };
  })
  // 新しい順にソート
  .sort((a, b) => (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0));

// 表示エリアごとに分割
const hero = items[0];
const topItems = items.slice(1, 5);
const restItems = items.slice(5);
---

<Layout title="Journal">
  <section class="section journal">
    <h1 class="index-h1">Journal</h1>

    {
      /* ========================= 上段：Hero + Grid ========================= */
    }
    <div class="journal-grid">
      {/* HERO */}
      {
        hero && (
          <article class="card journal-card journal-card--hero">
            <a href={hero.href} class="card-link">
              <div class="card-image journal-image">
                <img src={hero.hero.image} alt={hero.hero_alt} />
              </div>
              <div class="card-meta journal-meta">
                {/* カテゴリ判定（配列の1番目がある場合のみ） */}
                {hero.categories[0] && (
                  <p class="journal-category">{hero.categories[0]}</p>
                )}

                <h2 class="journal-title">{hero.title}</h2>

                {/* 日付表示（Template側でメソッドを呼び出し） */}
                {hero.date && (
                  <time class="journal-date" datetime={hero.date.toISOString()}>
                    {formatDate(hero.date)}
                  </time>
                )}
              </div>
            </a>
          </article>
        )
      }

      {/* 4カード（Grid部分） */}
      {
        topItems.map((item, index) => (
          <article class={`card journal-card journal-card--item-${index + 1}`}>
            <a href={item.href} class="card-link">
              <div class="card-image journal-image">
                <img src={item.hero.image} alt={item.hero_alt} />
              </div>
              <div class="card-meta journal-meta">
                {item.categories[0] && (
                  <p class="journal-category">{item.categories[0]}</p>
                )}
                <h2 class="journal-card-title">{item.title}</h2>
                {item.date && (
                  <time class="journal-date" datetime={item.date.toISOString()}>
                    {formatDate(item.date)}
                  </time>
                )}
              </div>
            </a>
          </article>
        ))
      }
    </div>

    {/* ========================= 下段：通常リスト ========================= */}
    {
      restItems.length > 0 && (
        <div class="journal-grid--list">
          {restItems.map((item) => (
            <article class="card journal-card">
              <a href={item.href} class="card-link">
                <div class="card-image journal-image">
                  <img src={item.hero.image} alt={item.hero_alt} />
                </div>
                <div class="card-meta journal-meta">
                  {item.categories[0] && (
                    <p class="journal-category">{item.categories[0]}</p>
                  )}
                  <h2 class="journal-card-title">{item.title}</h2>
                  {item.date && (
                    <time
                      class="journal-date"
                      datetime={item.date.toISOString()}
                    >
                      {formatDate(item.date)}
                    </time>
                  )}
                </div>
              </a>
            </article>
          ))}
        </div>
      )
    }
  </section>
</Layout>
