---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

/* =========================
   getStaticPaths
========================= */
export async function getStaticPaths() {
  const journal = await getCollection("journal");

  return journal
    .filter((item) => item.data.has_page !== false)
    .map((item) => ({
      params: { slug: item.id },
      props: { item },
    }));
}

/* =========================
   props
========================= */
const { item } = Astro.props;

/* =========================
   Markdown → HTML
========================= */
const { Content } = await render(item);

/* =========================
   type（categoriesの先頭）
========================= */
const type = item.data.categories[0];
---

<Layout
  title={item.data.title}
  breadcrumb={[
    { label: "Journal", href: "/journal" },
    { label: type, href: `/journal/${item.id}` },
  ]}
>
  <article>

    {/* interview → Heroが上 */}
    {type === "interview" && item.data.hero_image && (
      <figure>
        <img src={item.data.hero_image} alt="" />
        {item.data.hero_caption && (
          <figcaption>{item.data.hero_caption}</figcaption>
        )}
      </figure>
    )}

    <h1>{item.data.title}</h1>

    {item.data.date && (
      <time datetime={item.data.date}>
        Published{" "}
        {new Date(item.data.date).toLocaleDateString("en-US", {
          weekday: "long",
          year: "numeric",
          month: "short",
          day: "numeric",
        })}
      </time>
    )}

    {/* essay → H1の下にHero */}
    {type === "essay" && item.data.hero_image && (
      <figure>
        <img src={item.data.hero_image} alt="" />
        {item.data.hero_caption && (
          <figcaption>{item.data.hero_caption}</figcaption>
        )}
      </figure>
    )}

    {/* 本文（共通） */}
    <div>
      <Content />
    </div>

    {/* interviewだけRelated */}
    {type === "interview" && (
      <h2>Related Articles</h2>
    )}

  </article>
</Layout>