---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

/* =========================
   getStaticPaths
========================= */
export async function getStaticPaths() {
  const journal = await getCollection("journal");

  return journal
    .filter((item) => item.data.has_page !== false)
    .map((item) => ({
      params: { slug: item.id },
      props: { item },
    }));
}

/* =========================
   props
========================= */
const { item } = Astro.props;

/* =========================
   Markdown → HTML
========================= */
const { Content } = await render(item);

/* =========================
   type（categoriesの先頭）
========================= */
const type = item.data.categories && item.data.categories[0];
---

<Layout
  title={item.data.title}
  breadcrumb={[
    {
      label: "Journal",
      href: "/journal",
    },
    {
      label: item.data.categories?.[0] || item.data.title,
      href: `/journal/${item.id}`,
    },
  ]}
>
  <article class="article">
    {/* Hero（全タイプ共通） */}
    {
      item.data.hero_image && (
        <figure class="article-hero">
          <img src={item.data.hero_image} alt="" />
          {item.data.hero_caption && (
            <figcaption>{item.data.hero_caption}</figcaption>
          )}
        </figure>
      )
    }

    {/* Title */}
    <h1 class="article-title">{item.data.title}</h1>

    {/* Date */}
    {
      item.data.date && (
        <time class="article-date" datetime={item.data.date}>
          Published{" "}
          {new Date(item.data.date).toLocaleDateString("en-US", {
            weekday: "long",
            year: "numeric",
            month: "short",
            day: "numeric",
          })}
        </time>
      )
    }

    {/* 本文（共通） */}
    <div class="article-body">
      <Content />
    </div>

    {/* interviewだけRelated */}
    {
      type === "interview" && (
        <h2 class="article-related-title">Related Articles</h2>
      )
    }
  </article>
</Layout>
