---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

/* =========================
   getStaticPaths
========================= */
export async function getStaticPaths() {
  const journal = await getCollection("journal");

  return journal
    .filter((item) => item.data.has_page !== false)
    .map((item) => ({
      params: { slug: item.id },
      props: { item },
    }));
}

/* =========================
   props
========================= */
const { item } = Astro.props;

/* =========================
   Markdown → HTML
========================= */
const { Content } = await render(item);

/* =========================
   日付フォーマット
========================= */
const formatDate = (date: Date) =>
  date.toLocaleDateString("ja-JP", {
    year: "numeric",
    month: "numeric",
    day: "numeric",
  });

const date = item.data.date ? new Date(item.data.date) : null;
---

<Layout
  title={item.data.title}
  breadcrumb={[
    { label: "Journal", href: "/journal" },
    { label: item.data.title, href: `/journal/${item.id}` },
  ]}
>
  <article>
    <h1>{item.data.title}</h1>

    {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}

    <div>
      <Content />
    </div>
  </article>
</Layout>
