---
import { render } from "astro:content";
import ExhibitionDetailPresentation from "../../components/ExhibitionDetailPresentation.astro";
import { createExhibitionDetailPresentationModel } from "../../components/exhibition-detail-projection.ts";
import { getExhibitionsProductionFacade } from "../../content-boundaries/exhibitions-production";
import Layout from "../../layouts/Layout.astro";
import { getExhibitionStatus } from "../../utils/exhibitionStatus";

export async function getStaticPaths() {
  const facade = await getExhibitionsProductionFacade();
  return facade.forLocale("ja").map((exhibition) => ({
    params: { slug: exhibition.id },
    props: { exhibition },
  }));
}

const { exhibition } = Astro.props;
const facade = await getExhibitionsProductionFacade();
const shared = {
  artists: exhibition.data.artists.map(({ id }) => id),
  works: exhibition.data.works?.map(({ id }) => id),
  start_date: exhibition.data.start_date.toISOString().slice(0, 10),
  end_date: exhibition.data.end_date.toISOString().slice(0, 10),
  display_artists: exhibition.data.display_artists,
  opening_hours: exhibition.data.opening_hours,
  closed_weekdays: exhibition.data.closed_weekdays,
  hero: {
    image: exhibition.data.hero.image,
    orientation: exhibition.data.hero.orientation,
    position: exhibition.data.hero.position,
    treatment: exhibition.data.hero.treatment,
  },
};
const localized = {
  title: exhibition.data.title,
  summary: exhibition.data.summary,
  venue: exhibition.data.venue,
  attendance: exhibition.data.attendance,
  hero_alt: exhibition.data.hero_alt,
  hero_caption: exhibition.data.hero.hero_caption,
  seo_title: exhibition.data.seo_title,
  description: exhibition.data.description,
};
const model = await createExhibitionDetailPresentationModel({
  contentId: exhibition.contentId,
  locale: "ja",
  shared,
  localized,
});
const { Content } = await render(exhibition.source);
const description =
  exhibition.data.description ??
  (model.artists.length
    ? `${model.artists.map(({ name }) => name).join("、")}の展覧会｜${model.date}`
    : model.title);
const status = getExhibitionStatus(
  exhibition.data.start_date,
  exhibition.data.end_date,
);
---

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Event",
    name: model.title,
    description,
    startDate: shared.start_date,
    endDate: shared.end_date,
    eventStatus:
      status === "upcoming"
        ? "https://schema.org/EventScheduled"
        : status === "ongoing"
          ? "https://schema.org/EventInProgress"
          : "https://schema.org/EventCompleted",
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
    url: Astro.site
      ? new URL(facade.detailRoute(exhibition.id, "ja")!, Astro.site).toString()
      : undefined,
    location: { "@type": "Place", name: "KiKi Gallery" },
  })}
/>

<Layout title={exhibition.data.seo_title ?? model.title} {description}>
  <ExhibitionDetailPresentation {model}>
    <Content />
  </ExhibitionDetailPresentation>
</Layout>
