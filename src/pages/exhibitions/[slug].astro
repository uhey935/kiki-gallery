---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { formatDateRangeJa } from "../../utils/date";

export async function getStaticPaths() {
  const exhibitions = await getCollection("exhibitions");
  const allArtists = await getCollection("artists");

  return exhibitions.map((exh) => ({
    params: { slug: exh.id },
    props: { exh, allArtists },
  }));
}

const { exh, allArtists = [] } = Astro.props;

// ▼ artistIds（安全対応）
const artistIds = Array.isArray(exh.data.artist)
  ? exh.data.artist
  : exh.data.artist
    ? [exh.data.artist]
    : [];

// ▼ artists（undefined除去）
const artists = artistIds
  .map((id) => allArtists.find((a) => a.id === id))
  .filter((a): a is NonNullable<typeof a> => a !== undefined);

// ▼ artistNames（表示用）
const artistNames =
  artists.length > 0
    ? artists
        .slice()
        .sort((a, b) => a.id.localeCompare(b.id))
        .map((a) => a.data.nameJa || a.data.name || a.id)
        .join(", ")
    : "";

// ▼ title（安全生成）
const displayTitle =
  exh.data.title && exh.data.title !== ""
    ? exh.data.title
    : artistNames
      ? artists.length > 1
        ? `${artistNames} 合同展`
        : artistNames
      : "Exhibition";

const description =
  artistNames && exh.data.date
    ? `${artistNames}の展覧会｜${formatDateRangeJa(exh.data.date, exh.data.end_date)}`
    : displayTitle;

// ▼ Markdown
const { Content } = await render(exh);
---

<Layout
  title={displayTitle}
  description={description}
  breadcrumb={[
    { label: "Exhibitions", href: "/exhibitions" },
    { label: displayTitle, href: "" },
  ]}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ExhibitionEvent",
      name: displayTitle,
      startDate: exh.data.date,
      endDate: exh.data.end_date ?? exh.data.date,
      eventStatus: "https://schema.org/EventScheduled",
      eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
      location: {
        "@type": "Place",
        name: "KiKi Gallery",
      },
      performer: artists.map((artist) => ({
        "@type": "Person",
        name: artist.data.nameJa || artist.data.name || artist.id,
        url: new URL(`/artists/${artist.id}`, Astro.site).toString(),
      })),
    })}
  />
  <h1>{displayTitle}</h1>

  <p>
    {artistNames}
  </p>

  <p>
    {formatDateRangeJa(exh.data.date, exh.data.end_date)}
  </p>

  <div>
    <Content />
  </div>
</Layout>
