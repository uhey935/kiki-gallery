---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatDateRangeJa } from "../../utils/date";

// getStaticPaths
export async function getStaticPaths() {
  const exhibitions = await getCollection("exhibitions");
  const allArtists = await getCollection("artists");

  return exhibitions.map((exh) => {
    const artistIds = Array.isArray(exh.data.artist)
      ? exh.data.artist
      : [exh.data.artist];

    const artists = allArtists.filter((a) =>
      artistIds.includes(a.id)
    );

    return {
      params: { slug: exh.id },
      props: { exh, artists },
    };
  });
}

// props
const { exh, artists } = Astro.props;

// Markdown → HTML
const { Content } = await render(exh);

// artist名（日本語優先）
const artistNames = artists
  .map((a) => a.data.nameJa || a.data.name)
  .join(", ");

// displayTitle（重要ロジック）
const displayTitle =
  exh.data.title && exh.data.title !== ""
    ? exh.data.title
    : artistNames
      ? (artists.length > 1
          ? `${artistNames} 合同展`
          : `${artistNames} 個展`)
      : "Exhibition";

// 日付（安全処理）
const safeDate = exh.data.date!;

// 表示用日付
const dateString = formatDateRangeJa(
  safeDate,
  exh.data.end_date || safeDate
);

// description
const description = artistNames
  ? `${artistNames}の展覧会｜${dateString}`
  : displayTitle;

// ▼ status（最終日含める）
const today = new Date();
today.setHours(0, 0, 0, 0);

const start = new Date(safeDate);

const end = exh.data.end_date
  ? new Date(exh.data.end_date + "T23:59:59")
  : start;

let status: "upcoming" | "ongoing" | "past";

if (start > today) {
  status = "upcoming";
} else if (end >= today) {
  status = "ongoing";
} else {
  status = "past";
}
---

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Event",
    name: displayTitle,
    description,
    startDate: safeDate,
    endDate: exh.data.end_date || safeDate,
    eventStatus:
      status === "upcoming"
        ? "https://schema.org/EventScheduled"
        : status === "ongoing"
          ? "https://schema.org/EventInProgress"
          : "https://schema.org/EventCompleted",
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
    url: Astro.site
      ? new URL(`/exhibitions/${exh.id}`, Astro.site).toString()
      : undefined,
    location: {
      "@type": "Place",
      name: "KiKi Gallery",
    },
  })}
/>

<Layout
  title={displayTitle}
  description={description}
  breadcrumb={[
    { label: "Exhibitions", href: "/exhibitions" },
    { label: displayTitle, href: `/exhibitions/${exh.id}` },
  ]}
>
  <h1>{displayTitle}</h1>

  <p>{dateString}</p>

  {artistNames && <p>{artistNames}</p>}

  <Content />
</Layout>