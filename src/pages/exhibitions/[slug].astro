---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatDateRangeJa } from "../../utils/date";
import {
  getArtistDisplayName,
  getExhibitionDisplayTitle,
  resolveExhibitionArtists,
} from "../../utils/exhibitionDisplay";
import { getExhibitionStatus } from "../../utils/exhibitionStatus";

// getStaticPaths
export async function getStaticPaths() {
  const exhibitions = await getCollection("exhibitions");
  const allArtists = await getCollection("artists");
  const artistMap = new Map(allArtists.map((artist) => [artist.id, artist]));

  return exhibitions.map((exh) => {
    const artists = resolveExhibitionArtists(exh, artistMap);

    return {
      params: { slug: exh.id },
      props: { exh, artists },
    };
  });
}

// props
const { exh, artists } = Astro.props;

const allWorks = await getCollection("works");
const exhibitionDate = exh.data.start_date;
const exhibitionEndDate = exh.data.end_date;
const toDateInputValue = (date: Date) => date.toISOString().slice(0, 10);
const exhibitionDateValue = toDateInputValue(exhibitionDate);
const exhibitionEndDateValue = toDateInputValue(exhibitionEndDate);

const getFamilyName = (name: string) => name.trim().split(/\s+/).pop() ?? "";

const exhibitionWorks = (exh.data.works ?? [])
  .map((workReference) => {
    const work = allWorks.find((item) => item.id === workReference.id);

    if (!work) {
      throw new Error(
        `Exhibition "${exh.id}" references missing Work "${workReference.id}".`,
      );
    }

    return work;
  })
  .sort((a, b) => {
    const artistA = artists.find((artist) => artist.id === a.data.artist.id);

    const artistB = artists.find((artist) => artist.id === b.data.artist.id);

    const familyA = getFamilyName(artistA?.data.name ?? "");

    const familyB = getFamilyName(artistB?.data.name ?? "");

    return familyA.localeCompare(familyB, "en", { sensitivity: "base" });
  });

const { Content } = await render(exh);

const artistNames = artists.map(getArtistDisplayName).join("、");
const displayTitle = getExhibitionDisplayTitle(exh, artists);
const dateString = formatDateRangeJa(
  exhibitionDateValue,
  exhibitionEndDateValue,
);

const description = artistNames
  ? `${artistNames}の展覧会｜${dateString}`
  : displayTitle;

const status = getExhibitionStatus(exhibitionDate, exhibitionEndDate);
---

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Event",
    name: displayTitle,
    description,
    startDate: exhibitionDateValue,
    endDate: exhibitionEndDateValue,
    eventStatus:
      status === "upcoming"
        ? "https://schema.org/EventScheduled"
        : status === "ongoing"
          ? "https://schema.org/EventInProgress"
          : "https://schema.org/EventCompleted",
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
    url: Astro.site
      ? new URL(`/exhibitions/${exh.id}`, Astro.site).toString()
      : undefined,
    location: {
      "@type": "Place",
      name: "KiKi Gallery",
    },
  })}
/>

<Layout title={displayTitle} description={description}>
  <section class="section exhibitions-detail">
    <header class="exhibitions-heading">
      {
        exh.data.display_artists !== false && artistNames && (
          <p class="exhibitions-heading-artist">{artistNames}</p>
        )
      }

      <h1 class="exhibitions-h1-title">
        {displayTitle}
      </h1>

      {
        /*
<p class="exhibitions-heading-status">
  {status === "ongoing" && "Ongoing"}
  {status === "upcoming" && "Upcoming"}
  {status === "past" && "Past"}
</p>
*/
      }
    </header>
  </section>

  <figure
    class:list={[
      "exhibitions-detail-image",
      {
        "exhibitions-detail-image--portrait":
          exh.data.hero.orientation === "portrait",
      },
    ]}
  >
    <img src={exh.data.hero.image} alt={exh.data.hero_alt} />
    {
      exh.data.hero.hero_caption && (
        <figcaption>{exh.data.hero.hero_caption}</figcaption>
      )
    }
  </figure>

  <section class="section exhibitions-content">
    <div class="exhibitions-main">
      <section class="exhibitions-info">
        <h2 class="visually-hidden">開催概要</h2>

        <dl class="exhibitions-info-list">
          <dt>開催期間</dt>
          <dd class="exhibitions-date-main">
            {dateString}
          </dd>

          {
            exh.data.attendance && (
              <>
                <dt>作家在廊日</dt>
                <dd>{exh.data.attendance}</dd>
              </>
            )
          }

          {
            exh.data.opening_hours && (
              <>
                <dt>開催時間</dt>
                <dd>{exh.data.opening_hours.replace("-", " - ")}</dd>
              </>
            )
          }
        </dl>
      </section>

      <article class="exhibitions-article">
        <h2 class="visually-hidden">Exhibition Overview</h2>

        {exh.data.summary && <p>{exh.data.summary}</p>}

        <Content />

        <section class="exhibitions-venue">
          <h3 class="exhibitions-venue-title">会場</h3>

          {
            exh.data.venue && (
              <p class="exhibitions-venue-address">{exh.data.venue}</p>
            )
          }

          {
            exh.data.closed_days && (
              <p class="exhibitions-venue-closed">
                休廊日 / {exh.data.closed_days}
              </p>
            )
          }
        </section>
      </article>
    </div>

    {
      exhibitionWorks.length > 0 && (
        <section
          class={`exhibitions-works ${
            exhibitionWorks.length >= 6
              ? "exhibitions-works--3col"
              : "exhibitions-works--2col"
          }`}
        >
          <h2 class="detail-h2-title">Works</h2>

          <div class="exhibitions-works-list">
            {exhibitionWorks.map((work) => {
              const workArtist = artists.find(
                (artist) => artist.id === work.data.artist.id,
              );

              if (!workArtist) {
                throw new Error(
                  `Exhibition "${exh.id}" work "${work.id}" references Artist "${work.data.artist.id}" outside the Exhibition artist list.`,
                );
              }

              return (
                <figure class="exhibitions-work">
                  <img
                    src={work.data.images[0].src}
                    alt={work.data.images[0].alt ?? work.data.title}
                  />

                  <figcaption class="exhibitions-work-caption">
                    {artists.length > 1 && (
                      <p class="exhibitions-work-artist">
                        <a href={`/artists/${work.data.artist.id}`}>
                          {getArtistDisplayName(workArtist)}
                        </a>
                      </p>
                    )}

                    <p class="exhibitions-work-title">
                      {work.data.year
                        ? `${work.data.title}, ${work.data.year}`
                        : work.data.title}
                    </p>

                    {work.data.material && (
                      <p class="exhibitions-work-meta">{work.data.material}</p>
                    )}
                  </figcaption>
                </figure>
              );
            })}
          </div>
        </section>
      )
    }

    <section class="exhibitions-artists">
      <h2 class="detail-h2-title">
        {artists.length > 1 ? "Artists" : "Artist"}
      </h2>

      <ul class="exhibitions-artists-list">
        {
          artists.map((artist) => (
            <li class="exhibitions-artist-item">
              <a href={`/artists/${artist.id}`} class="action-link">
                {getArtistDisplayName(artist)}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <nav class="detail-navigation" aria-label="All exhibitions">
      <a href="/exhibitions" class="action-link"> View All Exhibitions </a>
    </nav>
  </section>

  <script>
    const heading = document.querySelector(
      ".exhibitions-heading",
    ) as HTMLElement | null;

    const updateParallax = () => {
      if (!heading) return;

      const scrollY = window.scrollY;
      const offset = scrollY * 0.19;

      heading.style.transform = `translateY(${offset}px)`;
    };

    window.addEventListener("scroll", updateParallax, {
      passive: true,
    });
  </script>
</Layout>
