---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { formatDateRangeJa } from "../../utils/date";

export async function getStaticPaths() {
  const exhibitions = await getCollection("exhibitions");
  const allArtists = await getCollection("artists");

  return exhibitions.map((exh) => {
    const rawIds = Array.isArray(exh.data.artist)
      ? exh.data.artist
      : [exh.data.artist].filter(Boolean);

    const relatedArtists = allArtists.filter((a) =>
      rawIds.includes(a.id)
    );

    return {
      params: { slug: exh.id },
      props: { exh, artists: relatedArtists },
    };
  });
}

const { exh, artists = [] } = Astro.props;

// ▼ artistNames
const artistNames = artists
  .slice()
  .sort((a, b) => a.id.localeCompare(b.id))
  .map((a) => a.data.nameJa || a.data.name || a.id)
  .join(", ");

// ▼ title
const displayTitle =
  exh.data.title ||
  (artistNames
    ? artists.length > 1
      ? `${artistNames} 合同展`
      : artistNames
    : "Exhibition");

// ▼ description
const dateString = formatDateRangeJa(
  exh.data.date,
  exh.data.end_date
);

const description = artistNames
  ? `${artistNames}の展覧会｜${dateString}`
  : displayTitle;

// ▼ status（最終日含める）
const today = new Date();
today.setHours(0, 0, 0, 0);

const start = new Date(exh.data.date);
const end = exh.data.end_date
  ? new Date(exh.data.end_date + "T23:59:59")
  : start;

let status = "past";
if (start > today) status = "upcoming";
else if (end >= today) status = "ongoing";

// ▼ URL
const siteUrl = Astro.site
  ? new URL(`/exhibitions/${exh.id}`, Astro.site).href
  : undefined;

// ▼ Markdown
const { Content } = await render(exh);
---

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Event",

    name: displayTitle,
    description: description,
    startDate: exh.data.date,
    endDate: exh.data.end_date ?? exh.data.date,

    eventStatus:
      status === "upcoming"
        ? "https://schema.org/EventScheduled"
        : status === "ongoing"
        ? "https://schema.org/EventInProgress"
        : "https://schema.org/EventCompleted",

    eventAttendanceMode:
      "https://schema.org/OfflineEventAttendanceMode",

    ...(siteUrl && { url: siteUrl }),

    location: {
      "@type": "Place",
      name: "KiKi Gallery",
      address: {
        "@type