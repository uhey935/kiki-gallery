---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content"; // renderをインポート
import { formatDateRangeJa } from "../../utils/date";

export async function getStaticPaths() {
  const exhibitions = await getCollection("exhibitions");
  const artists = await getCollection("artists");

  return exhibitions.map((exh) => {
    const artist = artists.find((a) => a.id === exh.data.artist);
    return {
      params: { slug: exh.id },
      props: { exh, artist },
    };
  });
}

const { exh, artist } = Astro.props;
if (!artist) throw new Error("Artist not found");

// MarkdownをHTMLコンポーネントに変換
const { Content } = await render(exh);

const artistName = artist.data.nameJa || artist.data.name;
const dateRange = formatDateRangeJa(exh.data.date, exh.data.end_date);

const now = new Date();
const status =
  new Date(exh.data.date) > now
    ? "upcoming"
    : new Date(exh.data.end_date || exh.data.date) >= now
      ? "ongoing"
      : "past";

const siteUrl = Astro.site
  ? new URL(`/exhibitions/${exh.id}`, Astro.site).href
  : null;

// JSON-LD 用のデータ準備
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: exh.data.title,
  startDate: exh.data.date,
  endDate: exh.data.end_date || exh.data.date,
  eventStatus:
    status === "upcoming"
      ? "https://schema.org/EventScheduled"
      : status === "ongoing"
        ? "https://schema.org/EventInProgress"
        : "https://schema.org/EventCompleted",
  ...(exh.data.venue && {
    location: {
      "@type": "Place",
      name: exh.data.venue.name,
      url: exh.data.venue.map,
    },
  }),
  performer: {
    "@type": "Person",
    name: artistName,
  },
  ...(siteUrl && { url: siteUrl }),
};
---

<Layout
  breadcrumb={[
    { label: "Exhibitions", href: "/exhibitions" },
    { label: exh.data.title, href: "#" },
  ]}
>
  {
    siteUrl && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )
  }

  <article>
    <!-- 追加ここ -->
    <figure>
      <img src={exh.data.image} alt={exh.data.title} loading="lazy" />
    </figure>
    <p>{artistName}</p>

    <h1>{exh.data.title}</h1>

    <p>
      開催日程：
      <time datetime={exh.data.date}>
        {formatDateRangeJa(exh.data.date, exh.data.date)}
      </time>
      {" - "}
      <time datetime={exh.data.end_date || exh.data.date}>
        {
          formatDateRangeJa(
            exh.data.end_date || exh.data.date,
            exh.data.end_date || exh.data.date,
          )
        }
      </time>
      {" "}
      {exh.data.open_time}
    </p>

    {exh.data.closed_days && <p>休廊日：{exh.data.closed_days}</p>}

    {
      exh.data.attendance && (
        <p>
          作家在廊予定日：{exh.data.attendance}
          <small>（※変更となる場合があります）</small>
        </p>
      )
    }

    {
      exh.data.venue && (
        <p>
          会場：
          <a
            href={exh.data.venue.map}
            target="_blank"
            rel="noopener noreferrer"
          >
            {exh.data.venue.name}
          </a>
        </p>
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>

  <section>
    <h2>Artist</h2>
    <p>
      <a href={`/artists/${artist.id}`}>
        {artistName}
      </a>
    </p>
  </section>
</Layout>
