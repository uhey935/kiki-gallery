---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { formatDateRangeJa, formatDateRangeEn } from "../../utils/date";

// データ取得
const exhibitions = await getCollection("exhibitions");
const artists = await getCollection("artists");

// ソート（新しい順）
const sorted = exhibitions.sort((a, b) => {
  const dateA = new Date(a.data.date || 0);
  const dateB = new Date(b.data.date || 0);
  return dateB.getTime() - dateA.getTime();
});

// 分割
const hero = sorted[0];
const secondRow = sorted.slice(1, 3);
const rest = sorted.slice(3);

// ===== hero artist（複数対応に修正）=====
const heroArtistNames = hero
  ? (() => {
      const ids = Array.isArray(hero.data.artist)
        ? hero.data.artist
        : [hero.data.artist];

      return ids
        .map((id) => {
          const a = artists.find((artist) => artist.id === id);
          return a?.data.nameJa || a?.data.name || "";
        })
        .filter(Boolean);
    })()
  : [];

// 日付パース
const parseDate = (value: string | undefined) => {
  return value ? new Date(value) : null;
};

// 今日
const today = new Date();

// ステータス判定
const getStatus = (start: Date | null, end: Date | null) => {
  if (!start) return "past";

  const compareEnd = end ? new Date(end) : new Date(start);
  compareEnd.setHours(23, 59, 59, 999);

  if (start > today) return "upcoming";
  if (compareEnd >= today) return "ongoing";
  return "past";
};

// hero status
const heroStatus = hero
  ? getStatus(parseDate(hero.data.date), parseDate(hero.data.end_date))
  : null;
---

<Layout
  title="Exhibitions"
  breadcrumb={[{ label: "Exhibitions", href: "/exhibitions" }]}
>
  <section class="exhibitions">
    <div class="exhibitions-inner">
      <h1 class="page-title">Exhibitions</h1>

      <!-- =========================
           1段目（hero）
      ========================= -->
      {
        hero && (
          <div class="hero">
            <div class="exhibition-card">
              <a href={`/exhibitions/${hero.id}`}>
                <div class="exhibition-image">
                  {hero.data.image && <img src={hero.data.image} alt="" />}
                </div>

                <div class="exhibition-content">
                  <p class="exhibition-status">{heroStatus}</p>

                  <p class="exhibition-artist">{heroArtistNames.join("・")}</p>

                  <h2 class="exhibition-title">
                    {hero.data.title && hero.data.title !== ""
                      ? hero.data.title
                      : heroArtistNames.length > 0
                        ? heroArtistNames.length > 1
                          ? `${heroArtistNames.join("・")} 合同展`
                          : `${heroArtistNames[0]} 個展`
                        : "Exhibition"}
                  </h2>

                  <p class="date">
                    {hero.data.date
                      ? formatDateRangeJa(hero.data.date, hero.data.end_date)
                      : ""}
                  </p>

                  {hero.data.venue?.name && (
                    <p class="exhibition-venue">{hero.data.venue.name}</p>
                  )}
                </div>
              </a>
            </div>
          </div>
        )
      }

      <!-- =========================
           grid（統一）
      ========================= -->
      <div class="exhibitions-grid">
        {
          sorted.slice(1).map((item, index) => {
            const artistNames = (() => {
              const ids = Array.isArray(item.data.artist)
                ? item.data.artist
                : [item.data.artist];

              return ids
                .map((id) => {
                  const a = artists.find((artist) => artist.id === id);
                  return a?.data.nameJa || a?.data.name || "";
                })
                .filter(Boolean);
            })();

            return (
              <div
                class={`card ${index === 0 ? "card--middle" : "card--small"}`}
              >
                <a href={`/exhibitions/${item.id}`}>
                  <div class="exhibition-image-simple">
                    {item.data.image && <img src={item.data.image} alt="" />}
                  </div>

                  <div class="exhibition-meta">
                    <div class="meta-left">
                      <p class="exhibition-artist">{artistNames.join("・")}</p>

                      <p class="exhibition-title">
                        {item.data.title && item.data.title !== ""
                          ? item.data.title
                          : artistNames.length > 0
                            ? artistNames.length > 1
                              ? `${artistNames.join("・")} 合同展`
                              : `${artistNames[0]} 個展`
                            : "Exhibition"}
                      </p>
                    </div>

                    <p class="exhibition-date">
                      {item.data.date
                        ? formatDateRangeEn(item.data.date, item.data.end_date)
                        : ""}
                    </p>
                  </div>
                </a>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>
</Layout>
