---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

// データ取得
const exhibitions = await getCollection("exhibitions");
const artists = await getCollection("artists");

// 日付パース（undefined対策）
const parseDate = (value: string | undefined) => {
  return value ? new Date(value) : null;
};

// 今日
const today = new Date();

// ステータス判定
const getStatus = (start: Date | null, end: Date | null) => {
  if (!start) return "past";

  const compareEnd = end ? new Date(end) : new Date(start);
  compareEnd.setHours(23, 59, 59, 999);

  if (start > today) return "upcoming";
  if (compareEnd >= today) return "ongoing";
  return "past";
};

// ソート（新しい順）
const sorted = exhibitions.sort((a, b) => {
  const dateA = parseDate(a.data.date);
  const dateB = parseDate(b.data.date);

  if (!dateA || !dateB) return 0;
  return dateB.getTime() - dateA.getTime();
});

// featured（先頭1件）
const featured = sorted[0];
---

<Layout
  breadcrumb={[
    { label: "Exhibitions", href: "/exhibitions" }
  ]}
>
  <h1>Exhibitions</h1>

  {/* ===== Featured ===== */}
  {
    featured &&
      (() => {
        const start = parseDate(featured.data.date);
        const end = parseDate(featured.data.end_date);
        const status = getStatus(start, end);

        // --- artist取得 ---
        const artistIds = Array.isArray(featured.data.artist)
          ? featured.data.artist
          : [featured.data.artist];

        const artistNames = artistIds
          .map((id) => {
            const artist = artists.find((a) => a.id === id);
            return artist?.data.nameJa || artist?.data.name;
          })
          .filter(Boolean)
          .join(", ");

        // --- タイトル生成 ---
        const displayTitle =
          featured.data.title && featured.data.title !== ""
            ? featured.data.title
            : artistNames
              ? (artistIds.length > 1
                  ? `${artistNames} 合同展`
                  : artistNames)
              : "Exhibition";

        return (
          <section class="exhibition-featured">
            <a href={`/exhibitions/${featured.id}`}>
              
              <div>
                {featured.data.image && (
                  <img src={featured.data.image} alt={displayTitle} />
                )}
              </div>

              <div>
                <p>{artistNames}</p>

                <h2>{displayTitle}</h2>

                {status !== "past" && (
                  <p>
                    {status === "ongoing" && "Ongoing"}
                    {status === "upcoming" && "Upcoming"}
                  </p>
                )}

                <p>
                  {featured.data.date}
                  {featured.data.end_date && ` - ${featured.data.end_date}`}
                </p>

                <p>{featured.data.venue?.name}</p>
              </div>
            </a>
          </section>
        );
      })()
  }

  {/* ===== List ===== */}
  <ul>
    {
      sorted.slice(1).map((exh) => {
        const start = parseDate(exh.data.date);
        const end = parseDate(exh.data.end_date);
        const status = getStatus(start, end);

        // --- artist取得 ---
        const artistIds = Array.isArray(exh.data.artist)
          ? exh.data.artist
          : [exh.data.artist];

        const artistNames = artistIds
          .map((id) => {
            const artist = artists.find((a) => a.id === id);
            return artist?.data.nameJa || artist?.data.name;
          })
          .filter(Boolean)
          .join(", ");

        // --- タイトル生成 ---
        const displayTitle =
          exh.data.title && exh.data.title !== ""
            ? exh.data.title
            : artistNames
              ? (artistIds.length > 1
                  ? `${artistNames} 合同展`
                  : artistNames)
              : "Exhibition";

        return (
          <li>
            <a href={`/exhibitions/${exh.id}`}>
              
              {exh.data.image && (
                <img src={exh.data.image} alt={displayTitle} />
              )}

              <p>{artistNames}</p>

              <h2>{displayTitle}</h2>

              <p>
                {exh.data.date}
                {exh.data.end_date && ` - ${exh.data.end_date}`}
              </p>

              {status !== "past" && (
                <p>
                  {status === "ongoing" && "Ongoing"}
                  {status === "upcoming" && "Upcoming"}
                </p>
              )}
            </a>
          </li>
        );
      })
    }
  </ul>
</Layout>