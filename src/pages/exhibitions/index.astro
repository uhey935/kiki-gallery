---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getWeekday } from "../../utils/date";
import {
  getArtistDisplayName,
  getExhibitionDisplayTitle,
  resolveExhibitionArtists,
} from "../../utils/exhibitionDisplay";
import { getExhibitionStatus } from "../../utils/exhibitionStatus";

// =====================
// 1. データ取得
// =====================
const exhibitions = await getCollection("exhibitions");
const artists = await getCollection("artists");

// 作家データを ID キーの Map に変換（計算量 O(N) に抑制）
const artistMap = new Map(artists.map((artist) => [artist.id, artist]));

const toDateInputValue = (date: Date) => date.toISOString().slice(0, 10);

// =====================
// 3. データ加工
// =====================
const formattedExhibitions = exhibitions.map((exh) => {
  const resolvedArtists = resolveExhibitionArtists(exh, artistMap);
  const artistNames = resolvedArtists.map(getArtistDisplayName);
  const startDate = exh.data.start_date;
  const endDate = exh.data.end_date;

  return {
    ...exh,
    artistNames,
    displayTitle: getExhibitionDisplayTitle(exh, resolvedArtists),
    status: getExhibitionStatus(startDate, endDate),
    startDate,
    endDate,
    startDateValue: toDateInputValue(startDate),
    endDateValue: toDateInputValue(endDate),
  };
});

// =====================
// 4. ソート
// =====================
const statusOrder: Record<string, number> = {
  ongoing: 0,
  upcoming: 1,
  past: 2,
};

formattedExhibitions.sort((a, b) => {
  const statusDiff = statusOrder[a.status] - statusOrder[b.status];

  if (statusDiff !== 0) return statusDiff;

  // ongoing → 開始日が新しい順
  if (a.status === "ongoing") {
    return b.startDate.getTime() - a.startDate.getTime();
  }

  // upcoming → 開始日が近い順
  if (a.status === "upcoming") {
    return a.startDate.getTime() - b.startDate.getTime();
  }

  // past → 終了日が新しい順
  return b.endDate.getTime() - a.endDate.getTime();
});
---

<Layout title="Exhibitions">
  <section class="section exhibitions">
    <h1 class="index-h1">Exhibitions</h1>

    {/* ===================== grid ===================== */}
    <div class="exhibitions-grid">
      {
        formattedExhibitions.map((exh, index) => (
          <div
            class={`exhibitions-card ${
              index === 0
                ? "exhibitions-card--middle"
                : "exhibitions-card--small"
            }`}
          >
            <a href={`/exhibitions/${exh.id}`} class="exhibitions-card__link">
              <div class="exhibitions-card__image">
                <img src={exh.data.hero.image} alt={exh.data.hero_alt} />

                <span
                  class={`exhibitions-status exhibitions-status--${exh.status}`}
                >
                  {exh.status}
                </span>
              </div>

              <div class="exhibitions-card__meta">
                <div class="exhibitions-card__content">
                  {exh.data.display_artists !== false && (
                    <p class="exhibitions-artist">
                      {exh.artistNames.join("・")}
                    </p>
                  )}

                  <p class="exhibitions-title">{exh.displayTitle}</p>
                </div>

                <p class="exhibitions-date exhibitions-card__date">
                  <>
                    <time
                      class="exhibitions-date__value"
                      datetime={exh.startDateValue}
                    >
                      {`${exh.startDate.getFullYear()}.${String(exh.startDate.getMonth() + 1).padStart(2, "0")}.${String(exh.startDate.getDate()).padStart(2, "0")}`}
                    </time>

                    <span class="exhibitions-date__weekday">
                      {getWeekday(exh.startDateValue)}
                    </span>

                    <span class="exhibitions-date__separator"> - </span>

                    <time
                      class="exhibitions-date__value"
                      datetime={exh.endDateValue}
                    >
                      {`${String(exh.endDate.getMonth() + 1).padStart(2, "0")}.${String(exh.endDate.getDate()).padStart(2, "0")}`}
                    </time>

                    <span class="exhibitions-date__weekday">
                      {getWeekday(exh.endDateValue)}
                    </span>
                  </>
                </p>
              </div>
            </a>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
