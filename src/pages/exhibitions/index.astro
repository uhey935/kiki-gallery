---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatDateRangeJa } from "../../utils/date";

const allExhibitions = await getCollection(
  "exhibitions",
  ({ id }) => id !== "test",
);

const artists = await getCollection("artists");

const now = new Date();
now.setHours(0, 0, 0, 0);

const statusOrder = { ongoing: 0, upcoming: 1, past: 2 };

const exhibitions = allExhibitions
  .map((exh) => {
    const start = new Date(exh.data.date);
    const end = exh.data.end_date ? new Date(exh.data.end_date) : start;

    const compareEnd = new Date(end);
    compareEnd.setHours(23, 59, 59, 999);

    let status: keyof typeof statusOrder = "past";
    if (start > now) {
      status = "upcoming";
    } else if (compareEnd >= now) {
      status = "ongoing";
    }

    // --- 👇 ここから追加（artist処理） ---

    const artistSlugs = Array.isArray(exh.data.artist)
      ? exh.data.artist
      : [exh.data.artist];

    const sortedSlugs = [...artistSlugs].sort();

    const artistNames = sortedSlugs.map((slug) => {
      const artist = artists.find((a) => a.id === slug);
      return artist?.data.nameJa || artist?.data.name || slug;
    });

    const displayTitle =
      exh.data.title && exh.data.title !== ""
        ? exh.data.title
        : `${artistNames.join(", ")} 合同展`;

    // --- 👆 ここまで追加 ---

    return {
      ...exh,
      status,
      artistNames,
      displayTitle,
    };
  })
  .sort((a, b) => {
    if (statusOrder[a.status] !== statusOrder[b.status]) {
      return statusOrder[a.status] - statusOrder[b.status];
    }
    return (
      new Date(b.data.date).getTime() -
      new Date(a.data.date).getTime()
    );
  });
---

<Layout
  title="Exhibitions | KiKi Gallery"
  breadcrumb={[{ label: "Exhibitions", href: "/exhibitions" }]}
>
  <main class="container">
    <h1>Exhibitions</h1>

    <div class="exhibition-list">
      {
        exhibitions.map((exh) => (
          <article class={`exhibition-item ${exh.status}`}>
            <a href={`/exhibitions/${exh.id}`}>
              
              {/* 画像 */}
              {exh.data.image && (
                <img
                  src={exh.data.image}
                  alt={exh.displayTitle}
                  class="exhibition-image"
                />
              )}

              {/* ステータス */}
              {exh.status !== "past" && (
                <span class={`status ${exh.status}`}>
                  {exh.status.toUpperCase()}
                </span>
              )}

              {/* artist */}
              <p class="artist">
                {exh.artistNames.join(", ")}
              </p>

              {/* title */}
              <h2>{exh.displayTitle}</h2>

              {/* 日付 */}
              <p class="date">
                {formatDateRangeJa(
                  exh.data.date,
                  exh.data.end_date
                )}
              </p>
            </a>
          </article>
        ))
      }
    </div>
  </main>
</Layout>