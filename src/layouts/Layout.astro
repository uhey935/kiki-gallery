---
import "../styles/base.css";
import "../styles/header.css";
import "../styles/home.css";
import "../styles/exhibitions.css";
import "../styles/journal.css";
import "../styles/artists.css";
import "../styles/news.css";
import "../styles/about.css";
import "../styles/privacy.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  flush?: boolean;
}

const {
  title,
  description,
  image,
  flush = false,
} = Astro.props;

// TODO: 本番ドメイン設定後、Astro.siteのみを使用する
const siteUrl = Astro.site?.origin ?? "https://your-domain.com";

// OGP画像
const ogImageUrl = new URL(image ?? "/default-og.jpg", siteUrl).toString();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title ? `${title} | KiKi Gallery` : "KiKi Gallery"}</title>
    <meta name="description" content={description ?? "KiKi Gallery"} />
    <link
      rel="canonical"
      href={new URL(Astro.url.pathname, siteUrl).toString()}
    />

    <meta property="og:title" content={title ?? "KiKi Gallery"} />
    <meta property="og:description" content={description ?? "KiKi Gallery"} />
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content={new URL(Astro.url.pathname, siteUrl).toString()}
    />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="KiKi Gallery" />

  </head>

  <body>
    <Header />

    <main class:list={["site-main", { "site-main--flush": flush }]}>
      <slot />
    </main>

    <Footer />

  </body>
</html>
