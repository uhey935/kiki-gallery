---
import "../styles/base.css";
import "../styles/exhibition.css";
import "../styles/journal.css";
import "../styles/artist.css";
import Header from "../components/Header.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import Footer from "../components/Footer.astro";

interface Props {
  breadcrumb?: { label: string; href: string }[];
  title?: string;
  description?: string;
  image?: string;
}

const { breadcrumb, title, description, image } = Astro.props;

const siteUrl = Astro.site?.origin ?? "https://your-domain.com";

// OGP画像
const ogImageUrl = new URL(image ?? "/default-og.jpg", siteUrl).toString();

// breadcrumb（Home付き）
const breadcrumbList = [
  { label: "Home", href: "/" },
  ...(breadcrumb ?? []),
];

// JSON-LD
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbList.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    item:
      item.href === "#"
        ? siteUrl
        : new URL(item.href, siteUrl).toString(),
  })),
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title ? `${title} | KiKi Gallery` : "KiKi Gallery"}</title>
    <meta name="description" content={description ?? "KiKi Gallery"} />
    <link rel="canonical" href={new URL(Astro.url.pathname, siteUrl).toString()} />

    <meta property="og:title" content={title ?? "KiKi Gallery"} />
    <meta property="og:description" content={description ?? "KiKi Gallery"} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, siteUrl).toString()} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="KiKi Gallery" />

    {breadcrumbList.length > 0 && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(breadcrumbJsonLd)}
      />
    )}
  </head>

  <body>
    <Header />

    {breadcrumbList.length > 1 && <Breadcrumb items={breadcrumbList} />}

    <main class="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>