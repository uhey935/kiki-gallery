---
import "../styles/base.css";

interface Props {
  title?: string;
  description?: string;
  locale: "ja" | "en";
}

const {
  title = "KiKi Gallery",
  description = "KiKi Gallery",
  locale,
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>
