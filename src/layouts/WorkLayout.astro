---
import "../styles/base.css";

const {
  title = "KiKi Gallery",
  description = "KiKi Gallery",
} = Astro.props;

---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>