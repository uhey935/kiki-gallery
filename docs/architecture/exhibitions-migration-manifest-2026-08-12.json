        "shared": {
          "path": "src/content/exhibitions/reiko-kinoshita-2023-12/index.yaml",
          "content": "artists:\n  - reiko-kinoshita\nworks:\n  - reiko-kinoshita-04\n  - reiko-kinoshita-02\nstart_date: 2023-12-09\nend_date: 2024-01-26\nhero:\n  image: /images/exhibitions/reiko-kinoshita-2023-12.png\n  orientation: portrait\n",
          "byteLength": 213,
          "sha256": "9d5a838376cb58886460f83f5b9228a5b8eed9a4d36434dd45b464e40b6da931"
